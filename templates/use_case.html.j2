<!DOCTYPE html>
<!-- stacked-radar v2 -->
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page.title }} | HVTracker</title>
  <meta name="description" content="{{ page.description }}">
  <link rel="canonical" href="https://hvtracker.net/use-cases/{% if page.slug %}{{ page.slug }}/{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page.title }} | HVTracker">
  <meta property="og:description" content="{{ page.description }}">
  <meta property="og:url" content="https://hvtracker.net/use-cases/{% if page.slug %}{{ page.slug }}/{% endif %}">
  <meta property="og:image" content="https://hvtracker.net/og-v2.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page.title }} | HVTracker">
  <meta name="twitter:description" content="{{ page.description }}">
  <meta name="twitter:image" content="https://hvtracker.net/og-v2.png">
  <link rel="stylesheet" href="/static/site.css?v={{ css_hash }}">
  <style>
    body{line-height:1.7}
    .page{max-width:1080px;padding:28px 24px 52px}
    .logo span{color:var(--lobster)}
    .hero{padding:28px 0 18px;border-bottom:1px solid var(--line)}
    h1{font-size:34px;line-height:1.12;letter-spacing:0;margin-bottom:10px}
    .hero p{color:var(--muted);max-width:760px}
    .metric-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:20px 0}
    .metric{padding:12px 0;border-top:2px solid var(--ink)}
    .metric strong{display:block;font:700 24px var(--font-mono);color:var(--ink)}
    .metric span{color:var(--muted);font-size:12px}
    .chart-band{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin:26px 0}
    .chart-panel{min-width:0;padding-top:14px;border-top:1px solid var(--line)}
    .chart-panel h2{font:700 13px var(--font-mono);letter-spacing:.05em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
    .insight-chart{width:100%;height:auto;display:block;overflow:visible}
    .slice-nav{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0 4px}
    .slice-nav a{font:11px var(--font-mono);color:var(--muted);padding:6px 10px;border:1px solid transparent}
    .slice-nav a:hover{color:var(--ink);border-color:var(--line);background:var(--paper-2);text-decoration:none}
    .slice-nav a.active{color:var(--ink);border-color:var(--line);background:var(--paper-2)}
    table{width:100%;border-collapse:collapse;margin-top:24px;font-size:14px;border-top:2px solid var(--ink)}
    th,td{padding:12px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
    th{font:11px var(--font-mono);color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
    td.num{text-align:right;font-family:var(--font-mono)}
    .agent{font-weight:700}
    .repo{display:block;color:var(--muted);font:11px var(--font-mono);margin-top:3px}
    .grade{display:inline-flex;min-width:24px;justify-content:center;padding:3px 8px;font:700 11px var(--font-mono);border:1px solid var(--line);color:var(--lobster)}
    footer{margin-top:36px;padding-top:18px;border-top:1px solid var(--line);font:11px var(--font-mono);color:var(--muted);text-align:center}
    footer a{color:var(--lobster)}
    @media(max-width:760px){.metric-row,.chart-band{grid-template-columns:1fr}h1{font-size:26px}nav{margin-left:0}table{font-size:13px}th:nth-child(4),td:nth-child(4){display:none}}
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "Use Cases", "item": "https://hvtracker.net/use-cases/" },
      { "@type": "ListItem", "position": 3, "name": "{{ page.title }}" }
    ]
  }
  </script>
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
</head>
<body data-page-type="{% if is_index %}use_cases_index{% else %}use_case{% endif %}">
  <header class="site-header">
    <div class="site-header-inner">
      <a href="/" class="logo">HV<span>Tracker</span></a>
      <nav class="site-nav" aria-label="Site">
        <a href="/">Leaderboard</a>
        <a href="/movers/">Movers</a>
        <a href="/changes/">Changes</a>
        <a href="/use-cases/">Use cases</a>
        <a href="/methodology">Methodology</a>
        <a href="/compare/">Compare</a>
        <a href="/alerts/">Alerts</a>
        <a href="/data/">Data API</a>
        <a href="/sponsor/">Sponsor</a>
      </nav>
    </div>
  </header>
  <div class="page">

    <section class="hero">
      <h1>{{ page.title }}</h1>
      <p>{{ page.description }} Updated from the same generated registry data as the leaderboard, so the list changes with every cron refresh.</p>
      <div class="slice-nav" aria-label="Use-case slices">
        <a href="/use-cases/" class="{% if is_index %}active{% endif %}">All slices</a>
        {% for p in pages %}
        <a href="/use-cases/{{ p.slug }}/" class="{% if p.slug == page.slug %}active{% endif %}">{{ p.title }}</a>
        {% endfor %}
      </div>
    </section>

    <section class="metric-row" aria-label="Slice summary">
      <div class="metric"><strong>{{ page.agents|length }}</strong><span>Agents in slice</span></div>
      <div class="metric"><strong>{{ page.avg_trust }}</strong><span>Average HVTrust</span></div>
      <div class="metric"><strong>{{ page.fresh_count }}</strong><span>Updated in last 14 days</span></div>
    </section>

    <section class="chart-band" aria-label="Slice charts">
      <div class="chart-panel">
        <h2>Trust Shape</h2>
        {{ page.radar_trust_svg | safe }}
      </div>
      <div class="chart-panel">
        <h2>Activity Signals</h2>
        {{ page.radar_activity_svg | safe }}
      </div>
    </section>

    <table>
      <thead>
        <tr><th>Agent</th><th>Category</th><th>Grade</th><th class="num">Rank</th><th class="num">HVTrust</th><th class="num">Fresh</th></tr>
      </thead>
      <tbody>
        {% for agent in page.agents %}
        <tr>
          <td><a class="agent" href="/agents/{{ agent.slug }}/">{{ agent.name }}</a><span class="repo">{{ agent.repo }}</span></td>
          <td>{{ agent.category }}</td>
          <td><span class="grade">{{ agent.evidence_grade }}</span></td>
          <td class="num">#{{ agent.rank }}</td>
          <td class="num">{{ agent.trust_score }}</td>
          <td class="num">{% if agent.days_ago == 0 %}today{% elif agent.days_ago == 1 %}1d{% else %}{{ agent.days_ago }}d{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <footer>
      <a href="/methodology">Methodology</a>
      <span class="footer-sep">&middot;</span>
      <a href="/spec/">Specifications</a>
      <span class="footer-sep">&middot;</span>
      <a href="/data/">Data API</a>
      <span class="footer-sep">&middot;</span>
      <a href="/compare/">Compare</a>
      <span class="footer-sep">&middot;</span>
      <a href="/badges/">Badges</a>
      <span class="footer-sep">&middot;</span>
      <a href="/changelog/">Changelog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/blog/">Blog</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker/issues/new?template=agent-listing.yml" target="_blank" rel="noopener">Submit Agent</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker" target="_blank" rel="noopener">GitHub</a>
    </footer>
  </div>
</body>
</html>
