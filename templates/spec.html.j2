<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ spec.title }} — HVTracker Specifications</title>
  <meta name="description" content="{{ spec.abstract[:160] }}">
  <link rel="canonical" href="https://hvtracker.net/spec/{{ spec.slug }}/{{ spec.version }}">
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ spec.title }}">
  <meta property="og:description" content="{{ spec.abstract[:160] }}">
  <meta property="og:url" content="https://hvtracker.net/spec/{{ spec.slug }}/{{ spec.version }}">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #0b0d10;
      --surface:   #151920;
      --surface-2: #1b2029;
      --border:    #303846;
      --text:      #eef2f6;
      --muted:     #8a87a8;
      --accent:    #8fb3ff;
      --accent-lt: rgba(143,179,255,0.10);
      --accent-dim:#5677aa;
      --mocha:     #d8a657;
      --fresh:     #2dd4bf;
      --aging:     #d8a657;
      --stale:     #737f91;
      --font-mono: "JetBrains Mono","Fira Mono","Cascadia Code",ui-monospace,"SFMono-Regular",Menlo,monospace;
      --font-sans: "Inter",system-ui,-apple-system,sans-serif;
      --font-serif: "Georgia","Times New Roman",serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.7;
      min-height: 100vh;
    }

    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── Layout ── */
    .page { max-width: 1100px; margin: 0 auto; padding: 0 20px; }

    /* ── Header ── */
    header {
      padding: 28px 0 20px;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: baseline; gap: 20px; flex-wrap: wrap;
      position: relative;
    }
    .logo { font-family: var(--font-mono); font-size: 20px; font-weight: 700; letter-spacing: -0.5px; color: var(--text); }
    .logo span { color: var(--accent); }
    .site-nav { margin-left: auto; font-family: var(--font-mono); font-size: 12px; display: flex; gap: 8px; align-items: baseline; }
    .site-nav a { color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 5px 10px; background: rgba(255,255,255,0.03); }
    .site-nav a:hover { color: var(--text); border-color: var(--accent); text-decoration: none; }
    .site-nav .active { color: var(--text); border-color: var(--accent); font-weight: 600; }

    /* ── Two-column layout ── */
    .spec-layout {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 0 48px;
      padding: 40px 0 60px;
      align-items: start;
    }
    @media (max-width: 760px) {
      .spec-layout { grid-template-columns: 1fr; }
      .toc { display: none; }
    }

    /* ── Table of contents ── */
    .toc {
      position: sticky;
      top: 24px;
      font-family: var(--font-mono);
      font-size: 11.5px;
      line-height: 1.6;
    }
    .toc-title {
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em;
      color: var(--muted); margin-bottom: 10px; font-weight: 600;
    }
    .toc a {
      display: block; color: var(--muted); padding: 3px 0;
      border-left: 2px solid var(--border); padding-left: 10px;
      transition: all 0.1s;
    }
    .toc a:hover { color: var(--accent); border-color: var(--accent-dim); text-decoration: none; }
    .toc a.active { color: var(--accent); border-color: var(--accent); }
    .toc-sub { padding-left: 22px !important; font-size: 11px; }

    /* ── Spec document ── */
    .spec-doc { min-width: 0; max-width: 720px; }

    /* Cover block */
    .spec-cover {
      padding-bottom: 28px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 32px;
    }
    .spec-cover h1 {
      font-family: var(--font-mono);
      font-size: 26px; font-weight: 700; letter-spacing: -0.5px;
      line-height: 1.25; margin-bottom: 12px;
    }
    .spec-meta {
      font-family: var(--font-mono); font-size: 11.5px;
      color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px 18px;
      margin-bottom: 14px;
    }
    .spec-meta span { white-space: nowrap; }

    /* Status badge */
    .status-badge {
      display: inline-block;
      font-family: var(--font-mono); font-size: 10px; font-weight: 700;
      padding: 2px 8px; border-radius: 3px;
      text-transform: uppercase; letter-spacing: 0.06em;
    }
    .status-published  { background: rgba(45,212,191,0.16); color: var(--fresh); }
    .status-draft      { background: rgba(216,166,87,0.16);  color: var(--aging); }
    .status-review     { background: var(--accent-lt);        color: var(--accent); }
    .status-superseded { background: rgba(107,114,128,0.15); color: var(--stale); }

    /* Permalink */
    .permalink {
      font-family: var(--font-mono); font-size: 11px; color: var(--muted);
      margin-top: 10px;
    }
    .permalink code { color: var(--accent); }

    /* ── Section headings ── */
    .spec-doc h2 {
      font-family: var(--font-mono); font-size: 13px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--accent); margin: 36px 0 14px;
      padding-bottom: 8px; border-bottom: 1px solid var(--border);
      scroll-margin-top: 24px;
    }
    .spec-doc h3 {
      font-family: var(--font-mono); font-size: 12.5px; font-weight: 600;
      color: var(--text); margin: 24px 0 10px;
      scroll-margin-top: 24px;
    }
    .spec-doc h4 {
      font-size: 13px; font-weight: 600; color: var(--mocha);
      margin: 18px 0 8px;
    }

    /* ── Body copy ── */
    .spec-doc p { margin-bottom: 14px; color: var(--text); font-size: 14.5px; }
    .spec-doc p:last-child { margin-bottom: 0; }

    /* ── Normative keywords ── */
    .must   { font-weight: 700; color: #e8798b; }  /* red  */
    .should { font-weight: 700; color: var(--aging); }
    .may    { font-weight: 700; color: var(--fresh); }

    /* ── Code ── */
    code {
      font-family: var(--font-mono); font-size: 12.5px;
      background: var(--surface-2); padding: 1px 5px; border-radius: 3px;
      color: var(--mocha);
    }
    pre {
      font-family: var(--font-mono); font-size: 12px;
      background: var(--surface-2); border: 1px solid var(--border);
      border-radius: 6px; padding: 16px 18px; overflow-x: auto;
      margin: 14px 0; line-height: 1.6; color: var(--text);
    }
    pre code { background: none; padding: 0; color: inherit; }

    /* ── Lists ── */
    .spec-doc ul, .spec-doc ol {
      padding-left: 1.4em; margin: 10px 0 14px;
    }
    .spec-doc li { margin-bottom: 6px; font-size: 14.5px; }
    .spec-doc li:last-child { margin-bottom: 0; }

    /* ── Definition list ── */
    .spec-doc dl { margin: 10px 0 14px; }
    .spec-doc dt {
      font-family: var(--font-mono); font-size: 12.5px; font-weight: 600;
      color: var(--text); margin-top: 12px;
    }
    .spec-doc dd { margin-left: 1.4em; font-size: 14px; color: var(--muted); }

    /* ── Callout ── */
    .note {
      font-size: 13.5px; color: var(--text);
      padding: 12px 16px; background: var(--accent-lt);
      border-left: 3px solid var(--accent); border-radius: 0 4px 4px 0;
      margin: 16px 0;
    }

    /* ── Data table ── */
    .spec-table {
      width: 100%; border-collapse: collapse;
      font-size: 13px; margin: 14px 0;
    }
    .spec-table th {
      font-family: var(--font-mono); font-size: 10.5px; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--muted); background: var(--surface);
      padding: 8px 12px; border-bottom: 1px solid var(--border);
      text-align: left;
    }
    .spec-table td {
      padding: 9px 12px; border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    .spec-table tr:last-child td { border-bottom: none; }
    .spec-table tr:nth-child(even) { background: rgba(255,255,255,0.018); }

    /* ── Section number ── */
    .sec-num { color: var(--muted); margin-right: 8px; font-family: var(--font-mono); }

    /* ── Footer ── */
    footer {
      padding: 28px 0 48px; border-top: 1px solid var(--border);
      font-size: 12px; color: var(--muted);
      display: flex; gap: 14px; flex-wrap: wrap; align-items: center;
    }
    footer a { color: var(--accent); }
    .footer-sep { color: var(--border); }
  </style>
  <!-- Google tag (gtag.js) -->
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Electron|Claude\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
</head>
<body>
  <div class="page">

    <header>
      <a href="/" class="logo">HV<span>Tracker</span></a>
      <nav class="site-nav" aria-label="Site">
        <a href="/">Leaderboard</a>
        <a href="/methodology">Methodology</a>
        <span class="active">Specifications</span>
      </nav>
    </header>

    <div class="spec-layout">

      <!-- Table of contents -->
      <nav class="toc" aria-label="Table of contents">
        <div class="toc-title">Contents</div>
        {% for section in spec.sections %}
        <a href="#{{ section.id }}" {% if loop.index == 1 %}class="active"{% endif %}>
          {{ section.num }} {{ section.title }}
        </a>
        {% if section.subsections is defined %}
        {% for sub in section.subsections %}
        <a href="#{{ sub.id }}" class="toc-sub">{{ sub.num }} {{ sub.title }}</a>
        {% endfor %}
        {% endif %}
        {% endfor %}
        {% if spec.appendices is defined %}
        {% for app in spec.appendices %}
        <a href="#{{ app.id }}">{{ app.num }} {{ app.title }}</a>
        {% endfor %}
        {% endif %}
      </nav>

      <!-- Specification document -->
      <article class="spec-doc">

        <div class="spec-cover">
          <h1>{{ spec.title }}</h1>
          <div class="spec-meta">
            <span>Version: <strong>{{ spec.version }}</strong></span>
            <span>Status: <span class="status-badge status-{{ spec.status|lower }}">{{ spec.status }}</span></span>
            <span>Published: {{ spec.date }}</span>
            <span>Authors: {{ spec.authors|join(", ") }}</span>
          </div>
          <div class="permalink">
            Permalink: <code>https://hvtracker.net/spec/{{ spec.slug }}/{{ spec.version }}</code>
          </div>
        </div>

        {{ spec.body | safe }}

      </article>
    </div>

    <footer>
      <a href="/spec/">← All Specifications</a>
      <span class="footer-sep">·</span>
      <a href="/">Leaderboard</a>
      <span class="footer-sep">·</span>
      <a href="/methodology">Methodology</a>
      <span class="footer-sep">·</span>
      <a href="https://github.com/YugantM/hvtracker" target="_blank" rel="noopener">GitHub</a>
    </footer>

  </div>

  <script>
    // Active ToC highlighting on scroll
    (function () {
      const headings = document.querySelectorAll('.spec-doc h2[id], .spec-doc h3[id]');
      const links = document.querySelectorAll('.toc a');
      if (!headings.length || !links.length) return;
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            links.forEach(l => l.classList.remove('active'));
            const active = document.querySelector('.toc a[href="#' + e.target.id + '"]');
            if (active) active.classList.add('active');
          }
        });
      }, { rootMargin: '0px 0px -60% 0px' });
      headings.forEach(h => obs.observe(h));
    })();
  </script>
</body>
</html>
