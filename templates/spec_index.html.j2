<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Specifications — HVTracker</title>
  <meta name="description" content="Formal specifications published by HVTracker for measuring AI agent health and supply chain trust.">
  <link rel="canonical" href="https://hvtracker.net/spec/">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --paper:#f4f1eb; --paper-2:#ece4d6; --ink:#1f1b17; --muted:#6f665d; --muted-2:#8a7f72;
      --line:#d5cbbc; --line-strong:#b9aa96; --blue-strong:#7f9cbd; --blue-soft:rgba(167,191,217,0.18);
      --lobster:#c67c6d; --moss:#6f876e; --stale:#8d887e;
      --font-mono:"JetBrains Mono","Fira Mono","Cascadia Code",ui-monospace,"SFMono-Regular",Menlo,monospace;
      --font-sans:"Inter",system-ui,-apple-system,sans-serif;
    }
    body { background:var(--paper); background-image:url("/hex-bg.svg");background-size:2000px 2000px; color:var(--ink); font-family:var(--font-sans); font-size:14px; line-height:1.65; min-height:100vh; }
    a { color:var(--ink); text-decoration:none; }
    a:hover { text-decoration:underline; }
    .page { max-width:1000px; margin:0 auto; padding:24px 20px 60px; background:var(--paper); min-height:100vh; }
    .site-header { position:sticky; top:0; z-index:100; background:var(--paper); border-bottom:1px solid var(--line-strong); }
    .site-header-inner { max-width:1200px; margin:0 auto; padding:14px 24px; display:flex; align-items:baseline; gap:20px; flex-wrap:wrap; }
    .logo { font-family:var(--font-mono); font-size:20px; font-weight:700; letter-spacing:0; color:var(--ink); }
    .logo span { color:var(--lobster); }
    .site-nav { margin-left:auto; font-family:var(--font-mono); font-size:11px; display:flex; gap:6px; align-items:baseline; flex-wrap:wrap; }
    .site-nav a { color:var(--muted); padding:5px 10px; border:1px solid transparent; }
    .site-nav a:hover { color:var(--ink); border-color:var(--line); background:var(--paper-2); text-decoration:none; }
    .content { padding:34px 0 0; }
    .page-head { margin-bottom:28px; }
    .page-head h1 { font-family:var(--font-mono); font-size:20px; font-weight:700; letter-spacing:-0.3px; margin-bottom:6px; }
    .page-head p { font-size:13px; color:var(--muted); max-width:640px; }
    .meta-bar {
      display:flex; align-items:center; gap:20px; flex-wrap:wrap;
      padding:8px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line);
      margin-bottom:0;
      font-family:var(--font-mono); font-size:11px; color:var(--muted-2);
    }
    .meta-bar strong { color:var(--muted); }
    .doc-table { width:100%; border-collapse:collapse; }
    .doc-table thead th {
      font-family:var(--font-mono); font-size:10px; font-weight:600; text-transform:uppercase;
      letter-spacing:0.08em; color:var(--muted-2);
      padding:10px 12px 8px; border-bottom:1px solid var(--line);
      text-align:left; white-space:nowrap;
    }
    .doc-table thead th:first-child { padding-left:0; }
    .doc-table tbody tr { border-bottom:1px solid var(--line); transition:background 0.1s; }
    .doc-table tbody tr:last-child { border-bottom:none; }
    .doc-table tbody tr:hover { background:rgba(0,0,0,0.03); }
    .doc-table td { padding:13px 12px; vertical-align:top; }
    .doc-table td:first-child { padding-left:0; }
    .col-id { width:190px; }
    .doc-id { font-family:var(--font-mono); font-size:12px; font-weight:600; color:var(--lobster); white-space:nowrap; }
    .doc-id a { color:inherit; }
    .doc-id a:hover { text-decoration:underline; }
    .doc-series { font-family:var(--font-mono); font-size:10px; color:var(--muted-2); margin-top:3px; }
    .doc-title { font-size:14px; font-weight:600; color:var(--ink); margin-bottom:4px; }
    .doc-title a { color:inherit; }
    .doc-title a:hover { color:var(--lobster); text-decoration:none; }
    .doc-abstract { font-size:12.5px; color:var(--muted); line-height:1.55; }
    .col-status { width:110px; }
    .status-badge {
      display:inline-block; font-family:var(--font-mono); font-size:10px; font-weight:700;
      padding:2px 7px; border-radius:999px; text-transform:uppercase; letter-spacing:0.06em;
      white-space:nowrap;
    }
    .status-published  { background:rgba(111,135,110,0.14); color:var(--moss); }
    .status-draft      { background:rgba(198,124,109,0.14); color:var(--lobster); }
    .status-review     { background:var(--blue-soft); color:var(--lobster); }
    .status-superseded { background:rgba(141,136,126,0.16); color:var(--stale); }
    .col-date { width:100px; }
    .doc-date { font-family:var(--font-mono); font-size:11px; color:var(--muted-2); white-space:nowrap; }
    footer {
      margin:48px 0 0; padding-top:20px; border-top:1px solid var(--line);
      font-size:12px; color:var(--muted);
      display:flex; gap:14px; flex-wrap:wrap; align-items:center;
    }
    footer a { color:var(--lobster); }
    .footer-sep { color:var(--line-strong); }
  </style>
  <!-- Google tag (gtag.js) -->
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
</head>
<body>
  <header class="site-header">
    <div class="site-header-inner">
      <a href="/" class="logo">HV<span>Tracker</span></a>
      <nav class="site-nav" aria-label="Site">
        <a href="/">Leaderboard</a>
        <a href="/movers/">Movers</a>
        <a href="/use-cases/">Use cases</a>
        <a href="/methodology">Methodology</a>
        <a href="/compare/">Compare</a>
        <a href="/alerts/">Alerts</a>
        <a href="/data/">Data API</a>
        <a href="/sponsor/">Sponsor</a>
      </nav>
    </div>
  </header>
  <div class="page">

    <div class="content">
      <div class="page-head">
        <h1>Specifications</h1>
        <p>Formal technical documents defining how HVTracker measures AI agent health and supply chain trust. Each specification is versioned, permanently linked, and written in normative RFC style.</p>
      </div>

      <div class="meta-bar">
        <span><strong>{{ specs | length }}</strong> document{% if specs | length != 1 %}s{% endif %}</span>
        <span>·</span>
        <span>Standards Track</span>
        <span>·</span>
        <span>hvtracker.net/spec/</span>
      </div>

      <table class="doc-table">
        <thead>
          <tr>
            <th class="col-id">Identifier</th>
            <th class="col-body">Title &amp; Abstract</th>
            <th class="col-status">Status</th>
            <th class="col-date">Published</th>
          </tr>
        </thead>
        <tbody>
          {% for spec in specs %}
          <tr>
            <td class="col-id">
              <div class="doc-id"><a href="/spec/{{ spec.slug }}/{{ spec.version }}">{{ spec.slug }}/{{ spec.version }}</a></div>
              <div class="doc-series">Standards Track</div>
            </td>
            <td class="col-body">
              <div class="doc-title"><a href="/spec/{{ spec.slug }}/{{ spec.version }}">{{ spec.title }}</a></div>
              <div class="doc-abstract">{{ spec.abstract[:200] }}{% if spec.abstract|length > 200 %}…{% endif %}</div>
            </td>
            <td class="col-status">
              <span class="status-badge status-{{ spec.status|lower }}">{{ spec.status }}</span>
            </td>
            <td class="col-date">
              <span class="doc-date">{{ spec.date }}</span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <footer>
      <a href="/methodology">Methodology</a>
      <span class="footer-sep">&middot;</span>
      <a href="/spec/">Specifications</a>
      <span class="footer-sep">&middot;</span>
      <a href="/data/">Data API</a>
      <span class="footer-sep">&middot;</span>
      <a href="/compare/">Compare</a>
      <span class="footer-sep">&middot;</span>
      <a href="/badges/">Badges</a>
      <span class="footer-sep">&middot;</span>
      <a href="/changelog/">Changelog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/blog/">Blog</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker/issues/new?template=agent-listing.yml" target="_blank" rel="noopener">Submit Agent</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker" target="_blank" rel="noopener">GitHub</a>
    </footer>

  </div>
</body>
</html>
