<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Best {{ category }} — Ranked by Trust Score | HVTracker</title>
  <meta name="description" content="Compare {{ agents|length }} {{ category|lower }} ranked by independent trust scores. Open-source-first, with limited public GitHub comparators where relevant. {{ top3_names }}. Updated daily with security, activity, and adoption signals.">
  <link rel="canonical" href="https://hvtracker.net/categories/{{ slug }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="Best {{ category }} — Ranked by Trust Score | HVTracker">
  <meta property="og:description" content="Compare {{ agents|length }} {{ category|lower }} ranked by trust score. Open-source-first, with limited public GitHub comparators where relevant.">
  <meta property="og:url" content="https://hvtracker.net/categories/{{ slug }}">
  <meta property="og:image" content="https://hvtracker.net/og-v2.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Best {{ category }} — Ranked by Trust Score | HVTracker">
  <meta name="twitter:description" content="Compare {{ agents|length }} {{ category|lower }} ranked by trust score. Open-source-first, with limited public GitHub comparators where relevant.">
  <meta name="twitter:image" content="https://hvtracker.net/og-v2.png">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Best {{ category }}",
    "description": "{{ agents|length }} {{ category|lower }} ranked by independent trust scores on HVTracker. Open-source-first, with limited public GitHub comparators where relevant.",
    "url": "https://hvtracker.net/categories/{{ slug }}",
    "isPartOf": {
      "@type": "WebSite",
      "name": "HVTracker",
      "url": "https://hvtracker.net/"
    },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ agents|length }},
      "itemListElement": [
        {% for a in agents[:10] %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ a.name }}",
          "url": "https://hvtracker.net/agents/{{ a.slug }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "{{ category }}" }
    ]
  }
  </script>

  <link rel="stylesheet" href="/static/site.css?v={{ css_hash }}">
  <style>
    .page { max-width:880px; }

    .hero { padding:24px 0; border-bottom:1px solid var(--border); }
    h1 { font-size:26px; font-weight:700; margin-bottom:4px; }
    .hero .subtitle { font-size:13px; color:var(--muted); }
    .hero .seo-intro { margin-top:12px; font-size:13px; color:var(--muted); line-height:1.7; max-width:640px; }
    .hero .seo-intro strong { color:var(--text); }

    .stats-bar { display:flex; gap:20px; padding:12px 0; border-bottom:1px solid var(--border); flex-wrap:wrap; font-family:var(--font-mono); }
    .stat { }
    .stat .num { font-size:18px; font-weight:700; }
    .stat .lbl { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:0.04em; }

    table { width:100%; border-collapse:collapse; margin-top:12px; border-top:2px solid var(--text); }
    th { text-align:left; font-family:var(--font-mono); font-size:10px; text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); padding:8px 6px; border-bottom:1px solid var(--border); }
    td { padding:8px 6px; border-bottom:1px solid rgba(0,0,0,0.06); font-size:13px; }
    tr:hover td { background:rgba(0,0,0,0.03); }

    .rank-cell { font-family:var(--font-mono); font-size:12px; color:var(--muted); width:32px; }
    .name-cell a { font-weight:600; }
    .name-cell a:hover { color:var(--accent); }
    .name-cell .desc { font-size:11px; color:var(--muted); margin-top:1px; display:block; max-width:360px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .grade { font-family:var(--font-mono); font-size:10px; font-weight:700; margin-left:4px; }
    .grade-A { color:var(--green); }
    .grade-B { color:var(--accent); }
    .grade-C { color:var(--amber); }
    .grade-D { color:var(--muted); }
    .state-chip { font-family:var(--font-mono); font-size:9px; font-weight:600; margin-left:4px; text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); }
    .state-listed { color:var(--green); }
    .state-warning { color:var(--red); }

    .score-cell { font-family:var(--font-mono); font-size:13px; font-weight:600; }
    .score-hi { color:var(--green); }
    .score-mid { color:var(--amber); }
    .score-lo { color:var(--muted); }

    .stars-cell { font-family:var(--font-mono); font-size:12px; color:var(--muted); }
    .lang-cell { font-size:11px; color:var(--muted); }

    .cat-nav { padding:16px 0; border-top:1px solid var(--border); }
    .cat-nav h2 { font-size:14px; font-weight:600; margin-bottom:8px; }
    .cat-pills { display:flex; gap:4px; flex-wrap:wrap; }
    .cat-pill { font-family:var(--font-mono); font-size:11px; padding:3px 8px; color:var(--muted); }
    .cat-pill:hover { color:var(--accent); text-decoration:none; }
    .cat-pill.active { color:var(--accent); font-weight:600; }

    footer { padding:20px 0; margin-top:16px; border-top:1px solid var(--border); font-size:11px; color:var(--muted); text-align:center; }
    footer a { color:var(--accent); }

    @media (max-width:600px) {
      h1 { font-size:18px; }
      .stats-bar { gap:12px; }
      td, th { padding:6px 4px; }
      .name-cell .desc { max-width:180px; }
    }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "{{ category }}", "item": "https://hvtracker.net/categories/{{ slug }}/" }
    ]
  }
  </script>
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){var host=window.location.hostname||"";if(/^(localhost|127(?:\.\d{1,3}){3}|0(?:\.\d{1,3}){3}|::1)$/i.test(host)){window["ga-disable-G-TZ8921LR0K"]=true;return}try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
</head>
<body data-page-type="category_page" data-category="{{ category }}">
  <header class="site-header">
    <div class="site-header-inner">
      <a href="/" class="logo">HV<span>Tracker</span></a>
      <nav class="site-nav" aria-label="Site">
        <a href="/">Leaderboard</a>
        <a href="/movers/">Movers</a>
        <a href="/changes/">Changes</a>
        <a href="/use-cases/">Use cases</a>
        <a href="/methodology">Methodology</a>
        <a href="/compare/">Compare</a>
        <a href="/alerts/">Alerts</a>
        <a href="/data/">Data API</a>
        <a href="/sponsor/">Sponsor</a>
      </nav>
    </div>
  </header>
  <div class="page">

    <section class="hero">
      <h1>{{ category }}</h1>
      <p class="subtitle">{{ agents|length }} agents tracked &middot; Open-source-first, with limited public GitHub comparators &middot; Ranked by trust score &middot; Updated {{ updated }}</p>

      <div class="seo-intro">
        <p>HVTracker independently evaluates <strong>{{ agents|length }} {{ category|lower }}</strong> using daily signals from GitHub, package registries, and security databases. The category is open-source-first, with a limited set of public GitHub-hosted proprietary or source-available comparators when they are important ecosystem reference points.
        Each agent is scored on activity, adoption, transparency, safety, and identity.
        {% if agents|length > 0 %}The top-ranked {{ category|lower|replace('agents','agent') }} is <strong>{{ agents[0].name }}</strong> with a trust score of {{ agents[0].trust_score }}/100 (Grade {{ agents[0].evidence_grade }}).{% endif %}
        {% if agents|length > 2 %}Other leading projects include {{ agents[1].name }} and {{ agents[2].name }}.{% endif %}
        </p>
      </div>
    </section>

    <div class="stats-bar">
      <div class="stat">
        <div class="num">{{ agents|length }}</div>
        <div class="lbl">Agents</div>
      </div>
      <div class="stat">
        <div class="num">{{ avg_trust }}</div>
        <div class="lbl">Avg Trust</div>
      </div>
      <div class="stat">
        <div class="num">{{ total_stars }}</div>
        <div class="lbl">Total Stars</div>
      </div>
      <div class="stat">
        <div class="num">{{ grade_a_count }}</div>
        <div class="lbl">Grade A</div>
      </div>
      {% if warning_count %}
      <div class="stat">
        <div class="num" style="color:var(--red)">{{ warning_count }}</div>
        <div class="lbl">Warnings</div>
      </div>
      {% endif %}
    </div>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Agent</th>
          <th>Trust</th>
          <th>Stars</th>
          <th>Language</th>
        </tr>
      </thead>
      <tbody>
        {% for a in agents %}
        <tr>
          <td class="rank-cell">{{ a.category_rank }}</td>
          <td class="name-cell">
            <a href="/agents/{{ a.slug }}">{{ a.name }}</a>
            <span class="grade grade-{{ a.evidence_grade }}">{{ a.evidence_grade }}</span>
            <span class="state-chip state-{{ a.display_listing_status }}">{{ a.display_status_label }}</span>
            {% if a.description %}<span class="desc">{{ a.description }}</span>{% endif %}
          </td>
          <td class="score-cell {% if a.trust_score >= 60 %}score-hi{% elif a.trust_score >= 35 %}score-mid{% else %}score-lo{% endif %}">{{ a.trust_score }}</td>
          <td class="stars-cell">{{ a.stars_fmt }}</td>
          <td class="lang-cell">{{ a.language or '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if comparisons %}
    <nav class="cat-nav">
      <h2>Popular {{ category }} comparisons</h2>
      <div class="cat-pills">
        {% for c in comparisons %}
        <a href="{{ c.url }}" class="cat-pill">{{ c.a }} vs {{ c.b }}</a>
        {% endfor %}
      </div>
    </nav>
    {% endif %}

    <nav class="cat-nav">
      <h2>All Categories</h2>
      <div class="cat-pills">
        {% for c in all_categories %}
        <a href="/categories/{{ c.slug }}" class="cat-pill {% if c.name == category %}active{% endif %}">{{ c.name }} ({{ c.count }})</a>
        {% endfor %}
      </div>
    </nav>

    <footer>
      <a href="/methodology">Methodology</a>
      <span class="footer-sep">&middot;</span>
      <a href="/spec/">Specifications</a>
      <span class="footer-sep">&middot;</span>
      <a href="/data/">Data API</a>
      <span class="footer-sep">&middot;</span>
      <a href="/compare/">Compare</a>
      <span class="footer-sep">&middot;</span>
      <a href="/badges/">Badges</a>
      <span class="footer-sep">&middot;</span>
      <a href="/changelog/">Changelog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/blog/">Blog</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker/issues/new?template=agent-listing.yml" target="_blank" rel="noopener">Submit Agent</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker" target="_blank" rel="noopener">GitHub</a>
    </footer>
  </div>
</body>
</html>
