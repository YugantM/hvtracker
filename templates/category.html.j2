<!DOCTYPE html>
<html lang="en" class="theme-auto">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% include "_head_icons.html.j2" %}
  <meta name="google-site-verification" content="s2YUWbGP7cJsI6HUCKRX9YCtbVJVyA1Q1_jsNWj1RHc">
  <title>Best AI {{ category }} — Ranked by Trust Score | HVTracker</title>
  <meta name="description" content="Compare {{ agents|length }} {{ category|lower }} ranked by trust score. Top picks: {{ top3_names }}. Updated daily.">
  <link rel="canonical" href="https://hvtracker.net/categories/{{ slug }}/">

  <meta property="og:type" content="website">
  <meta property="og:title" content="Best AI {{ category }} — Ranked by Trust Score | HVTracker">
  <meta property="og:description" content="Compare {{ agents|length }} {{ category|lower }} ranked by trust score. Open-source-first, with limited public GitHub comparators where relevant.">
  <meta property="og:url" content="https://hvtracker.net/categories/{{ slug }}/">
  <meta property="og:image" content="https://hvtracker.net/og-v2.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Best AI {{ category }} — Ranked by Trust Score | HVTracker">
  <meta name="twitter:description" content="Compare {{ agents|length }} {{ category|lower }} ranked by trust score. Open-source-first, with limited public GitHub comparators where relevant.">
  <meta name="twitter:image" content="https://hvtracker.net/og-v2.png">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Best AI {{ category }}",
    "description": "{{ agents|length }} {{ category|lower }} ranked by independent trust scores on HVTracker. Open-source-first, with limited public GitHub comparators where relevant.",
    "url": "https://hvtracker.net/categories/{{ slug }}/",
    "isPartOf": {
      "@type": "WebSite",
      "name": "HVTracker",
      "url": "https://hvtracker.net/"
    },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ agents|length }},
      "itemListElement": [
        {% for a in agents[:10] %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ a.name }}",
          "url": "https://hvtracker.net/agents/{{ a.slug }}/"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "{{ category }}" }
    ]
  }
  </script>

  <link rel="stylesheet" href="/static/site.css?v={{ css_hash }}">
  <style>
    .page { max-width:880px; }

    .hero { padding:24px 0; border-bottom:1px solid var(--border); }
    h1 { font-size:26px; font-weight:700; margin-bottom:4px; }
    .hero .subtitle { font-size:13px; color:var(--muted); }
    .seo-intro { margin-top:12px; font-size:13px; color:var(--muted); line-height:1.7; max-width:640px; }
    .seo-intro strong { color:var(--text); }

    .stats-bar { display:flex; gap:20px; padding:12px 0; border-bottom:1px solid var(--border); flex-wrap:wrap; font-family:var(--font-mono); }
    .stat { }
    .stat .num { font-size:18px; font-weight:700; }
    .stat .lbl { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:0.04em; }

    table { width:100%; border-collapse:collapse; margin-top:12px; border-top:2px solid var(--text); }
    th { text-align:left; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); padding:8px 6px; border-bottom:1px solid var(--border); }
    td { padding:8px 6px; border-bottom:1px solid var(--hairline); font-size:13px; }
    tr:hover td { background:var(--hairline); }

    .rank-cell { font-family:var(--font-mono); font-size:12px; color:var(--muted); width:32px; }
    .name-cell a { font-weight:600; }
    .name-cell a:hover { color:var(--accent); }
    .name-cell .desc { font-size:12px; color:var(--muted); margin-top:1px; display:block; max-width:360px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .grade { font-family:var(--font-mono); font-size:11px; font-weight:700; margin-left:4px; padding:1px 5px; border-radius:3px; }
    /* grade colors come from site.css (.grade-A..D = white on color) */
    .state-chip { font-family:var(--font-mono); font-size:11px; font-weight:600; margin-left:4px; text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); }
    .state-listed { color:var(--green); }
    .state-warning { color:var(--red); }

    .score-cell { font-family:var(--font-mono); font-size:13px; font-weight:600; }
    .score-hi { color:var(--green); }
    .score-mid { color:var(--amber); }
    .score-lo { color:var(--muted); }

    .stars-cell { font-family:var(--font-mono); font-size:12px; color:var(--muted); }
    .lang-cell { font-size:12px; color:var(--muted); }

    .cat-nav { padding:16px 0; border-top:1px solid var(--border); }
    .cat-nav h2 { font-size:15px; font-weight:600; margin-bottom:8px; }
    .cat-pills { display:flex; gap:4px; flex-wrap:wrap; }
    .cat-pill { font-family:var(--font-mono); font-size:12px; padding:3px 8px; color:var(--muted); }
    .cat-pill:hover { color:var(--accent); text-decoration:none; }
    .cat-pill.active { color:var(--accent); font-weight:600; }

    /* Plan 2.6: podium, grade mix, filters, and the first 50 rows expanded.
       Every row stays in the HTML for search; the rest open 50 at a time. */
    .podium { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:10px; margin:16px 0 4px; }
    .pod { border:1px solid var(--border); background:var(--surface); border-radius:10px; padding:12px 14px; min-width:0; }
    .pod-rank { font-family:var(--font-mono); font-size:11px; color:var(--muted); }
    .pod-name { display:block; margin:4px 0 8px; font-weight:700; font-size:15px; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .pod-line { display:flex; align-items:baseline; gap:8px; font-family:var(--font-mono); }
    .pod-score { font-size:20px; font-weight:700; font-variant-numeric:tabular-nums; }
    .pod-stars { margin-left:auto; font-size:12px; color:var(--muted); }
    .gmix { margin:18px 0 6px; }
    .gmix-head { display:flex; justify-content:space-between; gap:10px; font-family:var(--font-mono); font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; margin-bottom:6px; }
    .gmix-bar { display:flex; height:12px; border-radius:6px; overflow:hidden; background:var(--border); }
    .gmix-bar span { display:block; min-width:2px; }
    .gm-A { background:#2f6846; } .gm-B { background:#2c5282; } .gm-C { background:#8b6914; } .gm-D { background:#57524c; }
    .gm-P { background:repeating-linear-gradient(135deg, #57524c 0 3px, transparent 3px 6px); opacity:.55; }
    .gmix-key { display:flex; gap:14px; flex-wrap:wrap; margin-top:6px; font-family:var(--font-mono); font-size:11.5px; color:var(--muted); }
    .gmix-key i { display:inline-block; width:9px; height:9px; border-radius:2px; margin-right:5px; vertical-align:-1px; }
    .cat-filters { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin:16px 0 0; }
    .cat-filters input[type=search] { flex:1 1 240px; min-width:0; height:40px; padding:0 12px; font:inherit; font-size:14px; border:1px solid var(--line-strong, var(--border)); border-radius:8px; background:var(--bg); color:var(--text); }
    .fchip { height:40px; min-width:40px; padding:0 12px; font-family:var(--font-mono); font-size:12.5px; border:1px solid var(--border); border-radius:8px; background:var(--bg); color:var(--text); cursor:pointer; }
    .fchip[aria-pressed="true"] { background:var(--accent); border-color:var(--accent); color:var(--on-accent); }
    .cat-filters select { height:40px; padding:0 8px; font:inherit; font-size:13px; border:1px solid var(--border); border-radius:8px; background:var(--bg); color:var(--text); }
    .cat-count { font-family:var(--font-mono); font-size:11.5px; color:var(--muted); margin-top:8px; }
    .cat-table.is-collapsed tr.is-more { display:none; }
    .grade.grade-pending { color:var(--muted); border:1px dashed var(--border); background:transparent; font-weight:600; }
    .show-more { display:block; margin:12px auto 0; height:44px; padding:0 18px; font-family:var(--font-mono); font-size:13px; border:1px solid var(--accent); border-radius:8px; background:var(--bg); color:var(--accent); cursor:pointer; }
    .show-more:hover { background:var(--accent); color:var(--on-accent); }
    .cat-about { margin-top:22px; border-top:1px solid var(--border); }
    .cat-about h2 { font-size:15px; font-weight:600; margin:16px 0 4px; }

    footer { padding:20px 0; margin-top:16px; border-top:1px solid var(--border); font-size:12px; color:var(--muted); text-align:center; }
    footer a { color:var(--accent); }

    @media (max-width:600px) {
      h1 { font-size:18px; }
      .podium { grid-template-columns:1fr; gap:6px; }
      .pod { display:flex; align-items:center; gap:10px; padding:8px 12px; }
      .pod-rank { flex:none; }
      .pod-name { flex:1; margin:0; font-size:14px; }
      .pod-score { font-size:16px; }
      .pod-stars, .pod-rank-long { display:none; }
      .cat-table th:nth-child(5), .cat-table td:nth-child(5) { display:none; }
      .stats-bar { gap:12px; }
      td, th { padding:6px 4px; }
      .name-cell .desc { max-width:180px; }
    }
  </style>
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){var host=window.location.hostname||"";if(/^(localhost|127(?:\.\d{1,3}){3}|0(?:\.\d{1,3}){3}|::1)$/i.test(host)){window["ga-disable-G-TZ8921LR0K"]=true;return}try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(navigator.webdriver||/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
</head>
<body data-page-type="category_page" data-category="{{ category }}">
  {% include "_site_header.html.j2" %}
  <main class="page" id="main">

    {% set scored = agents | rejectattr("pending_signals") | list %}
    {% set n = agents | length %}
    <section class="hero">
      <h1>{{ category }}</h1>
      <p class="subtitle">{{ n }} {{ item_plural|default('agents') }} tracked &middot; ranked by trust score &middot; Updated {{ updated }}{% if scored|length >= 3 %} &middot; the three strongest right now:{% endif %}</p>
      {% if scored|length >= 3 %}
      <div class="podium">
        {% for a in scored[:3] %}
        <div class="pod">
          <span class="pod-rank">#{{ a.category_rank }}<span class="pod-rank-long"> in category</span></span>
          <a class="pod-name" href="/agents/{{ a.slug }}/">{{ a.name }}</a>
          <div class="pod-line"><span class="pod-score">{{ a.trust_score }}</span><span class="grade grade-{{ a.evidence_grade }}">{{ a.evidence_grade }}</span><span class="pod-stars">{{ a.stars_fmt }} &#9733;</span></div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% set pend_n = n - scored|length %}
      <div class="gmix">
        <div class="gmix-head"><span>Grade mix</span><span>{{ n }} {{ item_plural|default('agents') }}</span></div>
        <div class="gmix-bar" role="img" aria-label="Grade mix: {% for g in 'ABCD' %}{{ scored | selectattr('evidence_grade', 'equalto', g) | list | length }} {{ g }}{{ ', ' }}{% endfor %}{{ pend_n }} awaiting a first full check">
          {% for g in 'ABCD' %}{% set c = scored | selectattr('evidence_grade', 'equalto', g) | list | length %}{% if c %}<span class="gm-{{ g }}" style="width:{{ (c * 100 / n) | round(2) }}%"></span>{% endif %}{% endfor %}
          {% if pend_n %}<span class="gm-P" style="width:{{ (pend_n * 100 / n) | round(2) }}%"></span>{% endif %}
        </div>
        <div class="gmix-key">
          {% for g in 'ABCD' %}<span><i class="gm-{{ g }}"></i>{{ scored | selectattr('evidence_grade', 'equalto', g) | list | length }} {{ g }}</span>{% endfor %}
          {% if pend_n %}<span><i class="gm-P"></i>{{ pend_n }} provisional, awaiting a first full check</span>{% endif %}
        </div>
      </div>
      <div class="cat-filters" role="search">
        <input type="search" id="catSearch" placeholder="Search {{ n }} {{ category }}…" aria-label="Search {{ category }}">
        {% for g in 'ABCD' %}<button type="button" class="fchip" data-grade="{{ g }}" aria-pressed="false">{{ g }}</button>{% endfor %}
        <button type="button" class="fchip" id="catProv" aria-pressed="false">Has provenance</button>
        <select id="catSort" aria-label="Sort">
          <option value="rank">Sort: Trust</option>
          <option value="stars">Sort: Stars</option>
          <option value="push">Sort: Last push</option>
        </select>
      </div>
      <p class="cat-count" id="catCount" aria-live="polite"></p>
    </section>

    <table class="cat-table is-collapsed" id="catTable">
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">Agent</th>
          <th scope="col">Trust</th>
          <th scope="col">Stars</th>
          <th scope="col">Language</th>
        </tr>
      </thead>
      <tbody>
        {% for a in agents %}
        <tr{% if loop.index > 50 %} class="is-more"{% endif %} data-g="{% if a.pending_signals %}P{% else %}{{ a.evidence_grade }}{% endif %}" data-p="{{ 1 if a.has_provenance else 0 }}" data-r="{{ a.category_rank or 9999 }}" data-s="{{ a.stars or 0 }}" data-d="{{ a.days_ago if a.days_ago is not none else 9999 }}" data-q="{{ (a.name ~ ' ' ~ (a.repo or '') ~ ' ' ~ (a.description or '')) | lower }}">
          <td class="rank-cell">{{ a.category_rank }}</td>
          <td class="name-cell">
            <a href="/agents/{{ a.slug }}/">{{ a.name }}</a>
            {% if a.pending_signals %}<span class="grade grade-pending" title="Provisional: awaiting a first full signal check">pending</span>{% else %}<span class="grade grade-{{ a.evidence_grade }}">{{ a.evidence_grade }}</span>{% endif %}
            <span class="state-chip state-{{ a.display_listing_status }}">{{ a.display_status_label }}</span>
            {% if a.description %}<span class="desc">{{ a.description }}</span>{% endif %}
          </td>
          <td class="score-cell {% if a.trust_score >= 60 %}score-hi{% elif a.trust_score >= 35 %}score-mid{% else %}score-lo{% endif %}">{{ a.trust_score }}</td>
          <td class="stars-cell">{{ a.stars_fmt }}</td>
          <td class="lang-cell">{{ a.language or '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <noscript><style>.cat-table.is-collapsed tr.is-more { display:table-row; } .cat-filters, .show-more { display:none; }</style></noscript>
    {% if n > 50 %}<button type="button" class="show-more" id="catMore">Show the next 50 of {{ n }}</button>{% endif %}
    <p style="font-family:var(--font-mono);font-size:11px;color:var(--muted);margin-top:6px;">Grade = trust band: A ≥ 80, B ≥ 65, C ≥ 50, D &lt; 50 — <a href="/methodology/" style="color:var(--accent);">methodology</a></p>

    <section class="cat-about">
      <h2>About {{ category }}</h2>
      <div class="seo-intro">
        <p>HVTracker independently evaluates <strong>{{ agents|length }} {{ category|lower }}</strong> using daily signals from GitHub, package registries, and security databases. The category is open-source-first, with a limited set of public GitHub-hosted proprietary or source-available comparators when they are important ecosystem reference points.
        Each {{ item_noun|default('agent') }} is scored on activity, adoption, transparency, safety, and identity.
        {# Singularise the category for "the top-ranked <X> is". The old
           replace('agents','agent') only matched categories containing the
           literal "agents", so "Agent Skills" fell through as a plural and
           read "The top-ranked agent skills is". Trailing-s is stripped only
           when present, so "Memory & Knowledge" survives untouched. #}
        {% set cat_singular = category|lower %}
        {% set cat_singular = cat_singular[:-1] if cat_singular.endswith('s') else cat_singular %}
        {% if agents|length > 0 %}The top-ranked {{ cat_singular }} is <strong>{{ agents[0].name }}</strong> with a trust score of {{ agents[0].trust_score }}/100 (Grade {{ agents[0].evidence_grade }}).{% endif %}
        {% if agents|length > 2 %}Other leading projects include {{ agents[1].name }} and {{ agents[2].name }}.{% endif %}
        </p>
      </div>
    </section>
    <div class="stats-bar">
      <div class="stat">
        <div class="num">{{ agents|length }}</div>
        <div class="lbl">{{ item_plural|default('agents')|title }}</div>
      </div>
      <div class="stat">
        <div class="num">{{ avg_trust }}</div>
        <div class="lbl">Avg Trust</div>
      </div>
      <div class="stat">
        <div class="num">{{ total_stars }}</div>
        <div class="lbl">Total Stars</div>
      </div>
      <div class="stat">
        <div class="num">{{ grade_a_count }}</div>
        <div class="lbl">Grade A</div>
      </div>
      {% if warning_count %}
      <div class="stat">
        <div class="num" style="color:var(--red)">{{ warning_count }}</div>
        <div class="lbl">Warnings</div>
      </div>
      {% endif %}
    </div>


    {% if comparisons %}
    <nav class="cat-nav">
      <h2>Popular {{ category }} comparisons</h2>
      <div class="cat-pills">
        {% for c in comparisons %}
        <a href="{{ c.url }}" class="cat-pill">{{ c.a }} vs {{ c.b }}</a>
        {% endfor %}
      </div>
    </nav>
    {% endif %}

    <nav class="cat-nav">
      <h2>All Categories</h2>
      <div class="cat-pills">
        {% for c in all_categories %}
        <a href="/categories/{{ c.slug }}/" class="cat-pill {% if c.name == category %}active{% endif %}">{{ c.name }} ({{ c.count }})</a>
        {% endfor %}
      </div>
    </nav>

    <footer>
      <a href="/methodology/">Methodology</a>
      <span class="footer-sep">&middot;</span>
      <a href="/spec/">Specifications</a>
      <span class="footer-sep">&middot;</span>
      <a href="/data/">Data API</a>
      <span class="footer-sep">&middot;</span>
      <a href="/compare/">Compare</a>
      <span class="footer-sep">&middot;</span>
      <a href="/badges/">Badges</a>
      <span class="footer-sep">&middot;</span>
      <a href="/changelog/">Changelog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/blog/">Blog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/submit/">Submit Agent</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker" target="_blank" rel="noopener">GitHub</a>
    </footer>
  </main>
  <script>
  (function () {
    var table = document.getElementById("catTable");
    if (!table) return;
    var body = table.tBodies[0], rows = Array.prototype.slice.call(body.rows);
    var q = document.getElementById("catSearch"), sort = document.getElementById("catSort");
    var prov = document.getElementById("catProv"), more = document.getElementById("catMore");
    var count = document.getElementById("catCount");
    var chips = document.querySelectorAll(".fchip[data-grade]");
    var shown = 50, grades = {};
    table.classList.remove("is-collapsed");
    function apply() {
      var term = q.value.trim().toLowerCase(), wantProv = prov.getAttribute("aria-pressed") === "true";
      var anyGrade = Object.keys(grades).length > 0, filtering = term || wantProv || anyGrade, visible = 0, matched = 0;
      rows.forEach(function (tr) {
        var ok = (!term || tr.dataset.q.indexOf(term) !== -1) && (!wantProv || tr.dataset.p === "1") && (!anyGrade || grades[tr.dataset.g]);
        if (ok) matched++;
        var show = ok && (filtering || matched <= shown);
        tr.style.display = show ? "" : "none";
        if (show) visible++;
      });
      if (more) {
        more.hidden = filtering || shown >= rows.length;
        more.textContent = "Show the next " + Math.min(50, rows.length - shown) + " of " + rows.length;
      }
      count.textContent = filtering ? matched + " of " + rows.length + " match" : "Showing " + visible + " of " + rows.length;
    }
    q.addEventListener("input", apply);
    prov.addEventListener("click", function () { prov.setAttribute("aria-pressed", prov.getAttribute("aria-pressed") !== "true"); apply(); });
    Array.prototype.forEach.call(chips, function (c) {
      c.addEventListener("click", function () {
        var on = c.getAttribute("aria-pressed") !== "true";
        c.setAttribute("aria-pressed", on);
        if (on) grades[c.dataset.grade] = 1; else delete grades[c.dataset.grade];
        apply();
      });
    });
    sort.addEventListener("change", function () {
      var k = sort.value, key = k === "stars" ? "s" : k === "push" ? "d" : "r", dir = k === "stars" ? -1 : 1;
      rows.sort(function (a, b) { return dir * (Number(a.dataset[key]) - Number(b.dataset[key])) || Number(a.dataset.r) - Number(b.dataset.r); });
      rows.forEach(function (tr) { body.appendChild(tr); });
      apply();
    });
    if (more) more.addEventListener("click", function () { shown += 50; apply(); });
    apply();
  })();
  </script>
</body>
</html>
