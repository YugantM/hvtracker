<body data-page-type="roadmap">
  <div class="page">

    <header>
      <a href="/" class="logo">HV<span>Tracker</span></a>
      <span class="tagline">Trust signals for open-source AI agents</span>
      <nav class="site-nav" aria-label="Site">
