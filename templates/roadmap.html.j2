    .logo span { color: var(--accent); }
    .tagline { font-size: 13px; color: var(--muted); }
    .site-nav { margin-left: auto; font-family: var(--font-mono); font-size: 12px; display: flex; gap: 8px; align-items: baseline; }
    .site-nav a { color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 5px 10px; background: rgba(255,255,255,0.03); }
    .site-nav a:hover { color: var(--text); border-color: var(--accent); text-decoration: none; }
    .site-nav .active { color: var(--text); border-color: var(--accent); font-weight: 600; }

    .content { max-width: 760px; margin: 0 auto; padding: 40px 0 0; }

    .doc-title { font-family: var(--font-mono); font-size: 28px; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 8px; line-height: 1.2; }
    .doc-lede { font-size: 16px; color: var(--text); margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px solid var(--border); }

    section { margin-bottom: 40px; }
    h2 { font-family: var(--font-mono); font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); margin-bottom: 16px; }
    p { margin-bottom: 14px; }

    .stage { padding: 18px 20px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-2); margin-bottom: 14px; }
    .stage-header { display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
    .stage-tag { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; padding: 3px 8px; border-radius: 4px; font-weight: 700; }
    .stage-tag.shipped { background: rgba(45,212,191,0.15); color: var(--fresh); }
    .stage-tag.building { background: rgba(216,166,87,0.18); color: var(--mocha); }
    .stage-tag.next { background: var(--accent-lt); color: var(--accent); }
    .stage-tag.later { background: rgba(168,179,194,0.10); color: var(--muted); }
    .stage-title { font-family: var(--font-mono); font-size: 15px; font-weight: 700; color: var(--text); }
    .stage p { margin-bottom: 8px; font-size: 14px; }
    .stage ul { padding-left: 1.25em; margin: 8px 0 4px; }
    .stage li { margin-bottom: 4px; font-size: 13.5px; color: var(--muted); }
    .stage li strong { color: var(--text); }

    footer { max-width: 760px; margin: 48px auto 0; padding-top: 24px; border-top: 1px solid var(--border); font-size: 13px; color: var(--muted); line-height: 1.7; }
    footer .footer-links { font-family: var(--font-mono); font-size: 12px; display: flex; flex-wrap: wrap; gap: 8px 16px; margin-bottom: 20px; }
    footer .disclaimer { font-size: 12px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }

    @media (max-width: 640px) {
      header { flex-direction: column; gap: 8px; }
      .site-nav { margin-left: 0; }
      .doc-title { font-size: 24px; }
