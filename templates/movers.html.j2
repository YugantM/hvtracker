<!DOCTYPE html>
<!-- stacked-radar v2 -->
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Agent Rank Movers — Fresh Trust Changes | HVTracker</title>
  <meta name="description" content="Daily AI agent rank movers from HVTracker: biggest trust rank gains, drops, and category movement across the current history window.">
  <link rel="canonical" href="https://hvtracker.net/movers/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="AI Agent Rank Movers | HVTracker">
  <meta property="og:description" content="Fresh trust-rank gains and drops across open-source AI agents.">
  <meta property="og:url" content="https://hvtracker.net/movers/">
  <meta property="og:image" content="https://hvtracker.net/og-v2.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="AI Agent Rank Movers | HVTracker">
  <meta name="twitter:description" content="Fresh trust-rank gains and drops across open-source AI agents.">
  <meta name="twitter:image" content="https://hvtracker.net/og-v2.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{--bg:#0b0d10;--surface:rgba(21,25,32,.78);--surface-2:rgba(27,32,41,.82);--border:rgba(142,154,176,.22);--hairline:rgba(168,179,194,.12);--text:#eef2f6;--muted:#a8b3c2;--accent:#8fb3ff;--fresh:#2dd4bf;--mocha:#d8a657;--red:#e8798b;--font-mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;--font-sans:"Hanken Grotesk",system-ui,-apple-system,sans-serif}
    body{min-height:100vh;background:var(--bg);color:var(--text);font:15px/1.62 var(--font-sans);background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.03'/%3E%3C/svg%3E"),radial-gradient(circle at 16% -10%,rgba(45,212,191,.14),transparent 30%),radial-gradient(circle at 86% 4%,rgba(216,166,87,.12),transparent 28%),linear-gradient(180deg,#10141a 0%,#0b0d10 54%,#07090c 100%)}
    a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}
    .page{max-width:1080px;margin:0 auto;padding:28px 20px 44px}
    header{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;padding:16px 18px;border:1px solid var(--border);border-radius:10px;background:linear-gradient(135deg,rgba(255,255,255,.075),rgba(255,255,255,.018)),var(--surface);box-shadow:inset 0 1px 0 rgba(255,255,255,.05),0 18px 54px rgba(0,0,0,.28)}
    .logo{font-family:var(--font-mono);font-weight:700;font-size:18px}.logo span{color:var(--accent)}
    nav{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;font:11px var(--font-mono)}nav a{color:var(--muted);border:1px solid var(--border);border-radius:999px;padding:5px 10px;background:rgba(255,255,255,.035)}
    .hero{padding:32px 0 18px;border-bottom:1px solid var(--hairline)}
    h1{font-size:34px;line-height:1.14;letter-spacing:0;margin-bottom:8px}.hero p{color:var(--muted);max-width:760px}
    .meta{font:11px var(--font-mono);color:var(--muted);margin-top:14px}
    .summary-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:22px 0}
    .summary{border-top:1px solid var(--hairline);padding-top:12px}.summary strong{display:block;font:700 24px var(--font-mono);color:var(--fresh)}.summary span{color:var(--muted);font-size:12px}
    .summary.down strong{color:var(--red)}
    .chart-band{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:22px 0}
    .chart-panel{border-top:1px solid var(--hairline);padding-top:16px;min-width:0}.chart-panel h2{font-size:14px;margin-bottom:10px}.insight-chart{width:100%;height:auto;display:block;overflow:visible}
    .mover-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:20px}
    .mover-list{border-top:1px solid var(--hairline);padding-top:14px}
    .mover-list h2{font-size:15px;margin-bottom:10px}
    .mover-item{display:grid;grid-template-columns:54px minmax(0,1fr) 54px;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--hairline)}
    .delta{font:700 13px var(--font-mono)}.up .delta{color:var(--fresh)}.down .delta{color:var(--red)}
    .name{font-weight:700}.sub{display:block;color:var(--muted);font:11px var(--font-mono);margin-top:2px}.rank{font:12px var(--font-mono);color:var(--muted);text-align:right}
    footer{margin-top:34px;padding-top:18px;border-top:1px solid var(--hairline);font:11px var(--font-mono);color:var(--muted);text-align:center}
    footer a{color:var(--accent)}
    @media(max-width:760px){.summary-row,.chart-band,.mover-grid{grid-template-columns:1fr}h1{font-size:26px}nav{margin-left:0}}
  </style>
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
</head>
<body data-page-type="movers">
  <div class="page">
    <header>
      <a href="/" class="logo">HV<span>Tracker</span></a>
      <nav aria-label="Site">
        <a href="/">Leaderboard</a>
        <a href="/use-cases/">Use cases</a>
        <a href="/compare/">Compare</a>
        <a href="/methodology">Methodology</a>
      </nav>
    </header>

    <section class="hero">
      <h1>AI Agent Rank Movers</h1>
      <p>Daily movement from the current {{ history_days }}-day history window. Gains and drops are based on HVTracker rank changes, so this page stays fresh as the cron refresh updates snapshots.</p>
      <div class="meta">Updated {{ updated }}</div>
    </section>

    <section class="summary-row" aria-label="Movement summary">
      <div class="summary"><strong>{{ movers.up|length }}</strong><span>Agents rising</span></div>
      <div class="summary down"><strong>{{ movers.down|length }}</strong><span>Agents falling</span></div>
      <div class="summary"><strong>{{ movers.top_category or '—' }}</strong><span>Most active category</span></div>
    </section>

    <section class="chart-band" aria-label="Trust profile comparison">
      <div class="chart-panel">
        <h2>Rising Agents — Trust Profile</h2>
        {{ movers.radar_up_svg | safe }}
      </div>
      <div class="chart-panel">
        <h2>Falling Agents — Trust Profile</h2>
        {{ movers.radar_down_svg | safe }}
      </div>
    </section>

    <section class="mover-grid">
      <div class="mover-list">
        <h2>Biggest Gains</h2>
        {% for item in movers.up %}
        <a class="mover-item up" href="/agents/{{ item.slug }}/">
          <span class="delta">+{{ item.delta }}</span>
          <span><span class="name">{{ item.name }}</span><span class="sub">{{ item.category }} · Grade {{ item.evidence_grade }} · HVTrust {{ item.trust_score }}</span></span>
          <span class="rank">#{{ item.rank }}</span>
        </a>
        {% endfor %}
      </div>
      <div class="mover-list">
        <h2>Biggest Drops</h2>
        {% for item in movers.down %}
        <a class="mover-item down" href="/agents/{{ item.slug }}/">
          <span class="delta">{{ item.delta }}</span>
          <span><span class="name">{{ item.name }}</span><span class="sub">{{ item.category }} · Grade {{ item.evidence_grade }} · HVTrust {{ item.trust_score }}</span></span>
          <span class="rank">#{{ item.rank }}</span>
        </a>
        {% endfor %}
      </div>
    </section>

    <footer>
      <a href="/">HVTracker</a> &middot; <a href="/data/latest.json">Data API</a> &middot; <a href="/feed.json">Feed</a>
    </footer>
  </div>
</body>
</html>
