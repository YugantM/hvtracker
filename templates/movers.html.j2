<!DOCTYPE html>
<!-- stacked-radar v2 -->
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="s2YUWbGP7cJsI6HUCKRX9YCtbVJVyA1Q1_jsNWj1RHc">
  <title>AI Agent Rank Movers — Fresh Trust Changes | HVTracker</title>
  <meta name="description" content="Daily AI agent rank movers from HVTracker: biggest trust rank gains, drops, and category movement across the current history window.">
  <link rel="canonical" href="https://hvtracker.net/movers/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="AI Agent Rank Movers | HVTracker">
  <meta property="og:description" content="Fresh trust-rank gains and drops across open-source AI agents.">
  <meta property="og:url" content="https://hvtracker.net/movers/">
  <meta property="og:image" content="https://hvtracker.net/og-v2.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="AI Agent Rank Movers | HVTracker">
  <meta name="twitter:description" content="Fresh trust-rank gains and drops across open-source AI agents.">
  <meta name="twitter:image" content="https://hvtracker.net/og-v2.png">
  <link rel="stylesheet" href="/static/site.css?v={{ css_hash }}">
  <style>
    body{line-height:1.65}
    .page{max-width:960px;padding:24px 24px 40px}
    .logo span{color:var(--lobster)}
    .hero{padding:24px 0 16px;border-bottom:1px solid var(--line)}
    h1{font-size:26px;font-weight:700;margin-bottom:6px}.hero p{color:var(--muted);font-size:15px;max-width:680px}
    .meta{font:12px var(--font-mono);color:var(--muted);margin-top:10px}
    .summary-row{display:flex;gap:16px;flex-wrap:wrap;margin:16px 0;font-family:var(--font-mono)}
    .summary{padding:10px 12px;background:var(--paper-2);border-top:2px solid var(--line-strong);min-width:180px}
    .summary strong{display:block;font-size:20px;font-weight:700;color:var(--moss)}.summary span{color:var(--muted);font-size:12px}
    .summary.down strong{color:var(--lobster)}
    .chart-band{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:16px 0}
    .chart-panel{border-top:2px solid var(--line-strong);padding-top:12px;min-width:0;background:var(--paper-2);padding-left:12px;padding-right:12px;padding-bottom:12px}.chart-panel h2{font-size:13px;margin-bottom:8px}.insight-chart{width:100%;height:auto;display:block;overflow:visible}
    .mover-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:16px}
    .mover-list{border-top:2px solid var(--line-strong);padding-top:12px;background:var(--paper-2);padding-left:12px;padding-right:12px;padding-bottom:4px}
    .mover-list h2{font-size:15px;margin-bottom:8px}
    .mover-item{display:grid;grid-template-columns:52px minmax(0,1fr) 48px;gap:10px;align-items:start;padding:12px 0;border-bottom:1px solid var(--line)}
    .mover-item:last-child{border-bottom:none}
    .mover-item:hover{text-decoration:none}
    .mover-item:hover .name{text-decoration:underline}
    .delta{font:700 13px var(--font-mono)}.up .delta{color:var(--green)}.down .delta{color:var(--lobster)}
    .name{font-weight:600;font-size:13px}
    .sub{display:block;color:var(--muted);font:12px var(--font-mono);margin-top:2px}
    .rank{font:12px var(--font-mono);color:var(--muted);text-align:right}
    .rank-movement{display:block;font:12px var(--font-mono);color:var(--muted);margin-top:3px}
    .state-chip{display:inline-block;font:600 11px var(--font-mono);margin-left:6px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);padding:2px 6px;border:1px solid var(--line)}
    .state-listed{color:var(--moss);background:rgba(111,135,110,.14)}
    .state-warning{color:var(--lobster);background:var(--lobster-soft)}
    .state-legacy{color:var(--muted);background:rgba(111,102,93,.10)}
    .event-label{font:600 11px var(--font-mono);text-transform:uppercase;letter-spacing:.04em;color:var(--blue-strong);margin-top:5px;display:block}
    .event-detail{display:block;color:var(--muted);font-size:12px;line-height:1.5;margin-top:2px}
    .movers-ticker{padding:12px 0;border-bottom:1px solid var(--line)}
    .movers-ticker-title{font-family:var(--font-mono);font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
    .movers-ticker-row{display:flex;gap:12px;margin-top:6px;flex-wrap:wrap;font-family:var(--font-mono);font-size:12px}
    .ticker-item{display:flex;align-items:center;gap:4px;color:var(--ink)}.ticker-item:hover{text-decoration:none;color:var(--blue-strong)}
    .ticker-arrow{font-weight:700}.ticker-up .ticker-arrow{color:var(--green)}.ticker-down .ticker-arrow{color:var(--red)}
    .ticker-rank{color:var(--muted);font-size:11px}
    footer{margin-top:28px;padding-top:14px;border-top:1px solid var(--line);font:12px var(--font-mono);color:var(--muted);text-align:center}
    footer a{color:var(--blue-strong)}
    @media(max-width:760px){.chart-band,.mover-grid{grid-template-columns:1fr}h1{font-size:18px}}
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "Movers" }
    ]
  }
  </script>
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
</head>
<body data-page-type="movers">
  {% include "_site_header.html.j2" %}
  <main class="page" id="main">

    <section class="hero">
      <h1>AI Agent Rank Movers</h1>
      <p>Daily trust-rank changes. Each entry shows the net rank delta, the old→new position, and the latest tracked trust event.</p>
      <div class="meta">Updated {{ updated }}</div>
    </section>

    <section class="summary-row" aria-label="Movement summary">
      <div class="summary"><strong>{{ movers.up|length }}</strong><span>Agents rising</span></div>
      <div class="summary down"><strong>{{ movers.down|length }}</strong><span>Agents falling</span></div>
      <div class="summary"><strong>{{ movers.top_category or '—' }}</strong><span>Most active category</span></div>
    </section>
    {% if movers.latest_date %}
    <div class="meta" style="margin-bottom:18px;">Snapshot {{ movers.latest_date }}{% if movers.baseline_date %} vs {{ movers.baseline_date }}{% endif %}</div>
    {% endif %}

    {% if movers.up or movers.down %}
    <div class="movers-ticker">
      <span class="movers-ticker-title">Daily movers</span>
      <div class="movers-ticker-row">
        {% for m in movers.up[:3] %}
        <a href="/agents/{{ m.slug }}/" class="ticker-item ticker-up">
          <span class="ticker-arrow">▲{{ m.delta }}</span>
          <span>{{ m.name }}</span>
          <span class="ticker-rank">#{{ m.rank }}</span>
        </a>
        {% endfor %}
        {% for m in movers.down[:3] %}
        <a href="/agents/{{ m.slug }}/" class="ticker-item ticker-down">
          <span class="ticker-arrow">▼{{ m.delta|abs }}</span>
          <span>{{ m.name }}</span>
          <span class="ticker-rank">#{{ m.rank }}</span>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <section class="chart-band" aria-label="Trust profile comparison">
      <div class="chart-panel">
        <h2>Rising Agents — Trust Profile</h2>
        {{ movers.radar_up_svg | safe }}
      </div>
      <div class="chart-panel">
        <h2>Falling Agents — Trust Profile</h2>
        {{ movers.radar_down_svg | safe }}
      </div>
    </section>

    <section class="mover-grid">
      <div class="mover-list">
        <h2>Biggest Gains</h2>
        {% for item in movers.up %}
        <a class="mover-item up" href="/agents/{{ item.slug }}/">
          <span class="delta">+{{ item.delta }}</span>
          <span>
            <span class="name">{{ item.name }}</span><span class="state-chip state-{{ item.display_listing_status }}">{{ item.display_status_label }}</span>
            <span class="sub">{{ item.category }} · Grade {{ item.evidence_grade }} · HVTrust {{ item.trust_score }}</span>
            <span class="rank-movement">#{{ item.old_rank }} → #{{ item.rank }}</span>
            {% if item.recent_change_summary %}<span class="event-label">{{ item.recent_change_summary.short_label }}</span><span class="event-detail">{{ item.recent_change_summary.detail }}</span>{% endif %}
          </span>
          <span class="rank">#{{ item.rank }}</span>
        </a>
        {% endfor %}
      </div>
      <div class="mover-list">
        <h2>Biggest Drops</h2>
        {% for item in movers.down %}
        <a class="mover-item down" href="/agents/{{ item.slug }}/">
          <span class="delta">{{ item.delta }}</span>
          <span>
            <span class="name">{{ item.name }}</span><span class="state-chip state-{{ item.display_listing_status }}">{{ item.display_status_label }}</span>
            <span class="sub">{{ item.category }} · Grade {{ item.evidence_grade }} · HVTrust {{ item.trust_score }}</span>
            <span class="rank-movement">#{{ item.old_rank }} → #{{ item.rank }}</span>
            {% if item.recent_change_summary %}<span class="event-label">{{ item.recent_change_summary.short_label }}</span><span class="event-detail">{{ item.recent_change_summary.detail }}</span>{% endif %}
          </span>
          <span class="rank">#{{ item.rank }}</span>
        </a>
        {% endfor %}
      </div>
    </section>

    <footer>
      <a href="/methodology/">Methodology</a>
      <span class="footer-sep">&middot;</span>
      <a href="/spec/">Specifications</a>
      <span class="footer-sep">&middot;</span>
      <a href="/data/">Data API</a>
      <span class="footer-sep">&middot;</span>
      <a href="/compare/">Compare</a>
      <span class="footer-sep">&middot;</span>
      <a href="/badges/">Badges</a>
      <span class="footer-sep">&middot;</span>
      <a href="/changelog/">Changelog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/blog/">Blog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/submit/">Submit Agent</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker" target="_blank" rel="noopener">GitHub</a>
    </footer>
  </main>
</body>
</html>
