<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% include "_head_icons.html.j2" %}
  <meta name="google-site-verification" content="s2YUWbGP7cJsI6HUCKRX9YCtbVJVyA1Q1_jsNWj1RHc">
  <title>{{ a.name }} vs {{ b.name }}: AI agent trust comparison | HVTracker</title>
  <meta name="description" content="{{ a.name }} scores {{ a.trust_score }}/100 (Grade {{ a.evidence_grade }}), {{ b.name }} scores {{ b.trust_score }}/100 (Grade {{ b.evidence_grade }}). Compared on provenance, OSSF Scorecard, MCP support, maintenance, and downloads — public, checkable evidence, not hype.">
  <link rel="canonical" href="https://hvtracker.net/compare/{{ a.slug }}-vs-{{ b.slug }}/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ a.name }} vs {{ b.name }} — AI agent trust comparison">
  <meta property="og:description" content="{{ a.name }} {{ a.trust_score }}/100 (Grade {{ a.evidence_grade }}) vs {{ b.name }} {{ b.trust_score }}/100 (Grade {{ b.evidence_grade }}) — provenance, Scorecard, MCP support, and activity from public, checkable data.">
  <meta property="og:url" content="https://hvtracker.net/compare/{{ a.slug }}-vs-{{ b.slug }}/">
  <meta property="og:image" content="https://hvtracker.net/og-v2.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ a.name }} vs {{ b.name }} — AI agent trust comparison">
  <meta name="twitter:description" content="{{ a.name }} {{ a.trust_score }}/100 vs {{ b.name }} {{ b.trust_score }}/100 — evidence-based trust comparison on HVTracker.">
  <meta name="twitter:image" content="https://hvtracker.net/og-v2.png">
  <link rel="stylesheet" href="/static/site.css?v={{ css_hash }}">
  <style>
    .page { max-width: 900px; padding: 0 24px 52px; }
    .cmp-crumb { font-family: var(--font-mono); font-size: 12px; color: var(--muted); padding: 16px 0 0; }
    .cmp-crumb a { color: var(--muted); }
    .cmp-crumb a:hover { color: var(--accent); }
    .cmp-hero { padding: 14px 0 18px; border-bottom: 1px solid var(--border); }
    .cmp-hero h1 { font-size: 30px; line-height: 1.15; letter-spacing: -.5px; }
    .cmp-hero p { color: var(--muted); font-size: 16px; line-height: 1.6; margin-top: 10px; max-width: 680px; }
    .cmp-verdict { margin: 20px 0; padding: 14px 16px; border: 1px solid var(--border); border-left: 3px solid var(--accent); background: var(--surface); font-size: 15px; line-height: 1.55; }
    .cmp-verdict strong { color: var(--accent); }
    table.cmp { width: 100%; border-collapse: collapse; margin: 8px 0 4px; font-size: 15px; border-top: 2px solid var(--text); }
    table.cmp th, table.cmp td { padding: 11px 12px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: middle; }
    table.cmp thead th { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
    table.cmp thead th.col-agent a { font-weight: 600; color: var(--text); font-size: 15px; text-transform: none; letter-spacing: 0; }
    table.cmp thead th.col-agent a:hover { color: var(--accent); }
    table.cmp thead th .repo { display: block; font-size: 11px; color: var(--muted); font-weight: 400; margin-top: 2px; }
    table.cmp .metric { color: var(--muted); font-size: 13px; font-weight: 400; text-align: left; }
    /* Coverage grade: outlined chip so it can't be confused with the filled evidence-grade pill */
    .cov-badge { background: none; color: var(--muted); border: 1px solid var(--border); }
    table.cmp td.val { font-family: var(--font-mono); }
    table.cmp td.lead { font-weight: 700; color: var(--accent); }
    table.cmp td.lead::after { content: " \2713"; font-size: 11px; }
    .dim-head td { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); padding-top: 18px; border-bottom: none; }
    .cmp-actions { display: flex; gap: 10px; flex-wrap: wrap; margin: 22px 0; }
    .cmp-actions a { font-family: var(--font-mono); font-size: 13px; padding: 9px 14px; border: 1px solid var(--border); color: var(--text); }
    .cmp-actions a.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .cmp-actions a:hover { border-color: var(--accent); text-decoration: none; }
    .cmp-note { font-size: 13px; color: var(--muted); line-height: 1.6; padding: 14px 0; border-top: 1px solid var(--border); }
    /* Decision view (plan 2.4): verdict, a "choose this if" card per side,
       then bars for only the dimensions that differ. */
    .dv-verdict { margin: 16px 0 18px; font-size: 17px; line-height: 1.55; font-weight: 500; max-width: 760px; }
    .dv-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .dv-card { border: 1px solid var(--border); background: var(--surface); border-radius: 10px; padding: 16px; min-width: 0; }
    .dv-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .dv-head a { font-size: 18px; font-weight: 700; color: var(--text); }
    .dv-score { margin-left: auto; font-family: var(--font-mono); font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .dv-meta { font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); margin-top: 4px; line-height: 1.5; }
    .dv-choose { margin: 12px 0 8px; font-size: 14.5px; font-weight: 600; }
    .dv-choose.is-none { font-weight: 400; color: var(--muted); }
    .dv-points { list-style: none; display: grid; gap: 7px; }
    .dv-points li { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 8px; font-size: 13.5px; line-height: 1.45; }
    .dv-delta { font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--accent); white-space: nowrap; }
    .dv-diff { margin: 26px 0 8px; }
    .dv-diff h2, .dv-evidence-title { font-size: 15px; font-weight: 600; margin-bottom: 10px; }
    .dv-cols, .dv-row { display: grid; grid-template-columns: 64px minmax(0, 1fr) 64px; gap: 12px; align-items: center; }
    .dv-cols { font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); padding-bottom: 6px; border-bottom: 1px solid var(--border); }
    .dv-cols span:last-child, .dv-row .dv-b { text-align: right; }
    .dv-row { padding: 9px 0; border-bottom: 1px solid var(--border); }
    .dv-row .dv-a, .dv-row .dv-b { font-family: var(--font-mono); font-size: 14px; font-variant-numeric: tabular-nums; }
    .dv-row .is-lead { font-weight: 700; color: var(--accent); }
    .dv-mid { min-width: 0; }
    .dv-label { display: flex; justify-content: space-between; gap: 8px; font-size: 12.5px; color: var(--muted); margin-bottom: 5px; }
    .dv-label b { font-family: var(--font-mono); font-size: 11.5px; color: var(--accent); white-space: nowrap; }
    .dv-track { position: relative; height: 8px; background: var(--border); border-radius: 4px; }
    .dv-track::after { content: ""; position: absolute; left: 50%; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; background: var(--text); }
    .dv-fill { position: absolute; top: 0; bottom: 0; background: var(--accent); }
    .dv-fill.to-a { right: 50%; border-radius: 4px 0 0 4px; }
    .dv-fill.to-b { left: 50%; border-radius: 0 4px 4px 0; }
    .dv-same { font-size: 13px; color: var(--muted); padding: 10px 0; }
    .dv-same a { color: var(--accent); }
    .dv-how { color: var(--muted); font-size: 14px; line-height: 1.6; margin: 24px 0 12px; max-width: 760px; }
    @media (max-width: 640px) {
      .cmp-hero h1 { font-size: 23px; } table.cmp { font-size: 13px; }
      .dv-cards { grid-template-columns: 1fr; }
      .dv-cols, .dv-row { grid-template-columns: 48px minmax(0, 1fr) 48px; gap: 8px; }
    }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://hvtracker.net/compare/" },
      { "@type": "ListItem", "position": 3, "name": "{{ a.name }} vs {{ b.name }}" }
    ]
  }
  </script>
  {#- The compared pair itself. Without this the page carried only breadcrumbs,
      so the two projects and their scores existed for search engines as prose
      only. Editorial Review authored by HVTracker, mirroring the agent pages —
      deliberately no aggregateRating, which would require real user ratings.
      Unordered: pairs render in both directions, so neither slot is "first". -#}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ (a.name ~ " vs " ~ b.name ~ " — AI agent trust comparison") | tojson }},
    "itemListOrder": "https://schema.org/ItemListUnordered",
    "numberOfItems": 2,
    "itemListElement": [
      {%- for r in [a, b] %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "item": {
          "@type": "SoftwareApplication",
          "name": {{ r.name | tojson }},
          "applicationCategory": {{ r.category | tojson }},
          "operatingSystem": "Cross-platform",
          "url": {{ r.url | tojson }},
          {% if r.description %}"description": {{ r.description | tojson }},{% endif %}
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
          {%- if r.trust_score is not none %},
          "review": {
            "@type": "Review",
            "author": { "@type": "Organization", "name": "HVTracker", "url": "https://hvtracker.net/" },
            "url": "https://hvtracker.net/agents/{{ r.slug }}/",
            "reviewBody": {{ ("Evidence-based trust review of " ~ r.name ~ ": HVTrust " ~ r.trust_score ~ "/100 (Grade " ~ r.evidence_grade ~ "), ranked #" ~ r.rank ~ " of " ~ total ~ " tracked open-source AI agent projects, from public supply-chain, transparency, maintenance, and adoption signals.") | tojson }},
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": {{ r.trust_score }},
              "bestRating": 100,
              "worstRating": 0
            }
          }
          {%- endif %}
        }
      }{{ "," if not loop.last }}
      {%- endfor %}
    ]
  }
  </script>
  <script>
    (function(){var host=window.location.hostname||"";if(/^(localhost|127(?:\.\d{1,3}){3}|0(?:\.\d{1,3}){3}|::1)$/i.test(host)){window["ga-disable-G-TZ8921LR0K"]=true;return}try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
</head>
<body data-page-type="compare_pair">
  {% include "_site_header.html.j2" %}
  <main class="page" id="main">
    <div class="cmp-crumb"><a href="/">Registry</a> &rsaquo; <a href="/compare/">Compare</a> &rsaquo; {{ a.name }} vs {{ b.name }}</div>
    {% set intro %}An independent, evidence-based trust comparison of {{ a.name }} and {{ b.name }}, two {{ category.name }} projects in the HVTracker registry. Scores come from public, checkable signals — supply-chain provenance, OSSF Scorecard, maintenance, and adoption — not popularity.{% endset %}
    {% if decision %}
    <div class="cmp-hero" style="border-bottom:none;padding-bottom:0">
      <h1>{{ a.name }} vs {{ b.name }}</h1>
      <p class="dv-verdict">{{ decision.verdict }}{% if coverage_caveat %} {{ coverage_caveat }}{% endif %}</p>
    </div>

    <div class="dv-cards">
      {% for s in decision.sides %}{% set r = s.row %}
      <section class="dv-card" aria-label="{{ r.name }}">
        <div class="dv-head">
          <span class="badge grade-{{ r.evidence_grade }}">{{ r.evidence_grade }}</span>
          <a href="/agents/{{ r.slug }}/">{{ r.name }}</a>
          <span class="dv-score">{{ r.trust_score }}</span>
        </div>
        <p class="dv-meta">{{ r.repo }} · #{{ r.rank }} overall{% if r.category_rank %} · #{{ r.category_rank }} {{ category.name }}{% endif %}{% if r.coverage_grade %} · coverage {{ r.coverage_grade }} ({{ r.signal_types }}/5){% endif %}</p>
        {% if s.choose_if %}
        <p class="dv-choose">{{ s.choose_if }}</p>
        <ul class="dv-points">
          {% for p in s.points %}<li><span class="dv-delta">{{ p.delta }}</span><span>{{ p.text }}</span></li>{% endfor %}
        </ul>
        {% else %}
        <p class="dv-choose is-none">{{ r.name }} doesn't lead on any scored dimension in this pair.</p>
        {% endif %}
      </section>
      {% endfor %}
    </div>

    {% if decision.diffs %}
    <section class="dv-diff">
      <h2>Where they differ</h2>
      <div class="dv-cols" aria-hidden="true"><span>{{ a.name }}</span><span></span><span>{{ b.name }}</span></div>
      {% for d in decision.diffs %}
      <div class="dv-row">
        <span class="dv-a{% if d.lead == 'a' %} is-lead{% endif %}">{{ d.a }}</span>
        <div class="dv-mid">
          <div class="dv-label"><span>{{ d.label }}</span><b>{{ (a if d.lead == 'a' else b).name }} {{ d.delta }}</b></div>
          <div class="dv-track" aria-hidden="true"><i class="dv-fill to-{{ d.lead }}" style="width:{{ d.pct / 2 }}%"></i></div>
        </div>
        <span class="dv-b{% if d.lead == 'b' %} is-lead{% endif %}">{{ d.b }}</span>
      </div>
      {% endfor %}
      <p class="dv-same">{% if decision.same %}{{ decision.same | length }} dimension{{ "s" if decision.same | length > 1 }} identical: {% for x in decision.same %}{{ x.label }} {{ x.value }}{{ " · " if not loop.last }}{% endfor %} · {% endif %}<a href="#evidence">Full evidence table</a></p>
    </section>
    {% endif %}

    <p class="dv-how">{{ intro }}</p>
    <h2 class="dv-evidence-title" id="evidence">Full evidence</h2>
    {% else %}
    <div class="cmp-hero">
      <h1>{{ a.name }} vs {{ b.name }}</h1>
      <p>{{ intro }}</p>
    </div>

    <div class="cmp-verdict">
      {% if lead_name %}<strong>{{ lead_name }}</strong> leads on trust — {{ lead_score }}/100 (Grade {{ lead_grade }}) vs {{ trail_score }}/100 (Grade {{ trail_grade }}), a {{ gap }}-point gap.{% else %}{{ a.name }} and {{ b.name }} are tied on HVTrust at {{ a.trust_score }}/100.{% endif %}{% if coverage_caveat %} {{ coverage_caveat }}{% endif %} Full breakdown below.
    </div>
    {% endif %}

    <table class="cmp">
      <thead>
        <tr>
          <th>Signal</th>
          <th class="col-agent"><a href="/agents/{{ a.slug }}/">{{ a.name }}</a><span class="repo">{{ a.repo }}</span></th>
          <th class="col-agent"><a href="/agents/{{ b.slug }}/">{{ b.name }}</a><span class="repo">{{ b.repo }}</span></th>
        </tr>
      </thead>
      <tbody>
        {% for m in metrics %}
        <tr>
          <th scope="row" class="metric">{{ m.label }}</th>
          {% if m.grade %}
          <td class="val{% if m.lead == 'a' %} lead{% endif %}"><span class="badge grade-{{ a.evidence_grade }}">{{ a.evidence_grade }}</span></td>
          <td class="val{% if m.lead == 'b' %} lead{% endif %}"><span class="badge grade-{{ b.evidence_grade }}">{{ b.evidence_grade }}</span></td>
          {% elif m.cov %}
          <td class="val{% if m.lead == 'a' %} lead{% endif %}">{% if a.coverage_grade %}<span class="badge cov-badge" title="Evidence coverage — how many independent public signal types verify this agent">{{ a.coverage_grade }}</span>{% else %}—{% endif %}</td>
          <td class="val{% if m.lead == 'b' %} lead{% endif %}">{% if b.coverage_grade %}<span class="badge cov-badge" title="Evidence coverage — how many independent public signal types verify this agent">{{ b.coverage_grade }}</span>{% else %}—{% endif %}</td>
          {% else %}
          <td class="val{% if m.lead == 'a' %} lead{% endif %}">{{ m.a }}</td>
          <td class="val{% if m.lead == 'b' %} lead{% endif %}">{{ m.b }}</td>
          {% endif %}
        </tr>
        {% endfor %}
        <tr class="dim-head"><td colspan="3">Trust dimensions (points earned)</td></tr>
        {% for d in dims %}
        <tr>
          <td class="metric">{{ d.label }} <span style="color:var(--muted);font-family:var(--font-mono);font-size:11px">/ {{ d.max }}</span></td>
          <td class="val{% if d.lead == 'a' %} lead{% endif %}">{{ d.a }}</td>
          <td class="val{% if d.lead == 'b' %} lead{% endif %}">{{ d.b }}</td>
        </tr>
        {% endfor %}
        <tr class="dim-head"><td colspan="3">Runtime capability surface (<a href="/capabilities/" style="color:var(--muted)">full matrix</a>)</td></tr>
        {% for c in caps %}
        <tr>
          <td class="metric">{{ c.label }}</td>
          <td class="val{% if c.lead == 'a' %} lead{% endif %}">{{ c.a }}</td>
          <td class="val{% if c.lead == 'b' %} lead{% endif %}">{{ c.b }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="cmp-actions">
      <a class="primary" href="/compare/?a={{ a.slug }},{{ b.slug }}">Open in the live compare tool &rarr;</a>
      <a href="/agents/{{ a.slug }}/">{{ a.name }} profile</a>
      <a href="/agents/{{ b.slug }}/">{{ b.name }} profile</a>
      <a href="/?cat={{ category.slug }}">More {{ category.name }} &rarr;</a>
    </div>

    <p class="cmp-note">How to read this: HVTrust (0–100) weighs supply-chain signals (provenance, OSSF Scorecard, signed commits, open license) alongside real-world adoption, scaled by an evidence-confidence factor. Grade bands: A ≥ 80, B ≥ 65, C ≥ 50, D &lt; 50. Signals refresh daily. <a href="/methodology/" style="color:var(--accent)">Full methodology {{ methodology_version }} &rarr;</a></p>

    <footer>
      <a href="/">Registry</a> · <a href="/compare/">Compare</a> · <a href="/methodology/">Methodology</a> · Updated {{ updated }}
    </footer>
  </main>
</body>
</html>
