<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ row.name }} Review — Trust Score & Safety Profile | HVTracker</title>
  <meta name="description" content="Is {{ row.name }} safe? Independent trust score {{ row.trust_score }}/100 (Grade {{ row.evidence_grade }}). Ranked #{{ row.rank }} of {{ total }} open-source AI agents. {{ row.stars_fmt }} GitHub stars, {{ row.category }}. Security, transparency & adoption signals reviewed.">
  <link rel="canonical" href="https://hvtracker.net/agents/{{ row.slug }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ row.name }} — Trust Score {{ row.trust_score }}/100 | HVTracker">
  <meta property="og:description" content="Grade {{ row.evidence_grade }} · HVTrust {{ row.trust_score }}/100 · {{ row.stars_fmt }} stars · {{ row.category }}. Independent trust signals for AI agents.">
  <meta property="og:url" content="https://hvtracker.net/agents/{{ row.slug }}">
  <meta property="og:image" content="https://hvtracker.net/agents/{{ row.slug }}/og.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ row.name }} — Trust Score {{ row.trust_score }}/100 on HVTracker">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://hvtracker.net/agents/{{ row.slug }}/og.png">
  <meta name="twitter:image:alt" content="{{ row.name }} on HVTracker">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "{{ row.name }}",
    "applicationCategory": "{{ row.category }}",
    "operatingSystem": "Cross-platform",
    "url": "{{ row.url }}",
    {% if row.description %}"description": "{{ row.description }}",{% endif %}
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ row.trust_score }}",
      "bestRating": "100",
      "worstRating": "0",
      "ratingCount": "{{ row.stars }}"
    },
    "review": {
      "@type": "Review",
      "author": {
        "@type": "Organization",
        "name": "HVTracker",
        "url": "https://hvtracker.net"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "{{ row.trust_score }}",
        "bestRating": "100",
        "worstRating": "0"
      },
      "reviewBody": "{{ row.name }} receives a trust score of {{ row.trust_score }}/100 (Grade {{ row.evidence_grade }}) based on independent analysis of activity, adoption, transparency, safety, and identity signals."
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "{{ row.category }}", "item": "https://hvtracker.net/categories/{{ row.category | lower | replace(' ', '-') | replace('/', '-') | replace('&', '') }}" },
      { "@type": "ListItem", "position": 3, "name": "{{ row.name }}" }
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is {{ row.name }} safe to use?",
        "acceptedAnswer": { "@type": "Answer", "text": "{{ row.name }} has an HVTrust score of {{ row.trust_score }}/100 (Grade {{ row.evidence_grade }}), ranked #{{ row.rank }} of {{ total }} AI agents. This score reflects verifiable supply-chain integrity, transparency, maintenance, and adoption signals." }
      },
      {
        "@type": "Question",
        "name": "What is the trust score for {{ row.name }}?",
        "acceptedAnswer": { "@type": "Answer", "text": "{{ row.name }} scores {{ row.trust_score }}/100 on HVTracker's evidence-weighted HVTrust scale. It has {{ row.stars_fmt }} GitHub stars and is categorized under {{ row.category }}." }
      }
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:#0b0d10; --surface:rgba(21,25,32,0.78); --surface-2:rgba(27,32,41,0.82); --border:rgba(142,154,176,0.22);
      --hairline:rgba(168,179,194,0.12); --glass:rgba(21,25,32,0.72); --glass-hi:rgba(255,255,255,0.055);
      --metal:linear-gradient(135deg, rgba(255,255,255,0.10), rgba(255,255,255,0.018) 34%, rgba(45,212,191,0.045) 72%, rgba(216,166,87,0.055));
      --text:#eef2f6; --muted:#a8b3c2;
      --accent:#8fb3ff; --accent-lt:rgba(143,179,255,0.10); --accent-dim:#5677aa;
      --mocha:#d8a657; --mocha-lt:rgba(216,166,87,0.16);
      --fresh:#2dd4bf; --recent:#9ae6b4; --aging:#d8a657; --stale:#737f91;
      --score-hi-bg:rgba(45,212,191,0.16); --score-hi-fg:#5eead4;
      --score-mid-bg:rgba(216,166,87,0.16); --score-mid-fg:#d8a657;
      --score-lo-bg:rgba(100,100,120,0.12); --score-lo-fg:#737f91;
      --font-mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,monospace;
      --font-sans:"Hanken Grotesk",system-ui,-apple-system,sans-serif;
    }
    body { background-color:var(--bg); color:var(--text); font-family:var(--font-sans); font-size:14px; line-height:1.55; min-height:100vh;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E"), radial-gradient(circle at 18% -10%, rgba(45,212,191,0.14), transparent 30%), radial-gradient(circle at 86% 6%, rgba(216,166,87,0.12), transparent 26%), linear-gradient(135deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 11px), linear-gradient(180deg, #10141a 0%, var(--bg) 54%, #07090c 100%);
      background-repeat:repeat, no-repeat, no-repeat, repeat, no-repeat; background-size:256px 256px, auto, auto, auto, auto;
    }
    a { color:inherit; text-decoration:none; }
    a:hover { text-decoration:underline; }
    .page { max-width:820px; margin:0 auto; padding:24px 20px 0; }

    header {
      padding:16px 18px; border:1px solid var(--border); border-radius:10px;
      background:var(--metal), var(--glass);
      box-shadow:inset 0 1px 0 var(--glass-hi), 0 18px 54px rgba(0,0,0,0.28);
      backdrop-filter:blur(18px) saturate(120%);
      display:flex; align-items:baseline; gap:14px; flex-wrap:wrap; position:relative;
    }
    .logo { font-family:var(--font-mono); font-size:18px; font-weight:700; letter-spacing:-0.5px; }
    .logo span { color:var(--accent); }
    .back { font-family:var(--font-mono); font-size:11px; color:var(--muted); margin-left:auto; }
    .back:hover { color:var(--accent); }

    .hero,
    .rank-block {
      border:1px solid var(--border);
      border-radius:10px;
      background:linear-gradient(135deg, rgba(255,255,255,0.052), rgba(255,255,255,0.014)), var(--glass);
      box-shadow:inset 0 1px 0 var(--glass-hi);
      position:relative;
    }
    .hero { padding:24px 20px; margin:14px 0; border-bottom:1px solid var(--border); }
    h1 { font-size:32px; font-weight:700; letter-spacing:-0.5px; margin-bottom:6px; }
    .hero .repo {
      font-family:var(--font-mono); font-size:12px; color:var(--muted);
    }
    .hero .repo a:hover { color:var(--accent); }
    .hero .desc {
      margin-top:14px; font-size:14.5px; color:var(--text); max-width:640px;
    }
    .hero .badges { margin-top:14px; display:flex; gap:6px; flex-wrap:wrap; }
    .hero-actions { margin-top:16px; display:flex; gap:10px; flex-wrap:wrap; }
    .badge {
      display:inline-block; font-family:var(--font-mono); font-size:10.5px;
      padding:2px 8px; border-radius:3px; background:var(--surface-2); color:var(--muted);
    }
    .badge.lang { background:var(--mocha-lt); color:var(--mocha); }
    .badge.cat { background:var(--accent-lt); color:var(--accent); }

    .rank-block {
      padding:20px; margin:14px 0; border-bottom:1px solid var(--border);
      display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:20px; align-items:end;
    }
    .rank-big {
      font-family:var(--font-mono); font-size:54px; font-weight:700; line-height:1;
      text-shadow:0 0 24px rgba(45,212,191,0.16);
      color:var(--accent); letter-spacing:-2px;
    }
    .rank-label { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:0.06em; margin-top:6px; }
    .rank-label a { color:var(--mocha); text-decoration:none; border-bottom:1px solid rgba(216,166,87,0.48); }
    .rank-label a:hover { color:var(--text); border-color:var(--mocha); }
    .rank-sub { font-family:var(--font-mono); font-size:13px; color:var(--muted); }
    .score-pill {
      display:inline-block; font-family:var(--font-mono); font-size:22px; font-weight:700;
      padding:6px 18px; border-radius:6px; margin-bottom:4px;
    }
    .score-high { background:var(--score-hi-bg); color:var(--score-hi-fg); }
    .score-mid  { background:var(--score-mid-bg); color:var(--score-mid-fg); }
    .score-low  { background:var(--score-lo-bg); color:var(--score-lo-fg); }

    .stats { padding:22px 0; margin:0; border-top:1px solid var(--hairline); }
    .stats-grid {
      display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr));
      gap:18px 24px;
    }
    .stat-label {
      font-family:var(--font-mono); font-size:10.5px; color:var(--muted);
      text-transform:uppercase; letter-spacing:0.06em; margin-bottom:4px;
    }
    .stat-value { font-family:var(--font-mono); font-size:18px; font-weight:600; }
    .stat-sub { font-size:11px; color:var(--muted); margin-top:2px; }
    .fresh-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:5px; vertical-align:middle; }
    .fresh  .fresh-dot { background:var(--fresh); }  .fresh  .stat-value { color:var(--fresh); }
    .recent .fresh-dot { background:var(--recent); } .recent .stat-value { color:var(--recent); }
    .aging  .fresh-dot { background:var(--aging); }  .aging  .stat-value { color:var(--aging); }
    .stale  .fresh-dot { background:var(--stale); }  .stale  .stat-value { color:var(--stale); }

    .analysis { padding:24px 0; margin:0; border-top:1px solid var(--hairline); }
    .section-title { font-size:13px; font-weight:600; color:var(--text); margin-bottom:14px; }
    .analysis-panel { display:grid; gap:14px; }
    .analysis-card {
      border:1px solid var(--border);
      border-radius:12px;
      background:
        radial-gradient(circle at 18% 0%, rgba(143,179,255,0.10), transparent 30%),
        linear-gradient(135deg, rgba(255,255,255,0.055), rgba(255,255,255,0.014)),
        rgba(255,255,255,0.028);
      box-shadow:inset 0 1px 0 var(--glass-hi);
      padding:16px;
    }
    .analysis-card-head {
      display:flex; align-items:baseline; justify-content:space-between; gap:12px;
      margin-bottom:12px;
    }
    .analysis-card-title {
      font-size:13px; font-weight:700; color:var(--text);
    }
    .analysis-score {
      font-family:var(--font-mono); font-size:11px; color:var(--muted);
      padding:4px 8px; border:1px solid var(--hairline); border-radius:999px;
      background:rgba(255,255,255,0.035); white-space:nowrap;
    }
    .metric-section + .metric-section {
      margin-top:18px;
      padding-top:16px;
      border-top:1px solid var(--hairline);
    }
    .metric-section-title {
      display:flex; align-items:baseline; justify-content:space-between; gap:12px;
      margin-bottom:10px;
    }
    .metric-section-title h3 { font-size:13px; color:var(--text); }
    .metric-section-title span {
      font-family:var(--font-mono); font-size:11px; color:var(--muted);
      white-space:nowrap;
    }
    .metric-list { display:grid; gap:9px; }
    .metric-row {
      display:grid; grid-template-columns:168px minmax(180px, 1fr) 92px;
      gap:14px; align-items:center;
      min-height:34px;
      font-family:var(--font-mono);
    }
    .metric-name {
      color:var(--muted); font-size:11px; line-height:1.35;
      min-width:0;
    }
    .metric-name strong {
      display:block; color:var(--text); font-size:12px;
      overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    .metric-sub { color:var(--stale); font-size:10px; }
    .metric-track {
      position:relative; height:8px; border-radius:999px; overflow:hidden;
      background:rgba(255,255,255,0.075);
      box-shadow:inset 0 1px 2px rgba(0,0,0,0.30);
    }
    .metric-fill {
      height:100%; width:var(--fill);
      border-radius:999px;
      background:var(--bar, var(--accent));
    }
    .metric-value {
      color:var(--text); text-align:right; font-size:12px; font-weight:700;
      white-space:nowrap;
    }
    .metric-value span { color:var(--muted); font-weight:500; }

    .trend { padding:18px 0; margin:0; border-top:1px solid var(--hairline); }
    .sparkline-wrap { margin-top:10px; }
    .sparkline-labels {
      display:flex; justify-content:space-between;
      font-family:var(--font-mono); font-size:10px; color:var(--muted);
      margin-top:4px;
    }
    .insight-chart { width:100%; height:auto; display:block; overflow:visible; margin:8px 0 14px; }
    .chart-legend {
      display:flex; gap:10px; flex-wrap:wrap;
      font:11px var(--font-mono); color:var(--muted);
    }
    .chart-legend span { display:inline-flex; align-items:center; gap:5px; }
    .chart-legend i { display:inline-block; width:9px; height:9px; border-radius:3px; }
    .chart-legend strong { color:var(--text); font-weight:600; }

    .provenance { padding:22px 0; margin:0; border-top:1px solid var(--hairline); }
    .prov-grid {
      display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));
      gap:14px 24px;
    }
    .prov-signal { padding:10px 12px; border:1px solid var(--border); border-radius:6px; background:rgba(255,255,255,0.035); }
    .prov-label {
      font-family:var(--font-mono); font-size:10.5px; color:var(--muted);
      text-transform:uppercase; letter-spacing:0.06em; margin-bottom:6px;
    }
    .prov-value { font-family:var(--font-mono); font-size:16px; font-weight:600; }
    .prov-yes { color:var(--fresh); }
    .prov-no { color:var(--stale); }
    .prov-sub { font-size:11px; color:var(--muted); margin-top:3px; }
    .sc-checks {
      margin-top:10px; display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));
      gap:6px 16px; font-family:var(--font-mono); font-size:11px;
    }
    .sc-check { display:flex; justify-content:space-between; padding:3px 0; border-bottom:1px solid var(--hairline); }
    .sc-check-name { color:var(--muted); }
    .sc-check-val { font-weight:600; }

    .links {
      padding:6px 0 8px; display:flex; gap:10px; flex-wrap:wrap;
      font-family:var(--font-mono); font-size:12px;
    }
    .links a {
      padding:6px 12px; border:1px solid var(--border); border-radius:4px;
      color:var(--muted);
    }
    .links a:hover { color:var(--accent); border-color:var(--accent-dim); text-decoration:none; }
    .compare-link {
      display:inline-flex; align-items:center; justify-content:center;
      padding:8px 14px; border:1px solid var(--accent);
      border-radius:6px; background:rgba(143,179,255,0.16);
      color:var(--text);
      font-family:var(--font-mono); font-size:12px;
      border-color:var(--accent);
      font-weight:700;
    }
    .compare-link:hover {
      color:var(--text);
      border-color:var(--accent);
      background:rgba(143,179,255,0.26);
      text-decoration:none;
    }
    .secondary-link {
      display:inline-flex; align-items:center; justify-content:center;
      padding:8px 14px; border:1px solid var(--border);
      border-radius:6px; background:rgba(255,255,255,0.035);
      color:var(--muted);
      font-family:var(--font-mono); font-size:12px;
    }
    .secondary-link:hover {
      color:var(--text);
      border-color:var(--accent-dim);
      text-decoration:none;
      background:rgba(143,179,255,0.10);
    }
    .watch-button.is-saved {
      color:var(--text);
      border-color:rgba(45,212,191,0.45);
      background:rgba(45,212,191,0.14);
    }
    .review-card {
      padding:18px 20px; margin:14px 0;
      border:1px solid var(--border); border-radius:10px;
      background:linear-gradient(135deg, rgba(45,212,191,0.07), rgba(143,179,255,0.045) 44%, rgba(216,166,87,0.04)), var(--glass);
      box-shadow:inset 0 1px 0 var(--glass-hi);
    }
    .review-grid {
      display:grid; grid-template-columns:1.2fr 1fr 1fr;
      gap:12px;
    }
    .review-item {
      border:1px solid var(--hairline);
      border-radius:8px;
      padding:12px;
      background:rgba(255,255,255,0.032);
    }
    .review-item.primary { grid-row:span 2; }
    .review-item.wide { grid-column:span 2; }
    .review-kicker {
      font-family:var(--font-mono); font-size:10px; color:var(--muted);
      text-transform:uppercase; letter-spacing:0.07em; margin-bottom:7px;
    }
    .review-value { font-size:15px; color:var(--text); line-height:1.45; }
    .review-metric { font-family:var(--font-mono); font-size:18px; font-weight:700; color:var(--accent); margin-top:4px; }
    .review-actions {
      margin-top:14px; display:flex; flex-wrap:wrap; gap:10px;
      font-family:var(--font-mono); font-size:12px;
    }

    .how-to-read {
      margin:10px 0 0; padding:10px 14px; font-size:12px;
      border:1px dashed var(--hairline); border-radius:6px;
      background:rgba(255,255,255,0.025); color:var(--muted); line-height:1.6;
    }
    .how-to-read strong { color:var(--text); font-weight:600; }
    .how-to-read a { color:var(--accent); border-bottom:1px dotted var(--accent-dim); }
    .how-to-read a:hover { text-decoration:none; border-bottom-color:var(--accent); }

    .freshness-banner {
      margin:14px 0 0; padding:10px 14px; font-family:var(--font-mono); font-size:11.5px;
      border:1px solid var(--hairline); border-radius:6px; color:var(--muted);
      display:flex; gap:10px; align-items:center; flex-wrap:wrap;
    }
    .freshness-banner.is-stale { border-color:rgba(216,166,87,0.55); background:rgba(216,166,87,0.06); color:var(--text); }
    .freshness-banner .dot { width:8px; height:8px; border-radius:50%; background:var(--fresh); }
    .freshness-banner.is-stale .dot { background:var(--aging); }
    .freshness-banner .meta { color:var(--muted); }

    .safety-qa { padding:22px 0; margin:0; border-top:1px solid var(--hairline); }
    .safety-qa .qa-summary {
      padding:12px 14px; margin-bottom:18px;
      border-left:3px solid var(--accent); background:var(--accent-lt);
      border-radius:0 6px 6px 0; font-size:14px; line-height:1.6; color:var(--text);
    }
    .safety-qa details {
      padding:10px 0; border-bottom:1px solid var(--hairline);
    }
    .safety-qa details:last-of-type { border-bottom:none; }
    .safety-qa summary {
      cursor:pointer; font-size:14px; font-weight:600; color:var(--text);
      padding:6px 0; list-style:none;
    }
    .safety-qa summary::-webkit-details-marker { display:none; }
    .safety-qa summary::before { content:"+ "; color:var(--accent); font-family:var(--font-mono); font-weight:700; }
    .safety-qa details[open] summary::before { content:"− "; }
    .safety-qa .qa-answer { padding:6px 0 4px 14px; font-size:13.5px; color:var(--muted); line-height:1.7; }
    .safety-qa .qa-disclaimer {
      margin-top:14px; padding:10px 12px; font-size:11px; color:var(--muted);
      border:1px solid var(--hairline); border-radius:6px;
      background:rgba(255,255,255,0.025);
    }

    .compare-strip { padding:22px 0; margin:0; border-top:1px solid var(--hairline); }
    .compare-strip .cmp-row { display:flex; gap:10px; flex-wrap:wrap; }
    .compare-strip .cmp-link {
      flex:1 1 220px; padding:12px 14px;
      border:1px solid var(--accent); border-radius:8px;
      background:rgba(143,179,255,0.10);
      font-family:var(--font-mono); font-size:13px;
      display:flex; justify-content:space-between; align-items:center; gap:10px;
    }
    .compare-strip .cmp-link:hover {
      text-decoration:none; background:rgba(143,179,255,0.20);
      border-color:var(--accent); color:var(--text);
    }
    .compare-strip .cmp-name { color:var(--text); font-weight:600; }
    .compare-strip .cmp-arrow { color:var(--accent); font-weight:700; }

    .runtime-soon { padding:22px 0; margin:0; border-top:1px solid var(--hairline); }
    .runtime-soon .rt-card {
      padding:14px 16px; border:1px dashed var(--accent-dim); border-radius:8px;
      background:rgba(143,179,255,0.04); color:var(--muted); font-size:13.5px; line-height:1.6;
    }
    .runtime-soon .rt-card strong { color:var(--text); font-weight:600; }
    .runtime-soon .rt-fields {
      margin-top:10px; display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:8px 14px;
      font-family:var(--font-mono); font-size:11.5px;
    }
    .runtime-soon .rt-fields li {
      list-style:none; padding:6px 10px; border:1px solid var(--hairline);
      border-radius:4px; color:var(--muted); background:rgba(255,255,255,0.02);
    }
    .runtime-soon .rt-fields li::before { content:"◯ "; color:var(--accent-dim); }

    .maintainer-cta {
      padding:18px 20px; margin:14px 0;
      border:1px solid var(--mocha); border-radius:10px;
      background:linear-gradient(135deg, rgba(216,166,87,0.12), rgba(216,166,87,0.03)), var(--glass);
      box-shadow:inset 0 1px 0 var(--glass-hi);
    }
    .maintainer-cta .section-title { margin-bottom:8px; }
    .maintainer-cta p {
      font-size:13.5px; color:var(--muted); line-height:1.6; max-width:560px; margin-bottom:14px;
    }
    .maintainer-cta p strong { color:var(--text); }
    .maintainer-actions { display:flex; gap:10px; flex-wrap:wrap; font-family:var(--font-mono); font-size:12px; }
    .cta-correction {
      display:inline-flex; align-items:center; justify-content:center;
      padding:9px 16px; border:1px solid var(--mocha); border-radius:6px;
      background:var(--mocha-lt); color:var(--mocha); font-weight:700;
    }
    .cta-correction:hover {
      background:rgba(216,166,87,0.28); color:var(--text);
      border-color:var(--mocha); text-decoration:none;
    }

    .siblings { padding:22px 0; margin:0; border-top:1px solid var(--hairline); }
    .siblings ul { list-style:none; display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:10px 18px; }
    .siblings li a {
      display:flex; align-items:baseline; gap:8px;
      padding:8px 10px; border:1px solid var(--border); border-radius:4px;
      background:rgba(255,255,255,0.035); transition:all 0.15s;
    }
    .siblings li a:hover { border-color:var(--accent-dim); background:var(--surface-2); text-decoration:none; }
    .siblings .sib-rank {
      font-family:var(--font-mono); font-size:10.5px; color:var(--muted);
      min-width:28px; text-align:right;
    }
    .siblings .sib-name { flex:1; font-weight:500; font-size:13px; color:var(--text); }
    .siblings .sib-score { font-family:var(--font-mono); font-size:11px; color:var(--accent); }

    footer {
      padding:24px 0 40px; border-top:0;
      font-size:12px; color:var(--muted);
      display:flex; gap:14px; flex-wrap:wrap; align-items:center;
    }
    footer a { color:var(--accent); }
    .footer-sep { color:var(--border); }
    .terminal-note { margin:0; border-top:1px solid var(--hairline); }
    @media (max-width:720px) {
      .rank-block { grid-template-columns:repeat(2, minmax(0, 1fr)); }
      .review-grid { grid-template-columns:1fr; }
      .review-item.primary { grid-row:auto; }
      .review-item.wide { grid-column:auto; }
      .analysis-card-head { align-items:flex-start; flex-direction:column; gap:8px; }
      .metric-section-title { align-items:flex-start; flex-direction:column; gap:4px; }
      .metric-row { grid-template-columns:1fr; gap:6px; padding:8px 0; }
      .metric-value { text-align:left; }
    }
  </style>

  <!-- Google tag (gtag.js) -->
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "{{ row.category }}", "item": "https://hvtracker.net/categories/{{ row.category_slug }}/" },
      { "@type": "ListItem", "position": 3, "name": "{{ row.name }}", "item": "https://hvtracker.net/agents/{{ row.slug }}/" }
    ]
  }
  </script>
</head>
<body data-page-type="agent_profile" data-agent-slug="{{ row.slug }}" data-agent-name="{{ row.name }}" data-category="{{ row.category }}" data-global-rank="{{ row.rank }}" data-trust-score="{{ row.trust_score }}">
  <div class="page">

    <header>
      <a href="/" class="logo">HV<span>Tracker</span></a>
      <a href="/" class="back">← back to leaderboard</a>
    </header>

    <section class="hero">
      <h1>{{ row.name }}</h1>
      <div class="repo">
        <a href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.repo }}</a>
      </div>
      {% if row.description %}<p class="desc">{{ row.description }}</p>{% endif %}
      <div class="badges">
        {% if row.category %}<a href="/categories/{{ row.category_slug }}" class="badge cat" style="text-decoration:none">{{ row.category }}</a>{% endif %}
        {% if row.language %}<span class="badge lang">{{ row.language }}</span>{% endif %}
        {% if row.evidence_grade %}<span class="badge" style="background:{% if row.evidence_grade == 'A' %}#22c55e{% elif row.evidence_grade == 'B' %}#3b82f6{% elif row.evidence_grade == 'C' %}#d8a657{% else %}#666{% endif %};color:#fff;" title="Grade {{ row.evidence_grade }}: trust score {% if row.evidence_grade == 'A' %}≥ 80{% elif row.evidence_grade == 'B' %}≥ 65{% elif row.evidence_grade == 'C' %}≥ 50{% else %}&lt; 50{% endif %}">Grade {{ row.evidence_grade }}</span>{% endif %}
        {% if row.listing_status %}<span class="badge" style="{% if row.listing_status == 'legacy' %}background:rgba(107,114,128,0.15);color:var(--stale);{% endif %}">{{ row.listing_status }}</span>{% endif %}
        {% if row.license_spdx %}<span class="badge">{{ row.license_spdx }}</span>{% endif %}
        {% if row.license_type and row.license_type != 'open' %}<span class="badge" style="background:{% if row.license_type == 'proprietary' %}rgba(232,121,139,0.25);color:#e8798b{% elif row.license_type == 'source-available' %}rgba(216,166,87,0.25);color:#d8a657{% else %}rgba(142,154,176,0.25);color:#a8b3c2{% endif %}">{{ row.license_type | capitalize }}</span>{% endif %}
      </div>
      <div class="hero-actions">
        <a class="compare-link" href="/compare/?a={{ row.slug }}">Compare</a>
        <button class="secondary-link watch-button" id="watchToggle" type="button" data-watch-slug="{{ row.slug }}" data-watch-name="{{ row.name }}" data-watch-repo="{{ row.repo }}">Save to watchlist</button>
        <a class="secondary-link" id="watchlistCompareLink" href="/compare/">Compare saved agents</a>
        <a class="secondary-link" href="/track/{{ row.slug }}">Track this agent</a>
        <a class="secondary-link" href="{{ row.correction_url }}" target="_blank" rel="noopener noreferrer">Suggest correction</a>
      </div>
      <div class="seo-summary" style="margin-top:18px;font-size:14px;color:var(--muted);line-height:1.7;max-width:640px;">
        <p>{{ row.name }} is an open-source AI agent in the {{ row.category }} category with {{ row.stars_fmt }} GitHub stars{% if row.description %} — {{ row.description }}{% endif %}.
        HVTracker independently evaluates {{ row.name }} with a <strong style="color:var(--text)">Trust Score of {{ row.trust_score }}/100</strong> (Grade {{ row.evidence_grade }}), ranking it <strong style="color:var(--text)">#{{ row.rank }} of {{ total }}</strong> tracked AI agents.
        {% if row.scorecard_score %}It scores {{ row.scorecard_score }}/10 on the OpenSSF Scorecard for supply-chain security.{% endif %}
        {% if row.has_provenance %}Package provenance is verified.{% endif %}
        Signals are refreshed daily from GitHub, package registries, and security databases.</p>
      </div>
    </section>

    <section class="review-card">
      <h2 class="section-title">Quick Trust Read</h2>
      <div class="review-grid">
        <div class="review-item primary">
          <div class="review-kicker">Verdict</div>
          <div class="review-value">{{ row.review_insights.verdict }}</div>
          <div class="review-metric">{{ row.trust_score }}/100 · Grade {{ row.evidence_grade }}</div>
        </div>
{% if row.review_insights.strongest %}
        <div class="review-item">
          <div class="review-kicker">Strongest Signal</div>
          <div class="review-value">{{ row.review_insights.strongest.label }}</div>
          <div class="review-metric">{{ row.review_insights.strongest.value }}/{{ row.review_insights.strongest.max }}</div>
        </div>
{% endif %}
{% if row.review_insights.weakest %}
        <div class="review-item">
          <div class="review-kicker">Weakest Signal</div>
          <div class="review-value">{{ row.review_insights.weakest.label }}</div>
          <div class="review-metric">{{ row.review_insights.weakest.value }}/{{ row.review_insights.weakest.max }}</div>
        </div>
{% endif %}
        <div class="review-item wide">
          <div class="review-kicker">What Would Improve It</div>
          <div class="review-value">{{ row.review_insights.improvement }}</div>
        </div>
      </div>
      <div class="review-actions">
{% if comparisons %}
        <a class="compare-link" href="{{ comparisons[0].url }}">Compare with {{ comparisons[0].name }}</a>
{% else %}
        <a class="compare-link" href="/compare/?a={{ row.slug }}">Compare with another agent</a>
{% endif %}
        <a class="secondary-link" href="/track/{{ row.slug }}">Track {{ row.name }}</a>
        {% if row.category %}<a class="secondary-link" href="/categories/{{ row.category_slug }}">View {{ row.category }}</a>{% endif %}
        <a class="secondary-link" href="{{ row.correction_url }}" target="_blank" rel="noopener noreferrer">Report missing data</a>
      </div>
    </section>

    <section class="rank-block">
      <div>
        <div class="score-pill {{ row.score_class }}">{{ row.score }}</div>
        <div class="rank-label">Activity Score · out of 100</div>
      </div>
      {% if row.trust_score is defined %}
      <div>
        <div class="score-pill" style="background:rgba(45,212,191,0.14);color:{% if row.trust_score >= 55 %}#2dd4bf{% elif row.trust_score >= 30 %}#8fb3ff{% else %}var(--score-lo-fg){% endif %};">{{ row.trust_score }}</div>
        <div class="rank-label">HVTrust Score · out of 100</div>
      </div>
      {% endif %}
      <div>
        <div class="rank-big">#{{ row.rank }}</div>
        <div class="rank-label">Global Rank · of {{ total }}</div>
      </div>
      {% if row.category_rank and row.category %}
      <div>
        <div class="rank-big" style="color:var(--mocha)">#{{ row.category_rank }}</div>
        <div class="rank-label">In <a href="/categories/{{ row.category_slug }}">{{ row.category }}</a></div>
      </div>
      {% endif %}
    </section>

    <p class="how-to-read">
      <strong>How to read this:</strong> HVTrust (0–100) weighs supply-chain signals (provenance, OSSF Scorecard, signed commits, open license) alongside real-world adoption. <strong>Grade {{ row.evidence_grade }}</strong> reflects the trust score band: A ≥ 80, B ≥ 65, C ≥ 50, D &lt; 50. <a href="/methodology">Full methodology →</a>
    </p>

    {% set is_stale = row.days_ago is not none and row.days_ago > 180 %}
    <div class="freshness-banner{% if is_stale %} is-stale{% endif %}">
      <span class="dot"></span>
      <strong>Signals refreshed</strong>
      <span class="meta">{{ updated }}</span>
      <span class="meta">·</span>
      <span class="meta">Repo last pushed {% if row.days_ago == 0 %}today{% elif row.days_ago == 1 %}yesterday{% else %}{{ row.days_ago }} days ago{% endif %}{% if is_stale %} — may be stale{% endif %}</span>
    </div>

    {% if row.sparkline_svg %}
    <section class="trend">
      <h2 class="section-title">Rank Trend</h2>
      <div class="sparkline-wrap">
        {{ row.sparkline_svg | safe }}
        <div class="sparkline-labels">
          {% if row.rank_history %}
          <span>{{ row.rank_history[0].date }}</span>
          <span>{{ row.rank_history[-1].date }}</span>
          {% endif %}
        </div>
      </div>
    </section>
    {% endif %}

    <section class="stats">
      <h2 class="section-title">Activity & Reach</h2>
      <div class="stats-grid">
        <div>
          <div class="stat-label">Stars</div>
          <div class="stat-value">{{ row.stars_fmt }}</div>
        </div>
        <div>
          <div class="stat-label">Forks</div>
          <div class="stat-value">{{ row.forks_fmt }}</div>
        </div>
        <div class="{{ row.freshness_class }}">
          <div class="stat-label">Last Push</div>
          <div class="stat-value"><span class="fresh-dot"></span>{{ row.last_push }}</div>
          <div class="stat-sub">{% if row.days_ago == 0 %}today{% elif row.days_ago == 1 %}yesterday{% else %}{{ row.days_ago }} days ago{% endif %}</div>
        </div>
        <div>
          <div class="stat-label">Commits (4 wk)</div>
          <div class="stat-value">{% if row.weekly_commits is not none %}{{ row.weekly_commits }}{% else %}—{% endif %}{% if row.commits_low_confidence %}<span title="Recent push detected; GitHub's commit stats cache may be stale, so this 4-week count could be temporarily under-reported." style="color:var(--aging);font-size:13px;margin-left:3px;cursor:help;">?</span>{% endif %}</div>
        </div>
        <div>
          <div class="stat-label">Downloads (7d)</div>
          <div class="stat-value">{{ row.downloads_fmt }}</div>
          {% if row.dl_source %}<div class="stat-sub">{{ row.dl_source }}</div>{% endif %}
        </div>
        <div>
          <div class="stat-label">HN mentions (30d)</div>
          <div class="stat-value">{% if row.hn_mentions_30d is not none %}{{ row.hn_mentions_30d }}{% else %}—{% endif %}</div>
        </div>
        <div>
          <div class="stat-label">Open Issues</div>
          <div class="stat-value">{{ row.open_issues }}</div>
        </div>
        <div>
          <div class="stat-label">Rank Change</div>
          <div class="stat-value">{{ row.rank_delta_display }}</div>
          {% if row.previous_rank %}<div class="stat-sub">was #{{ row.previous_rank }}</div>{% endif %}
        </div>
      </div>
    </section>

    {% if row.trust_breakdown is defined %}
    <section class="analysis">
      <h2 class="section-title">Analysis</h2>
      <div class="analysis-panel">
        <div class="analysis-card">
          <div class="metric-section">
            <div class="metric-section-title">
              <h3>HVTrust Dimensions</h3>
              <span>{{ row.trust_score }} / 100{% if row.trust_confidence is defined and row.trust_confidence %} · {{ (row.trust_confidence * 100) | round }}% confidence{% endif %}</span>
            </div>
            <div class="metric-list" aria-label="HVTrust dimensions for {{ row.name }}">
              <div class="metric-row">
                <div class="metric-name"><strong>Safety / Integrity</strong><span class="metric-sub">OSSF, provenance, signatures</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.safety / 25 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.safety }} <span>/ 25</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Identity / Provenance</strong><span class="metric-sub">Listing and build link</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.identity / 18 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.identity }} <span>/ 18</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Transparency</strong><span class="metric-sub">License and public checks</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.transparency / 17 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.transparency }} <span>/ 17</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Maintenance</strong><span class="metric-sub">Freshness and commits</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.maintenance / 20 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.maintenance }} <span>/ 20</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Adoption</strong><span class="metric-sub">Stars and downloads</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.adoption / 20 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.adoption }} <span>/ 20</span></div>
              </div>
            </div>
          </div>
          <div class="metric-section">
            <div class="metric-section-title">
              <h3>Activity Inputs</h3>
              <span>{{ row.score }} / 100</span>
            </div>
            <div class="metric-list" aria-label="Activity inputs for {{ row.name }}">
              <div class="metric-row">
                <div class="metric-name"><strong>Stars</strong><span class="metric-sub">Repository reach</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ row.score_breakdown.stars_pct }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.score_breakdown.stars }} <span>/ 30</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Freshness</strong><span class="metric-sub">Last push recency</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ row.score_breakdown.freshness_pct }}%;--bar:var(--fresh);"></div></div>
                <div class="metric-value">{{ row.score_breakdown.freshness }} <span>/ 25</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Activity</strong><span class="metric-sub">Recent commits</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ row.score_breakdown.activity_pct }}%;--bar:#9ae6b4;"></div></div>
                <div class="metric-value">{{ row.score_breakdown.activity }} <span>/ 25</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Community</strong><span class="metric-sub">Fork signal</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ row.score_breakdown.community_pct }}%;--bar:var(--mocha);"></div></div>
                <div class="metric-value">{{ row.score_breakdown.community }} <span>/ 20</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    <section class="provenance">
      <h2 class="section-title">Supply Chain Trust</h2>
      <div class="prov-grid">
        <div class="prov-signal">
          <div class="prov-label">Package Provenance</div>
          {% if row.has_provenance %}
          <div class="prov-value prov-yes">Verified</div>
          <div class="prov-sub">{{ row.provenance_sources|join(', ') }} attestation</div>
          {% else %}
          <div class="prov-value prov-no">None</div>
          <div class="prov-sub">No package attestations found</div>
          {% endif %}
        </div>
        <div class="prov-signal">
          <div class="prov-label">OSSF Scorecard</div>
          {% if row.scorecard_fmt %}
          <div class="prov-value" style="color:var(--accent);">{{ row.scorecard_fmt }} / 10</div>
          <div class="prov-sub">via deps.dev · OpenSSF</div>
          {% else %}
          <div class="prov-value prov-no">—</div>
          <div class="prov-sub">Not available</div>
          {% endif %}
        </div>
        <div class="prov-signal">
          <div class="prov-label">Signed Commits</div>
          {% if row.signed_commits_pct is not none %}
          <div class="prov-value {% if row.signed_commits_pct >= 50 %}prov-yes{% elif row.signed_commits_pct > 0 %}{% else %}prov-no{% endif %}" style="{% if row.signed_commits_pct > 0 and row.signed_commits_pct < 50 %}color:var(--aging);{% endif %}">{{ row.signed_commits_pct }}%</div>
          <div class="prov-sub">of last 100 commits verified</div>
          {% else %}
          <div class="prov-value prov-no">—</div>
          <div class="prov-sub">Unable to query</div>
          {% endif %}
        </div>
      </div>
      {% if row.scorecard_checks %}
      <div class="sc-checks">
        {% for check_name, check_score in row.scorecard_checks.items() %}
        <div class="sc-check">
          <span class="sc-check-name">{{ check_name }}</span>
          <span class="sc-check-val" style="color:{% if check_score >= 7 %}var(--fresh){% elif check_score >= 4 %}var(--aging){% else %}var(--stale){% endif %}">{{ check_score }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </section>

    {% if row.safety_qa %}
    <section class="safety-qa">
      <h2 class="section-title">Is {{ row.name }} safe?</h2>
      {% if row.license_type in ('proprietary', 'source-available') %}
      <div class="qa-summary" style="background:rgba(216,166,87,0.08);border:1px solid rgba(216,166,87,0.2);border-radius:6px;padding:10px 14px;margin-bottom:12px;font-size:13px;">
        <strong>{{ row.license_type | capitalize }} software.</strong> A lower HVTrust score reflects fewer <em>public</em> supply-chain artifacts (open license, build provenance, signed commits) — not a security finding. {{ row.name }} may have internal security practices not visible through public signals.
      </div>
      {% endif %}
      <div class="qa-summary">{{ row.safety_qa.safety_summary }}</div>

      <details>
        <summary>Does {{ row.name }} publish package provenance?</summary>
        <div class="qa-answer">{{ row.safety_qa.provenance_answer }}</div>
      </details>
      <details>
        <summary>Does {{ row.name }} have an OpenSSF Scorecard?</summary>
        <div class="qa-answer">{{ row.safety_qa.scorecard_answer }}</div>
      </details>
      <details>
        <summary>Is {{ row.name }} actively maintained?</summary>
        <div class="qa-answer">{{ row.safety_qa.maintenance_answer }}</div>
      </details>
      <details>
        <summary>What license does {{ row.name }} use?</summary>
        <div class="qa-answer">{{ row.name }} ships under {{ row.safety_qa.license }}. A declared, OSI-approved license is one of the transparency signals HVTrust scores.</div>
      </details>
      {% if row.safety_qa.signed_pct is not none %}
      <details>
        <summary>Are {{ row.name }}'s commits signed?</summary>
        <div class="qa-answer">{{ row.safety_qa.signed_pct }}% of the last 100 commits to {{ row.name }} are verified-signed (GPG, SSH, S/MIME, or GitHub's signing flow). Signed commits help confirm that code was authored by who the commit claims.</div>
      </details>
      {% endif %}

      <p class="qa-disclaimer"><strong>Not a safety endorsement.</strong> HVTracker describes what public signals show, not whether a project is safe for your use case. Run your own security review before adopting in production.</p>
    </section>
    {% endif %}

    {% if comparisons %}
    <section class="compare-strip">
      <h2 class="section-title">Compare {{ row.name }} head-to-head</h2>
      <div class="cmp-row">
        {% for c in comparisons[:3] %}
        <a class="cmp-link" href="{{ c.url }}">
          <span class="cmp-name">{{ row.name }} vs {{ c.name }}</span>
          <span class="cmp-arrow">→</span>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section class="runtime-soon">
      <h2 class="section-title">Runtime trust — coming soon</h2>
      <div class="rt-card">
        <p>HVTrust currently scores supply-chain signals. We're adding <strong>runtime trust</strong> next: what an agent actually does when it runs — what it can reach, which tools it carries, what external services it depends on. Track progress on the <a href="/roadmap/" style="color:var(--accent);">roadmap →</a></p>
        <ul class="rt-fields">
          <li>MCP support</li>
          <li>Tool / plugin surface</li>
          <li>External service deps</li>
          <li>Package provenance drift</li>
        </ul>
      </div>
    </section>

    <section class="maintainer-cta">
      <h2 class="section-title">Maintain {{ row.name }}?</h2>
      <p>HVTrust scores {{ row.name }} from <strong>public signals only</strong> — we never contact maintainers first. If a signal is wrong, stale, or missing (provenance you publish, a Scorecard you run, signed releases), tell us and we'll review it. Corrections are public and tracked on GitHub.</p>
      <div class="maintainer-actions">
        <a class="cta-correction" href="{{ row.correction_url }}" target="_blank" rel="noopener noreferrer">Submit a correction →</a>
        <a class="secondary-link" href="#embed-badge">Add the trust badge</a>
      </div>
    </section>

    {% if row.public_actions %}
    <section class="provenance">
      <h2 class="section-title">Public Actions</h2>
      <div style="display:flex;gap:32px;flex-wrap:wrap;margin-bottom:16px">
        <div>
          <div class="prov-label">Actions (30d)</div>
          <div class="prov-value" style="color:var(--accent)">{{ row.public_actions.actions_30d }}</div>
        </div>
        {% if row.public_actions.actions_30d_merged is not none %}
        <div>
          <div class="prov-label">Merged (30d)</div>
          <div class="prov-value" style="color:var(--accent)">{{ row.public_actions.actions_30d_merged }}</div>
        </div>
        {% if row.public_actions.actions_30d > 0 %}
        <div>
          <div class="prov-label">Merge rate</div>
          <div class="prov-value">{{ ((row.public_actions.actions_30d_merged / row.public_actions.actions_30d) * 100) | round | int }}%</div>
        </div>
        {% endif %}
        {% endif %}
      </div>
      {% if row.public_actions.actions_30d_by_repo %}
      <div class="prov-label" style="margin-bottom:8px">Top repos (sampled)</div>
      <ul style="margin:0;padding:0;list-style:none;font-size:13px">
        {% for entry in row.public_actions.actions_30d_by_repo[:5] %}
        <li style="margin-bottom:4px">
          <a href="https://github.com/{{ entry.repo }}" target="_blank" rel="noopener" style="color:var(--accent)">{{ entry.repo }}</a>
          <span style="color:var(--text-muted);margin-left:6px">{{ entry.count }}</span>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      <p style="font-size:11px;color:var(--text-muted);margin-top:16px;line-height:1.5">
        Action counts reflect activity on public repos where this agent left detectable fingerprints.
        Private repo usage is invisible. Counts are approximate (GitHub Search API caps at 1,000 results per query).
        Methodology described in the <a href="/spec/provenance/v0.1">Provenance Profile spec</a>.
      </p>
    </section>
    {% endif %}

    {% if events %}
    <section class="provenance">
      <h2 class="section-title">Reputation Timeline</h2>
      {% if row.event_chart_svg %}
      {{ row.event_chart_svg | safe }}
      {% endif %}
      <div style="display:flex;flex-direction:column;gap:0;">
        {% for e in events|reverse %}
        <div style="display:flex;align-items:flex-start;gap:12px;padding:10px 0;{% if not loop.last %}border-bottom:1px solid var(--border);{% endif %}">
          <span style="font-family:var(--font-mono);font-size:11px;color:var(--muted);white-space:nowrap;min-width:80px;">{{ e.date }}</span>
          <span style="font-size:14px;width:20px;text-align:center;flex-shrink:0;">{% if e.type == 'listed' %}🟢{% elif e.type == 'delisted' %}🔴{% elif e.type == 'score_changed' %}📊{% elif e.type == 'rank_changed' %}🔄{% elif e.type == 'stale_warning' %}⚠️{% elif e.type == 'freshness_restored' %}✅{% elif e.type == 'scorecard_added' %}🛡️{% elif e.type == 'provenance_added' %}🔏{% else %}📌{% endif %}</span>
          <div>
            <span style="font-family:var(--font-mono);font-size:12px;color:var(--accent);text-transform:uppercase;letter-spacing:0.5px;">{{ e.type|replace('_', ' ') }}</span>
            <div style="font-size:12px;color:var(--muted);margin-top:2px;">{{ e.detail }}</div>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section class="links">
      <a href="{{ row.url }}" target="_blank" rel="noopener noreferrer">GitHub →</a>
      {% if row.pypi_package %}<a href="https://pypi.org/project/{{ row.pypi_package }}/" target="_blank" rel="noopener noreferrer">PyPI: {{ row.pypi_package }}</a>{% endif %}
      {% if row.npm_package %}<a href="https://www.npmjs.com/package/{{ row.npm_package }}" target="_blank" rel="noopener noreferrer">npm: {{ row.npm_package }}</a>{% endif %}
    </section>

    <section class="provenance" id="embed-badge" style="margin-top:0;">
      <h2 class="section-title">Embed Badge <a href="/badges/" style="font-weight:400;color:var(--accent);font-size:11px;margin-left:8px;">Badge guide for maintainers →</a></h2>
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px;">
        <img src="/badge/{{ row.slug }}.svg" alt="HVTrust {{ row.trust_score }}" height="20">
        <img src="/badge/{{ row.slug }}-grade.svg" alt="Grade {{ row.evidence_grade }}" height="20">
      </div>
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:10px 14px;font-family:monospace;font-size:11px;color:var(--muted);word-break:break-all;line-height:1.6;">
        <span style="color:var(--text);">Markdown:</span><br>
        [![HVTrust](https://hvtracker.net/badge/{{ row.slug }}.svg)](https://hvtracker.net/agents/{{ row.slug }})<br>
        <span style="color:var(--text);margin-top:6px;display:inline-block;">HTML:</span><br>
        &lt;a href="https://hvtracker.net/agents/{{ row.slug }}"&gt;&lt;img src="https://hvtracker.net/badge/{{ row.slug }}.svg" alt="HVTrust"&gt;&lt;/a&gt;
      </div>
    </section>

    {% if row.siblings %}
    <section class="siblings">
      <h2 class="section-title">Other agents in {{ row.category }}</h2>
      <ul>
        {% for s in row.siblings %}
        <li>
          <a href="/agents/{{ s.slug }}">
            <span class="sib-rank">#{{ s.rank }}</span>
            <span class="sib-name">{{ s.name }}</span>
            <span class="sib-score">{{ s.score }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if comparisons %}
    <section class="siblings">
      <h2 class="section-title">{{ row.name }} head-to-head</h2>
      <ul>
        {% for c in comparisons %}
        <li>
          <a href="{{ c.url }}">
            <span class="sib-name">{{ row.name }} vs {{ c.name }}</span>
            <span class="sib-score">compare →</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <section class="terminal-note" style="padding:18px 20px;font-size:11px;color:var(--muted);line-height:1.7;">
      <strong style="color:var(--text);font-size:12px;">Data sources</strong><br>
      GitHub REST API (repo, commits, stars, forks, license){% if row.npm_package %} · npm Registry (downloads, provenance){% endif %}{% if row.pypi_package %} · PyPI / pypistats (downloads, provenance){% endif %}{% if row.crate_package %} · crates.io (downloads){% endif %}{% if row.scorecard_score is not none %} · OSSF Scorecard via deps.dev{% endif %}{% if row.hn_mentions_30d is not none %} · Algolia HN Search API{% endif %}{% if row.public_actions %} · GitHub Search API (fingerprint actions){% endif %}
      <br>Each agent's signals refresh once daily across 6 staggered batches. <a href="/methodology" style="color:var(--accent);">Methodology {{ methodology_version }}</a> · <a href="/data/agents/{{ row.slug }}.json" style="color:var(--accent);">Raw JSON</a>
    </section>

    <footer>
      <span>Updated {{ updated }}</span>
      <span class="footer-sep">·</span>
      <a href="/methodology">methodology</a>
      <span class="footer-sep">·</span>
      <a href="/">all agents</a>
    </footer>

  </div>
  <script>
    (function () {
      const WATCHLIST_KEY = "hvtracker_watchlist_v1";
      const btn = document.getElementById("watchToggle");
      const compareLink = document.getElementById("watchlistCompareLink");
      if (!btn || !compareLink) return;

      function loadWatchlist() {
        try {
          const raw = localStorage.getItem(WATCHLIST_KEY);
          const items = raw ? JSON.parse(raw) : [];
          return Array.isArray(items) ? items : [];
        } catch (_) {
          return [];
        }
      }

      function saveWatchlist(items) {
        localStorage.setItem(WATCHLIST_KEY, JSON.stringify(items.slice(0, 12)));
      }

      function render() {
        const items = loadWatchlist();
        const saved = items.some((item) => item.slug === btn.dataset.watchSlug);
        btn.classList.toggle("is-saved", saved);
        btn.textContent = saved ? "Saved to watchlist" : "Save to watchlist";
        compareLink.href = items.length ? "/compare/?watchlist=1" : "/compare/";
        compareLink.textContent = items.length ? `Compare saved agents (${items.length})` : "Compare saved agents";
      }

      btn.addEventListener("click", () => {
        const items = loadWatchlist();
        const slug = btn.dataset.watchSlug;
        const existing = items.find((item) => item.slug === slug);
        const next = existing
          ? items.filter((item) => item.slug !== slug)
          : items.concat([{ slug, name: btn.dataset.watchName, repo: btn.dataset.watchRepo }]).slice(0, 12);
        saveWatchlist(next);
        render();
        if (typeof hvtTrack === "function") {
          hvtTrack(existing ? "watchlist_remove" : "watchlist_add", {
            slug,
            watchlist_size: next.length
          });
        }
      });

      render();
    })();
  </script>
</body>
</html>
