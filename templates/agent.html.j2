<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ row.name }} Review — Trust Score & Safety Profile | HVTracker</title>
  <meta name="description" content="Is {{ row.name }} trustworthy? Independent trust score {{ row.trust_score }}/100 (Grade {{ row.evidence_grade }}). Ranked #{{ row.rank }} of {{ total }} tracked AI agent projects. {{ row.stars_fmt }} GitHub stars, {{ row.category }}. Safety, transparency, maintenance, and provenance signals reviewed.">
  <link rel="canonical" href="https://hvtracker.net/agents/{{ row.slug }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ row.name }} — Trust Score {{ row.trust_score }}/100 | HVTracker">
  <meta property="og:description" content="Grade {{ row.evidence_grade }} · HVTrust {{ row.trust_score }}/100 · {{ row.stars_fmt }} stars · {{ row.category }}. Independent trust signals for tracked AI agent projects.">
  <meta property="og:url" content="https://hvtracker.net/agents/{{ row.slug }}">
  <meta property="og:image" content="https://hvtracker.net/agents/{{ row.slug }}/og.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ row.name }} — Trust Score {{ row.trust_score }}/100 on HVTracker">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://hvtracker.net/agents/{{ row.slug }}/og.png">
  <meta name="twitter:image:alt" content="{{ row.name }} on HVTracker">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "{{ row.name }}",
    "applicationCategory": "{{ row.category }}",
    "operatingSystem": "Cross-platform",
    "url": "{{ row.url }}",
    {% if row.description %}"description": "{{ row.description }}",{% endif %}
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ row.trust_score }}",
      "bestRating": "100",
      "worstRating": "0",
      "ratingCount": "{{ row.stars }}"
    },
    "review": {
      "@type": "Review",
      "author": {
        "@type": "Organization",
        "name": "HVTracker",
        "url": "https://hvtracker.net"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "{{ row.trust_score }}",
        "bestRating": "100",
        "worstRating": "0"
      },
      "reviewBody": "{{ row.name }} receives a trust score of {{ row.trust_score }}/100 (Grade {{ row.evidence_grade }}) based on independent analysis of activity, adoption, transparency, safety, and identity signals."
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "{{ row.category }}", "item": "https://hvtracker.net/categories/{{ row.category | lower | replace(' ', '-') | replace('/', '-') | replace('&', '') }}" },
      { "@type": "ListItem", "position": 3, "name": "{{ row.name }}" }
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is {{ row.name }} safe to use?",
        "acceptedAnswer": { "@type": "Answer", "text": "{{ row.name }} has an HVTrust score of {{ row.trust_score }}/100 (Grade {{ row.evidence_grade }}), ranked #{{ row.rank }} of {{ total }} tracked AI agent projects. This score reflects verifiable supply-chain integrity, transparency, maintenance, and adoption signals." }
      },
      {
        "@type": "Question",
        "name": "What is the trust score for {{ row.name }}?",
        "acceptedAnswer": { "@type": "Answer", "text": "{{ row.name }} scores {{ row.trust_score }}/100 on HVTracker's evidence-weighted HVTrust scale. It has {{ row.stars_fmt }} GitHub stars and is categorized under {{ row.category }}." }
      }
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:#f4f1eb; --surface:#eae6de; --border:#d4cfc5;
      --text:#1a1a1a; --muted:#6b6560; --accent:#2c5282; --accent-warm:#b05a3a;
      --green:#2f6846; --red:#9b3c3c; --amber:#8b6914;
      --font-mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
      --font-sans:"Hanken Grotesk",system-ui,-apple-system,sans-serif;
    }
    body { background:var(--bg); background-image:url("/hex-bg.svg");background-size:2000px 2000px; color:var(--text); font-family:var(--font-sans); font-size:15px; line-height:1.6; min-height:100vh; }
    a { color:inherit; text-decoration:none; }
    a:hover { text-decoration:underline; }
    .page { max-width:780px; margin:0 auto; padding:0 24px; background:var(--bg); min-height:100vh; }

    .site-header {
      position: sticky; top: 0; z-index: 100;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .site-header-inner {
      max-width: 1200px; margin: 0 auto; padding: 14px 24px;
      display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
    }
    .logo { font-family:var(--font-mono); font-size:20px; font-weight:700; }
    .logo span { color:var(--accent-warm); }
    .site-nav { font-family:var(--font-mono); font-size:11px; display:flex; gap:6px; margin-left:auto; flex-wrap:wrap; }
    .site-nav a { color:var(--muted); padding:5px 10px; border:1px solid transparent; }
    .site-nav a:hover { color:var(--text); text-decoration:none; border-color:var(--border); background:var(--surface); }
    .back { font-family:var(--font-mono); font-size:11px; color:var(--muted); margin-left:auto; }
    .back:hover { color:var(--text); }

    .hero { padding:24px 0; border-bottom:1px solid var(--border); }
    h1 { font-size:28px; font-weight:700; margin-bottom:4px; }
    .hero .repo { font-family:var(--font-mono); font-size:12px; color:var(--muted); }
    .hero .repo a:hover { color:var(--accent); }
    .hero .desc { margin-top:10px; font-size:14px; color:var(--text); max-width:600px; }
    .hero .badges { margin-top:10px; display:flex; gap:8px; flex-wrap:wrap; font-family:var(--font-mono); font-size:11px; }
    .badge { color:var(--muted); }
    .badge.lang { color:var(--amber); }
    .badge.cat { color:var(--accent); }
    .badge.state-listed { color:var(--green); }
    .badge.state-warning { color:var(--red); }
    .badge.state-legacy { color:#999; }
    .badge.state-rejected, .badge.state-delisted { color:var(--red); }
    .hero-actions { margin-top:12px; display:flex; gap:8px; flex-wrap:wrap; }
    .hero-summary-grid { margin-top:16px; display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:1px; background:var(--border); }
    .hero-summary-item { padding:10px; background:var(--bg); }
    .hero-summary-label { font-family:var(--font-mono); font-size:10px; text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); margin-bottom:4px; }
    .hero-summary-value { font-family:var(--font-mono); font-size:13px; font-weight:600; line-height:1.3; }
    .hero-summary-value.positive { color:var(--green); }
    .hero-summary-value.negative { color:var(--red); }
    .hero-summary-value.neutral { color:var(--accent); }
    .warning-banner { margin-top:12px; padding:10px 12px; border-left:3px solid var(--red); background:var(--surface); }
    .warning-banner strong { font-size:12px; }
    .warning-banner ul { list-style:none; padding:0; margin:4px 0 0; }
    .warning-banner li { font-size:11px; color:var(--muted); line-height:1.5; }

    .rank-block { padding:16px 0; border-bottom:1px solid var(--border); display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:16px; align-items:end; }
    .rank-big { font-family:var(--font-mono); font-size:36px; font-weight:700; line-height:1; color:var(--text); }
    .rank-label { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:0.04em; margin-top:4px; }
    .rank-label a { color:var(--accent); }
    .rank-sub { font-family:var(--font-mono); font-size:12px; color:var(--muted); }
    .score-pill { display:inline-block; font-family:var(--font-mono); font-size:20px; font-weight:700; margin-bottom:2px; }
    .score-high { color:var(--green); }
    .score-mid  { color:var(--amber); }
    .score-low  { color:var(--muted); }

    .stats { padding:18px 0; border-top:1px solid var(--border); }
    .stats-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:14px 20px; }
    .stat-label { font-family:var(--font-mono); font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:3px; }
    .stat-value { font-family:var(--font-mono); font-size:16px; font-weight:600; }
    .stat-sub { font-size:11px; color:var(--muted); margin-top:1px; }
    .fresh-dot { display:inline-block; width:6px; height:6px; border-radius:50%; margin-right:4px; vertical-align:middle; }
    .fresh  .fresh-dot { background:var(--green); }
    .recent .fresh-dot { background:#5a8a6a; }
    .aging  .fresh-dot { background:var(--amber); }
    .stale  .fresh-dot { background:#999; }

    .analysis { padding:18px 0; border-top:1px solid var(--border); }
    .section-title { font-size:13px; font-weight:600; margin-bottom:12px; }
    .analysis-panel { display:grid; gap:12px; }
    .analysis-card { border:1px solid var(--border); padding:14px; }
    .analysis-card-head { display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin-bottom:10px; }
    .analysis-card-title { font-size:13px; font-weight:700; }
    .analysis-score { font-family:var(--font-mono); font-size:11px; color:var(--muted); }
    .metric-section + .metric-section { margin-top:14px; padding-top:12px; border-top:1px solid var(--border); }
    .metric-section-title { display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin-bottom:8px; }
    .metric-section-title h3 { font-size:13px; }
    .metric-section-title span { font-family:var(--font-mono); font-size:11px; color:var(--muted); }
    .metric-list { display:grid; gap:7px; }
    .metric-row { display:grid; grid-template-columns:160px minmax(160px, 1fr) 80px; gap:12px; align-items:center; min-height:28px; font-family:var(--font-mono); }
    .metric-name { color:var(--muted); font-size:11px; line-height:1.3; }
    .metric-name strong { display:block; color:var(--text); font-size:11px; }
    .metric-sub { color:#999; font-size:10px; }
    .metric-track { position:relative; height:6px; overflow:hidden; background:var(--border); }
    .metric-fill { height:100%; width:var(--fill); background:var(--bar, var(--accent)); }
    .metric-value { color:var(--text); text-align:right; font-size:11px; font-weight:700; }
    .metric-value span { color:var(--muted); font-weight:400; }

    .trend { padding:16px 0; border-top:1px solid var(--border); }
    .sparkline-wrap { margin-top:8px; }
    .sparkline-labels { display:flex; justify-content:space-between; font-family:var(--font-mono); font-size:10px; color:var(--muted); margin-top:3px; }
    .insight-chart { width:100%; height:auto; display:block; overflow:visible; margin:6px 0 10px; }
    .chart-legend { display:flex; gap:8px; flex-wrap:wrap; font:11px var(--font-mono); color:var(--muted); }
    .chart-legend span { display:inline-flex; align-items:center; gap:4px; }
    .chart-legend i { display:inline-block; width:8px; height:8px; }
    .chart-legend strong { color:var(--text); font-weight:600; }

    .provenance { padding:18px 0; border-top:1px solid var(--border); }
    .prov-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:12px 20px; }
    .prov-signal { padding:8px 0; }
    .prov-label { font-family:var(--font-mono); font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:4px; }
    .prov-value { font-family:var(--font-mono); font-size:15px; font-weight:600; }
    .prov-yes { color:var(--green); }
    .prov-no { color:#999; }
    .prov-sub { font-size:11px; color:var(--muted); margin-top:2px; }
    .sc-checks { margin-top:8px; display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:4px 14px; font-family:var(--font-mono); font-size:11px; }
    .sc-check { display:flex; justify-content:space-between; padding:2px 0; border-bottom:1px solid rgba(0,0,0,0.06); }
    .sc-check-name { color:var(--muted); }
    .sc-check-val { font-weight:600; }

    .links { padding:6px 0; display:flex; gap:8px; flex-wrap:wrap; font-family:var(--font-mono); font-size:11px; }
    .links a { padding:4px 10px; border:1px solid var(--border); color:var(--muted); }
    .links a:hover { color:var(--accent); border-color:var(--accent); text-decoration:none; }
    .compare-link { font-family:var(--font-mono); font-size:11px; padding:6px 12px; border:1px solid var(--accent); color:var(--accent); font-weight:600; }
    .compare-link:hover { color:var(--text); text-decoration:none; }
    .secondary-link { font-family:var(--font-mono); font-size:11px; padding:6px 12px; border:1px solid var(--border); color:var(--muted); }
    .secondary-link:hover { color:var(--text); border-color:var(--text); text-decoration:none; }
    .watch-button.is-saved { color:var(--green); border-color:var(--green); }

    .review-card { padding:16px 0; margin:0; border-bottom:1px solid var(--border); }
    .review-grid { display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:10px; }
    .review-item { border:1px solid var(--border); padding:10px; }
    .review-item.primary { grid-row:span 2; }
    .review-item.wide { grid-column:span 2; }
    .review-kicker { font-family:var(--font-mono); font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:5px; }
    .review-value { font-size:14px; line-height:1.45; }
    .review-metric { font-family:var(--font-mono); font-size:18px; font-weight:700; color:var(--accent-warm); margin-top:3px; }
    .review-actions { margin-top:12px; display:flex; flex-wrap:wrap; gap:8px; }
    .remediation-panel { margin-top:12px; border:1px solid var(--border); padding:10px; }
    .remediation-list { display:grid; gap:8px; }
    .remediation-item { display:grid; gap:2px; }
    .remediation-item strong { font-size:12px; }
    .remediation-item span { font-size:11px; color:var(--muted); line-height:1.5; }
    .warning-list { margin-top:12px; border-left:3px solid var(--red); padding:8px 12px; background:var(--surface); }
    .warning-list-items { display:grid; gap:6px; }
    .warning-list-item { font-size:11px; color:var(--muted); line-height:1.5; }
    .recent-changes { margin:12px 0 0; }
    .recent-change-list { display:grid; gap:8px; }
    .recent-change-item { display:grid; grid-template-columns:80px minmax(0, 1fr); gap:10px; padding:8px 0; border-bottom:1px solid rgba(0,0,0,0.06); align-items:start; }
    .recent-change-date { font-family:var(--font-mono); font-size:11px; color:var(--muted); }
    .recent-change-body { min-width:0; }
    .recent-change-badge { font-family:var(--font-mono); font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); margin-bottom:4px; display:inline-block; }
    .recent-change-badge.positive { color:var(--green); }
    .recent-change-badge.negative { color:var(--red); }
    .recent-change-badge.neutral { color:var(--accent); }
    .recent-change-detail { font-size:12px; line-height:1.5; }

    .how-to-read { margin:12px 0 0; padding:10px 0; font-size:12px; color:var(--muted); line-height:1.6; border-bottom:1px solid var(--border); }
    .how-to-read strong { color:var(--text); font-weight:600; }
    .how-to-read a { color:var(--accent); }

    .freshness-banner { margin:12px 0 0; padding:8px 0; font-family:var(--font-mono); font-size:11px; color:var(--muted); display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .freshness-banner.is-stale { color:var(--amber); }
    .freshness-banner .dot { width:6px; height:6px; border-radius:50%; background:var(--green); }
    .freshness-banner.is-stale .dot { background:var(--amber); }
    .freshness-banner .meta { color:var(--muted); }

    .safety-qa { padding:18px 0; border-top:1px solid var(--border); }
    .safety-qa .qa-summary { padding:10px 12px; margin-bottom:14px; border-left:3px solid var(--accent); background:var(--surface); font-size:13px; line-height:1.6; }
    .safety-qa details { padding:8px 0; border-bottom:1px solid rgba(0,0,0,0.06); }
    .safety-qa details:last-of-type { border-bottom:none; }
    .safety-qa summary { cursor:pointer; font-size:13px; font-weight:600; padding:4px 0; list-style:none; }
    .safety-qa summary::-webkit-details-marker { display:none; }
    .safety-qa summary::before { content:"+ "; color:var(--accent); font-family:var(--font-mono); font-weight:700; }
    .safety-qa details[open] summary::before { content:"− "; }
    .safety-qa .qa-answer { padding:4px 0 4px 14px; font-size:13px; color:var(--muted); line-height:1.7; }
    .safety-qa .qa-disclaimer { margin-top:12px; padding:8px 0; font-size:11px; color:var(--muted); border-top:1px solid var(--border); }

    .compare-strip { padding:18px 0; border-top:1px solid var(--border); }
    .compare-strip .cmp-row { display:flex; gap:8px; flex-wrap:wrap; }
    .compare-strip .cmp-link { flex:1 1 200px; padding:10px 12px; border:1px solid var(--border); font-family:var(--font-mono); font-size:12px; display:flex; justify-content:space-between; align-items:center; gap:8px; }
    .compare-strip .cmp-link:hover { text-decoration:none; border-color:var(--accent); color:var(--accent); }
    .compare-strip .cmp-name { font-weight:600; }
    .compare-strip .cmp-arrow { color:var(--accent); font-weight:700; }

    .runtime-soon { padding:18px 0; border-top:1px solid var(--border); }
    .runtime-soon .rt-card { padding:16px; border:1px solid #b9d5cf; background:linear-gradient(180deg, rgba(23,92,78,0.09), rgba(23,92,78,0.03)); color:#47635d; font-size:13px; line-height:1.6; box-shadow:0 10px 30px rgba(23,92,78,0.05); }
    .runtime-soon .rt-card strong { color:var(--text); font-weight:600; }
    .runtime-kicker { display:inline-flex; align-items:center; gap:6px; margin-bottom:10px; padding:4px 8px; border:1px solid #b9d5cf; background:rgba(255,255,255,0.55); font-family:var(--font-mono); font-size:10px; text-transform:uppercase; letter-spacing:0.05em; color:#175c4e; }
    .runtime-intro { max-width:640px; }
    .runtime-grid { margin-top:14px; display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:10px; }
    .runtime-panel { border:1px solid #c5ddd8; background:rgba(255,255,255,0.62); padding:12px; min-height:100%; }
    .runtime-panel-head { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:8px; }
    .runtime-panel-title { font-size:12px; font-weight:700; letter-spacing:0.02em; text-transform:uppercase; color:#175c4e; }
    .runtime-status { display:inline-flex; align-items:center; gap:6px; padding:3px 8px; border:1px solid #c5ddd8; background:rgba(255,255,255,0.7); font-family:var(--font-mono); font-size:10px; text-transform:uppercase; letter-spacing:0.04em; white-space:nowrap; }
    .runtime-status.positive { color:#1f6b52; border-color:rgba(31,107,82,0.28); }
    .runtime-status.neutral { color:#175c4e; border-color:rgba(23,92,78,0.24); }
    .runtime-status.muted { color:var(--muted); }
    .runtime-confidence { margin-top:2px; font-family:var(--font-mono); font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:0.04em; }
    .runtime-summary { color:var(--text); font-size:14px; line-height:1.5; }
    .runtime-summary.muted { color:var(--muted); }
    .runtime-provider-list { margin-top:8px; display:flex; flex-wrap:wrap; gap:6px; }
    .runtime-provider { list-style:none; padding:4px 8px; border:1px solid #c5ddd8; background:rgba(255,255,255,0.82); font-family:var(--font-mono); font-size:11px; color:#175c4e; }
    .runtime-note { margin-top:8px; font-size:11px; color:var(--muted); }
    .runtime-note strong { color:var(--text); }
    .runtime-mini { margin-top:8px; font-family:var(--font-mono); font-size:11px; color:var(--muted); }
    .runtime-roadmap { margin-top:14px; display:flex; flex-wrap:wrap; gap:8px; }
    .runtime-roadmap li { list-style:none; padding:5px 9px; border:1px solid #c5ddd8; font-family:var(--font-mono); font-size:10px; text-transform:uppercase; letter-spacing:0.04em; color:#47635d; background:rgba(255,255,255,0.58); }
    .runtime-roadmap li.live { color:#1f6b52; border-color:rgba(31,107,82,0.25); }
    .timeline-scroll { max-height:360px; overflow-y:auto; padding-right:6px; margin-top:10px; }
    .timeline-scroll::-webkit-scrollbar { width:8px; }
    .timeline-scroll::-webkit-scrollbar-thumb { background:rgba(0,0,0,0.12); border-radius:999px; }
    .timeline-event-list { display:flex; flex-direction:column; gap:0; }
    .timeline-event { display:flex; align-items:flex-start; gap:12px; padding:10px 0; }
    .timeline-event + .timeline-event { border-top:1px solid var(--border); }
    .timeline-date { font-family:var(--font-mono); font-size:11px; color:var(--muted); white-space:nowrap; min-width:80px; }
    .timeline-body { min-width:0; }
    .timeline-label { font-family:var(--font-mono); font-size:12px; color:var(--accent); text-transform:uppercase; letter-spacing:0.5px; }
    .timeline-detail { font-size:12px; color:var(--muted); margin-top:2px; }

    .maintainer-cta { padding:16px 0; margin:0; border-bottom:1px solid var(--border); }
    .maintainer-cta .section-title { margin-bottom:6px; }
    .maintainer-cta p { font-size:13px; color:var(--muted); line-height:1.6; max-width:560px; margin-bottom:10px; }
    .maintainer-cta p strong { color:var(--text); }
    .maintainer-actions { display:flex; gap:8px; flex-wrap:wrap; font-family:var(--font-mono); font-size:11px; }
    .cta-correction { padding:6px 12px; border:1px solid var(--amber); color:var(--amber); font-weight:600; }
    .cta-correction:hover { color:var(--text); border-color:var(--text); text-decoration:none; }

    .siblings { padding:18px 0; border-top:1px solid var(--border); }
    .siblings ul { list-style:none; display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:6px 14px; }
    .siblings li a { display:flex; align-items:baseline; gap:6px; padding:6px 0; border-bottom:1px solid rgba(0,0,0,0.06); }
    .siblings li a:hover { text-decoration:none; color:var(--accent); }
    .siblings .sib-rank { font-family:var(--font-mono); font-size:10px; color:var(--muted); min-width:24px; text-align:right; }
    .siblings .sib-name { flex:1; font-weight:500; font-size:12px; }
    .siblings .sib-score { font-family:var(--font-mono); font-size:11px; color:var(--accent); }

    footer { padding:20px 0 32px; border-top:1px solid var(--border); font-size:11px; color:var(--muted); display:flex; gap:12px; flex-wrap:wrap; }
    footer a { color:var(--accent); }
    .footer-sep { color:var(--border); }
    .terminal-note { border-top:1px solid var(--border); }
    @media (max-width:720px) {
      .hero-summary-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); }
      .rank-block { grid-template-columns:repeat(2, minmax(0, 1fr)); }
      .review-grid { grid-template-columns:1fr; }
      .review-item.primary { grid-row:auto; }
      .review-item.wide { grid-column:auto; }
      .metric-row { grid-template-columns:1fr; gap:4px; padding:6px 0; }
      .metric-value { text-align:left; }
      .runtime-grid { grid-template-columns:1fr; }
    }
  </style>

  <!-- Google tag (gtag.js) -->
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){var host=window.location.hostname||"";if(/^(localhost|127(?:\.\d{1,3}){3}|0(?:\.\d{1,3}){3}|::1)$/i.test(host)){window["ga-disable-G-TZ8921LR0K"]=true;return}try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "{{ row.category }}", "item": "https://hvtracker.net/categories/{{ row.category_slug }}/" },
      { "@type": "ListItem", "position": 3, "name": "{{ row.name }}", "item": "https://hvtracker.net/agents/{{ row.slug }}/" }
    ]
  }
  </script>
</head>
<body data-page-type="agent_profile" data-agent-slug="{{ row.slug }}" data-agent-name="{{ row.name }}" data-category="{{ row.category }}" data-global-rank="{{ row.rank }}" data-trust-score="{{ row.trust_score }}">
  <header class="site-header">
    <div class="site-header-inner">
      <a href="/" class="logo">HV<span>Tracker</span></a>
      <nav class="site-nav" aria-label="Site">
        <a href="/">Leaderboard</a>
        <a href="/movers/">Movers</a>
        <a href="/use-cases/">Use cases</a>
        <a href="/methodology">Methodology</a>
        <a href="/compare/">Compare</a>
        <a href="/alerts/">Alerts</a>
        <a href="/data/">Data API</a>
        <a href="/sponsor/">Sponsor</a>
      </nav>
    </div>
  </header>
  <div class="page">

    <section class="hero">
      <h1>{{ row.name }}</h1>
      <div class="repo">
        <a href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.repo }}</a>
      </div>
      {% if row.description %}<p class="desc">{{ row.description }}</p>{% endif %}
      <div class="badges">
        {% if row.category %}<a href="/categories/{{ row.category_slug }}" class="badge cat" style="text-decoration:none">{{ row.category }}</a>{% endif %}
        {% if row.language %}<span class="badge lang">{{ row.language }}</span>{% endif %}
        {% if row.evidence_grade %}<span class="badge grade-{{ row.evidence_grade }}" title="Grade {{ row.evidence_grade }}">Grade {{ row.evidence_grade }}</span>{% endif %}
        {% if row.display_listing_status %}<span class="badge state-{{ row.display_listing_status }}">{{ row.display_status_label }}</span>{% endif %}
        {% if row.license_spdx %}<span class="badge">{{ row.license_spdx }}</span>{% endif %}
        {% if row.license_type and row.license_type != 'open' %}<span class="badge" style="color:{% if row.license_type == 'proprietary' %}var(--red){% elif row.license_type == 'source-available' %}var(--amber){% else %}var(--muted){% endif %}">{{ row.license_type | capitalize }}</span>{% endif %}
      </div>
      <div class="hero-actions">
        <a class="compare-link" href="/compare/?a={{ row.slug }}">Compare</a>
        <button class="secondary-link watch-button" id="watchToggle" type="button" data-watch-slug="{{ row.slug }}" data-watch-name="{{ row.name }}" data-watch-repo="{{ row.repo }}">Save to watchlist</button>
        <a class="secondary-link" id="watchlistCompareLink" href="/compare/">Compare saved agents</a>
        <a class="secondary-link" href="/track/{{ row.slug }}">Track this agent</a>
        <a class="secondary-link" href="{{ row.correction_url }}" target="_blank" rel="noopener noreferrer">Suggest correction</a>
      </div>
      <div class="hero-summary-grid">
        <div class="hero-summary-item">
          <div class="hero-summary-label">Listing state</div>
          <div class="hero-summary-value{% if row.display_status_tone %} {{ row.display_status_tone }}{% endif %}">{{ row.display_status_label }}</div>
        </div>
        <div class="hero-summary-item">
          <div class="hero-summary-label">HVTrust</div>
          <div class="hero-summary-value">{{ row.trust_score }}/100 · Grade {{ row.evidence_grade }}</div>
        </div>
        <div class="hero-summary-item">
          <div class="hero-summary-label">Last push</div>
          <div class="hero-summary-value">{{ row.last_push }}{% if row.days_ago is not none %} · {{ row.days_ago }}d ago{% endif %}</div>
        </div>
        <div class="hero-summary-item">
          <div class="hero-summary-label">Recent change</div>
          <div class="hero-summary-value{% if row.recent_change_summary %} {{ row.recent_change_summary.tone }}{% endif %}">
            {% if row.recent_change_summary %}
              {{ row.recent_change_summary.short_label }}{% if row.recent_change_summary.count > 1 %} +{{ row.recent_change_summary.count - 1 }}{% endif %}
            {% else %}
              No recent signal change
            {% endif %}
          </div>
        </div>
      </div>
      {% if row.warning_reasons %}
      <div class="warning-banner">
        <strong>Active listing, but review is needed</strong>
        <ul>
          {% for warning in row.warning_reasons %}
          <li>[{{ warning.criterion }}] {{ warning.detail }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
    </section>

    <section class="review-card">
      <h2 class="section-title">Quick Trust Read</h2>
      <div class="review-grid">
        <div class="review-item primary">
          <div class="review-kicker">Verdict</div>
          <div class="review-value">{{ row.review_insights.verdict }}</div>
          <div class="review-metric">{{ row.trust_score }}/100 · Grade {{ row.evidence_grade }}</div>
        </div>
{% if row.review_insights.strongest %}
        <div class="review-item">
          <div class="review-kicker">Strongest Signal</div>
          <div class="review-value">{{ row.review_insights.strongest.label }}</div>
          <div class="review-metric">{{ row.review_insights.strongest.value }}/{{ row.review_insights.strongest.max }}</div>
        </div>
{% endif %}
{% if row.review_insights.weakest %}
        <div class="review-item">
          <div class="review-kicker">Weakest Signal</div>
          <div class="review-value">{{ row.review_insights.weakest.label }}</div>
          <div class="review-metric">{{ row.review_insights.weakest.value }}/{{ row.review_insights.weakest.max }}</div>
        </div>
{% endif %}
        <div class="review-item wide">
          <div class="review-kicker">What Would Improve It</div>
          <div class="review-value">{{ row.review_insights.improvement }}</div>
        </div>
      </div>
      {% if row.recent_events %}
      <div class="recent-changes">
        <div class="review-kicker">Recent Changes</div>
        <div class="recent-change-list">
          {% for e in row.recent_events[-3:]|reverse %}
          <div class="recent-change-item">
            <div class="recent-change-date">{{ e.date }}</div>
            <div class="recent-change-body">
              <span class="recent-change-badge {{ e.tone }}">{{ e.label }}</span>
              <div class="recent-change-detail">{{ e.detail }}</div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      {% if row.remediation_steps %}
      <div class="remediation-panel">
        <div class="review-kicker">Maintainer Checklist</div>
        <div class="remediation-list">
          {% for step in row.remediation_steps %}
          <div class="remediation-item">
            <strong>{{ step.label }}</strong>
            <span>{{ step.detail }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      {% if row.warning_reasons %}
      <div class="warning-list">
        <div class="review-kicker">Review Flags</div>
        <div class="warning-list-items">
          {% for warning in row.warning_reasons %}
          <div class="warning-list-item">[{{ warning.criterion }}] {{ warning.detail }}</div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      <div class="review-actions">
{% if comparisons %}
        <a class="compare-link" href="{{ comparisons[0].url }}">Compare with {{ comparisons[0].name }}</a>
{% else %}
        <a class="compare-link" href="/compare/?a={{ row.slug }}">Compare with another agent</a>
{% endif %}
        <a class="secondary-link" href="/track/{{ row.slug }}">Track {{ row.name }}</a>
        {% if row.category %}<a class="secondary-link" href="/categories/{{ row.category_slug }}">View {{ row.category }}</a>{% endif %}
        <a class="secondary-link" href="{{ row.correction_url }}" target="_blank" rel="noopener noreferrer">Report missing data</a>
      </div>
    </section>

    <section class="rank-block">
      <div>
        <div class="score-pill {{ row.score_class }}">{{ row.score }}</div>
        <div class="rank-label">Activity Score · out of 100</div>
      </div>
      {% if row.trust_score is defined %}
      <div>
        <div class="score-pill {% if row.trust_score >= 55 %}score-high{% elif row.trust_score >= 30 %}score-mid{% else %}score-low{% endif %}">{{ row.trust_score }}</div>
        <div class="rank-label">HVTrust Score · out of 100</div>
      </div>
      {% endif %}
      <div>
        <div class="rank-big">#{{ row.rank }}</div>
        <div class="rank-label">Global Rank · of {{ total }}</div>
      </div>
      {% if row.category_rank and row.category %}
      <div>
        <div class="rank-big" style="color:var(--amber)">#{{ row.category_rank }}</div>
        <div class="rank-label">In <a href="/categories/{{ row.category_slug }}">{{ row.category }}</a></div>
      </div>
      {% endif %}
    </section>

    <p class="how-to-read">
      <strong>How to read this:</strong> HVTrust (0–100) weighs supply-chain signals (provenance, OSSF Scorecard, signed commits, open license) alongside real-world adoption. <strong>Grade {{ row.evidence_grade }}</strong> reflects the trust score band: A ≥ 80, B ≥ 65, C ≥ 50, D &lt; 50. <a href="/methodology">Full methodology →</a>
    </p>

    {% set is_stale = row.days_ago is not none and row.days_ago > 180 %}
    <div class="freshness-banner{% if is_stale %} is-stale{% endif %}">
      <span class="dot"></span>
      <strong>Signals refreshed</strong>
      <span class="meta">{{ updated }}</span>
      <span class="meta">·</span>
      <span class="meta">Repo last pushed {% if row.days_ago == 0 %}today{% elif row.days_ago == 1 %}yesterday{% else %}{{ row.days_ago }} days ago{% endif %}{% if is_stale %} — may be stale{% endif %}</span>
    </div>

    {% if row.sparkline_svg %}
    <section class="trend">
      <h2 class="section-title">Rank Trend</h2>
      <div class="sparkline-wrap">
        {{ row.sparkline_svg | safe }}
        <div class="sparkline-labels">
          {% if row.rank_history %}
          <span>{{ row.rank_history[0].date }}</span>
          <span>{{ row.rank_history[-1].date }}</span>
          {% endif %}
        </div>
      </div>
    </section>
    {% endif %}

    <section class="stats">
      <h2 class="section-title">Activity & Reach</h2>
      <div class="stats-grid">
        <div>
          <div class="stat-label">Stars</div>
          <div class="stat-value">{{ row.stars_fmt }}</div>
        </div>
        <div>
          <div class="stat-label">Forks</div>
          <div class="stat-value">{{ row.forks_fmt }}</div>
        </div>
        <div class="{{ row.freshness_class }}">
          <div class="stat-label">Last Push</div>
          <div class="stat-value"><span class="fresh-dot"></span>{{ row.last_push }}</div>
          <div class="stat-sub">{% if row.days_ago == 0 %}today{% elif row.days_ago == 1 %}yesterday{% else %}{{ row.days_ago }} days ago{% endif %}</div>
        </div>
        <div>
          <div class="stat-label">Commits (4 wk)</div>
          <div class="stat-value">{% if row.weekly_commits is not none %}{{ row.weekly_commits }}{% else %}—{% endif %}{% if row.commits_low_confidence %}<span title="Recent push detected; GitHub's commit stats cache may be stale, so this 4-week count could be temporarily under-reported." style="color:var(--amber);font-size:13px;margin-left:3px;cursor:help;">?</span>{% endif %}</div>
        </div>
        <div>
          <div class="stat-label">Downloads (7d)</div>
          <div class="stat-value">{{ row.downloads_fmt }}</div>
          {% if row.dl_source %}<div class="stat-sub">{{ row.dl_source }}</div>{% endif %}
        </div>
        <div>
          <div class="stat-label">HN mentions (30d)</div>
          <div class="stat-value">{% if row.hn_mentions_30d is not none %}{{ row.hn_mentions_30d }}{% else %}—{% endif %}</div>
        </div>
        <div>
          <div class="stat-label">Open Issues</div>
          <div class="stat-value">{{ row.open_issues }}</div>
        </div>
        <div>
          <div class="stat-label">Rank Change</div>
          <div class="stat-value">{{ row.rank_delta_display }}</div>
          {% if row.previous_rank %}<div class="stat-sub">was #{{ row.previous_rank }}</div>{% endif %}
        </div>
      </div>
    </section>

    {% if row.trust_breakdown is defined %}
    <section class="analysis">
      <h2 class="section-title">Analysis</h2>
      <div class="analysis-panel">
        <div class="analysis-card">
          <div class="metric-section">
            <div class="metric-section-title">
              <h3>HVTrust Dimensions</h3>
              <span>{{ row.trust_score }} / 100{% if row.trust_confidence is defined and row.trust_confidence %} · {{ (row.trust_confidence * 100) | round }}% confidence{% endif %}</span>
            </div>
            <div class="metric-list" aria-label="HVTrust dimensions for {{ row.name }}">
              <div class="metric-row">
                <div class="metric-name"><strong>Safety / Integrity</strong><span class="metric-sub">OSSF, provenance, signatures</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.safety / 25 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.safety }} <span>/ 25</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Identity / Provenance</strong><span class="metric-sub">Listing and build link</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.identity / 18 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.identity }} <span>/ 18</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Transparency</strong><span class="metric-sub">License and public checks</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.transparency / 17 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.transparency }} <span>/ 17</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Maintenance</strong><span class="metric-sub">Freshness and commits</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.maintenance / 20 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.maintenance }} <span>/ 20</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Adoption</strong><span class="metric-sub">Stars and downloads</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ (row.trust_breakdown.adoption / 20 * 100) | round(1) }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.trust_breakdown.adoption }} <span>/ 20</span></div>
              </div>
            </div>
          </div>
          <div class="metric-section">
            <div class="metric-section-title">
              <h3>Activity Inputs</h3>
              <span>{{ row.score }} / 100</span>
            </div>
            <div class="metric-list" aria-label="Activity inputs for {{ row.name }}">
              <div class="metric-row">
                <div class="metric-name"><strong>Stars</strong><span class="metric-sub">Repository reach</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ row.score_breakdown.stars_pct }}%;--bar:var(--accent);"></div></div>
                <div class="metric-value">{{ row.score_breakdown.stars }} <span>/ 30</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Freshness</strong><span class="metric-sub">Last push recency</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ row.score_breakdown.freshness_pct }}%;--bar:var(--green);"></div></div>
                <div class="metric-value">{{ row.score_breakdown.freshness }} <span>/ 25</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Activity</strong><span class="metric-sub">Recent commits</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ row.score_breakdown.activity_pct }}%;--bar:#9ae6b4;"></div></div>
                <div class="metric-value">{{ row.score_breakdown.activity }} <span>/ 25</span></div>
              </div>
              <div class="metric-row">
                <div class="metric-name"><strong>Community</strong><span class="metric-sub">Fork signal</span></div>
                <div class="metric-track"><div class="metric-fill" style="--fill:{{ row.score_breakdown.community_pct }}%;--bar:var(--amber);"></div></div>
                <div class="metric-value">{{ row.score_breakdown.community }} <span>/ 20</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    <section class="provenance">
      <h2 class="section-title">Supply Chain Trust</h2>
      <div class="prov-grid">
        <div class="prov-signal">
          <div class="prov-label">Package Provenance</div>
          {% if row.has_provenance %}
          <div class="prov-value prov-yes">Verified</div>
          <div class="prov-sub">{{ row.provenance_sources|join(', ') }} attestation</div>
          {% else %}
          <div class="prov-value prov-no">None</div>
          <div class="prov-sub">No package attestations found</div>
          {% endif %}
        </div>
        <div class="prov-signal">
          <div class="prov-label">OSSF Scorecard</div>
          {% if row.scorecard_fmt %}
          <div class="prov-value" style="color:var(--accent);">{{ row.scorecard_fmt }} / 10</div>
          <div class="prov-sub">via deps.dev · OpenSSF</div>
          {% else %}
          <div class="prov-value prov-no">—</div>
          <div class="prov-sub">Not available</div>
          {% endif %}
        </div>
        <div class="prov-signal">
          <div class="prov-label">Signed Commits</div>
          {% if row.signed_commits_pct is not none %}
          <div class="prov-value {% if row.signed_commits_pct >= 50 %}prov-yes{% elif row.signed_commits_pct > 0 %}{% else %}prov-no{% endif %}" style="{% if row.signed_commits_pct > 0 and row.signed_commits_pct < 50 %}color:var(--amber);{% endif %}">{{ row.signed_commits_pct }}%</div>
          <div class="prov-sub">of last 100 commits verified</div>
          {% else %}
          <div class="prov-value prov-no">—</div>
          <div class="prov-sub">Unable to query</div>
          {% endif %}
        </div>
      </div>
      {% if row.scorecard_checks %}
      <div class="sc-checks">
        {% for check_name, check_score in row.scorecard_checks.items() %}
        <div class="sc-check">
          <span class="sc-check-name">{{ check_name }}</span>
          <span class="sc-check-val" style="color:{% if check_score >= 7 %}var(--green){% elif check_score >= 4 %}var(--aging){% else %}var(--muted){% endif %}">{{ check_score }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </section>

    {% if row.safety_qa %}
    <section class="safety-qa">
      <h2 class="section-title">Is {{ row.name }} safe?</h2>
      {% if row.license_type in ('proprietary', 'source-available') %}
      <div class="qa-summary" style="background:rgba(216,166,87,0.08);border:1px solid rgba(216,166,87,0.2);border-radius:6px;padding:10px 14px;margin-bottom:12px;font-size:13px;">
        <strong>{{ row.license_type | capitalize }} software.</strong> A lower HVTrust score reflects fewer <em>public</em> supply-chain artifacts (open license, build provenance, signed commits) — not a security finding. {{ row.name }} may have internal security practices not visible through public signals.
      </div>
      {% endif %}
      <div class="qa-summary">{{ row.safety_qa.safety_summary }}</div>

      <details>
        <summary>Does {{ row.name }} publish package provenance?</summary>
        <div class="qa-answer">{{ row.safety_qa.provenance_answer }}</div>
      </details>
      <details>
        <summary>Does {{ row.name }} have an OpenSSF Scorecard?</summary>
        <div class="qa-answer">{{ row.safety_qa.scorecard_answer }}</div>
      </details>
      <details>
        <summary>Is {{ row.name }} actively maintained?</summary>
        <div class="qa-answer">{{ row.safety_qa.maintenance_answer }}</div>
      </details>
      <details>
        <summary>What license does {{ row.name }} use?</summary>
        <div class="qa-answer">{{ row.name }} ships under {{ row.safety_qa.license }}. A declared, OSI-approved license is one of the transparency signals HVTrust scores.</div>
      </details>
      {% if row.safety_qa.signed_pct is not none %}
      <details>
        <summary>Are {{ row.name }}'s commits signed?</summary>
        <div class="qa-answer">{{ row.safety_qa.signed_pct }}% of the last 100 commits to {{ row.name }} are verified-signed (GPG, SSH, S/MIME, or GitHub's signing flow). Signed commits help confirm that code was authored by who the commit claims.</div>
      </details>
      {% endif %}

      <p class="qa-disclaimer"><strong>Not a safety endorsement.</strong> HVTracker describes what public signals show, not whether a project is safe for your use case. Run your own security review before adopting in production.</p>
    </section>
    {% endif %}

    {% if comparisons %}
    <section class="compare-strip">
      <h2 class="section-title">Compare {{ row.name }} head-to-head</h2>
      <div class="cmp-row">
        {% for c in comparisons[:3] %}
        <a class="cmp-link" href="{{ c.url }}">
          <span class="cmp-name">{{ row.name }} vs {{ c.name }}</span>
          <span class="cmp-arrow">→</span>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section class="runtime-soon">
      <h2 class="section-title">AI agent surface</h2>
      <div class="rt-card">
        <div class="runtime-kicker">Profile context only</div>
        {% set mcp = row.mcp_server_support or {"status": "none", "confidence": none, "evidence": []} %}
        {% set ext = row.external_service_dependencies or {"providers": [], "requires_api_keys": false, "confidence": none, "evidence": []} %}
        {% set tooling = row.tool_plugin_surface or {"plugin_system": "none", "tool_tags": [], "confidence": none, "evidence": []} %}
        {% set drift = row.package_provenance_drift or {"status": "not_applicable", "confidence": none, "summary": "No package source configured", "evidence": []} %}
        <p class="runtime-intro">HVTrust currently ranks <strong>supply-chain and project-integrity trust only</strong>. This public view shows a compact AI-agent surface snapshot from repo docs and manifests. These fields are descriptive context and do not affect the production HVTrust rank. An experimental local preview remains available in <a href="/score-lab/" style="color:var(--accent);">Score Lab →</a>, and the policy boundary is tracked on the <a href="/roadmap/" style="color:var(--accent);">roadmap →</a></p>

        <div class="runtime-grid">
          <div class="runtime-panel">
            <div class="runtime-panel-head">
              <div>
                <div class="runtime-panel-title">MCP Server Support</div>
                {% if mcp.confidence %}<div class="runtime-confidence">{{ mcp.confidence }} confidence</div>{% endif %}
              </div>
              <span class="runtime-status {% if mcp.status == 'implemented' %}positive{% elif mcp.status == 'declared' %}neutral{% else %}muted{% endif %}">
                {% if mcp.status == "implemented" %}
                Implemented
                {% elif mcp.status == "declared" %}
                Declared
                {% else %}
                None detected
                {% endif %}
              </span>
            </div>
            <div class="runtime-summary {% if mcp.status == 'none' %}muted{% endif %}">
              {% if mcp.status == "implemented" %}
              {{ row.name }} appears to expose MCP server capabilities.
              {% elif mcp.status == "declared" %}
              MCP support appears present, but direct server implementation is less certain.
              {% else %}
              No MCP server signal detected.
              {% endif %}
            </div>
            <div class="runtime-mini">Detailed evidence is not shown in the public view.</div>
          </div>

          <div class="runtime-panel">
            <div class="runtime-panel-head">
              <div>
                <div class="runtime-panel-title">External Service Dependencies</div>
                {% if ext.confidence %}<div class="runtime-confidence">{{ ext.confidence }} confidence</div>{% endif %}
              </div>
              <span class="runtime-status {% if ext.providers %}neutral{% else %}muted{% endif %}">
                {% if ext.providers %}
                {{ ext.providers|length }} detected
                {% else %}
                None detected
                {% endif %}
              </span>
            </div>
            <div class="runtime-summary {% if not ext.providers %}muted{% endif %}">
              {% if ext.providers %}
              Public provider/service dependencies detected.
              {% else %}
              No clear third-party provider dependency detected.
              {% endif %}
            </div>
            {% if ext.providers %}
            <ul class="runtime-provider-list">
              {% for provider in ext.providers %}
              <li class="runtime-provider">{{ provider }}</li>
              {% endfor %}
            </ul>
            {% endif %}
            <div class="runtime-note">
              <strong>Credential signal:</strong>
              {% if ext.requires_api_keys %}
              API keys or service config markers documented.
              {% else %}
              No explicit API-key/config marker detected.
              {% endif %}
            </div>
          </div>

          <div class="runtime-panel">
            <div class="runtime-panel-head">
              <div>
                <div class="runtime-panel-title">Tool / Plugin Surface</div>
                {% if tooling.confidence %}<div class="runtime-confidence">{{ tooling.confidence }} confidence</div>{% endif %}
              </div>
              <span class="runtime-status {% if tooling.plugin_system == 'marketplace' %}positive{% elif tooling.plugin_system != 'none' or tooling.tool_tags %}neutral{% else %}muted{% endif %}">
                {% if tooling.plugin_system == "marketplace" %}
                Marketplace
                {% elif tooling.plugin_system == "extension-based" %}
                Extensions
                {% elif tooling.plugin_system == "declared" %}
                Declared
                {% else %}
                {% if tooling.tool_tags %}
                {{ tooling.tool_tags|length }} tags
                {% else %}
                None detected
                {% endif %}
                {% endif %}
              </span>
            </div>
            <div class="runtime-summary {% if tooling.plugin_system == 'none' and not tooling.tool_tags %}muted{% endif %}">
              {% if tooling.plugin_system != "none" %}
              {{ tooling.plugin_system|replace('-', ' ')|capitalize }} plugin/integration surface detected.
              {% elif tooling.tool_tags %}
              Broad capability areas detected.
              {% else %}
              No clear plugin system or broad tool surface detected.
              {% endif %}
            </div>
            {% if tooling.tool_tags %}
            <ul class="runtime-provider-list">
              {% for tag in tooling.tool_tags %}
              <li class="runtime-provider">{{ tag }}</li>
              {% endfor %}
            </ul>
            {% endif %}
            <div class="runtime-mini">Detailed evidence is not shown in the public view.</div>
          </div>

          <div class="runtime-panel">
            <div class="runtime-panel-head">
              <div>
                <div class="runtime-panel-title">Package Provenance Drift</div>
                {% if drift.confidence %}<div class="runtime-confidence">{{ drift.confidence }} confidence</div>{% endif %}
              </div>
              <span class="runtime-status {% if drift.status == 'match' %}positive{% elif drift.status in ('partial','unknown') %}neutral{% elif drift.status == 'warning' %}muted{% else %}muted{% endif %}">
                {% if drift.status == "match" %}
                Match
                {% elif drift.status == "partial" %}
                Partial
                {% elif drift.status == "warning" %}
                Warning
                {% elif drift.status == "unknown" %}
                Unknown
                {% else %}
                N/A
                {% endif %}
              </span>
            </div>
            <div class="runtime-summary {% if drift.status in ('unknown','not_applicable') %}muted{% endif %}">
              {{ drift.summary }}
            </div>
            <div class="runtime-mini">Detailed evidence is not shown in the public view.</div>
          </div>
        </div>

        <ul class="runtime-roadmap">
          <li class="live">MCP signal live</li>
          <li class="live">External deps live</li>
          <li class="live">Tool / plugin surface live</li>
          <li class="live">Package provenance drift live</li>
        </ul>
      </div>
    </section>

    <section class="maintainer-cta">
      <h2 class="section-title">Maintain {{ row.name }}?</h2>
      <p>HVTrust scores {{ row.name }} from <strong>public signals only</strong> — we never contact maintainers first. If a signal is wrong, stale, or missing (provenance you publish, a Scorecard you run, signed releases), tell us and we'll review it. Corrections are public and tracked on GitHub.</p>
      <div class="maintainer-actions">
        <a class="cta-correction" href="{{ row.correction_url }}" target="_blank" rel="noopener noreferrer">Submit a correction →</a>
        <a class="secondary-link" href="#embed-badge">Add the trust badge</a>
      </div>
    </section>

    {% if row.public_actions %}
    <section class="provenance">
      <h2 class="section-title">Public Actions</h2>
      <div style="display:flex;gap:32px;flex-wrap:wrap;margin-bottom:16px">
        <div>
          <div class="prov-label">Actions (30d)</div>
          <div class="prov-value" style="color:var(--accent)">{{ row.public_actions.actions_30d }}</div>
        </div>
        {% if row.public_actions.actions_30d_merged is not none %}
        <div>
          <div class="prov-label">Merged (30d)</div>
          <div class="prov-value" style="color:var(--accent)">{{ row.public_actions.actions_30d_merged }}</div>
        </div>
        {% if row.public_actions.actions_30d > 0 %}
        <div>
          <div class="prov-label">Merge rate</div>
          <div class="prov-value">{{ ((row.public_actions.actions_30d_merged / row.public_actions.actions_30d) * 100) | round | int }}%</div>
        </div>
        {% endif %}
        {% endif %}
      </div>
      {% if row.public_actions.actions_30d_by_repo %}
      <div class="prov-label" style="margin-bottom:8px">Top repos (sampled)</div>
      <ul style="margin:0;padding:0;list-style:none;font-size:13px">
        {% for entry in row.public_actions.actions_30d_by_repo[:5] %}
        <li style="margin-bottom:4px">
          <a href="https://github.com/{{ entry.repo }}" target="_blank" rel="noopener" style="color:var(--accent)">{{ entry.repo }}</a>
          <span style="color:var(--muted);margin-left:6px">{{ entry.count }}</span>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      <p style="font-size:11px;color:var(--muted);margin-top:16px;line-height:1.5">
        Action counts reflect activity on public repos where this agent left detectable fingerprints.
        Private repo usage is invisible. Counts are approximate (GitHub Search API caps at 1,000 results per query).
        Methodology described in the <a href="/spec/provenance/v0.1">Provenance Profile spec</a>.
      </p>
    </section>
    {% endif %}

    {% if events %}
    <section class="provenance">
      <h2 class="section-title">Reputation Timeline</h2>
      {% if row.event_chart_svg %}
      {{ row.event_chart_svg | safe }}
      {% endif %}
      <div class="timeline-scroll">
        <div class="timeline-event-list">
        {% for e in events|reverse %}
        <div class="timeline-event">
          <span class="timeline-date">{{ e.date }}</span>
          <div class="timeline-body">
            <span class="timeline-label">{{ e.label or e.type|replace('_', ' ') }}</span>
            <div class="timeline-detail">{{ e.detail }}</div>
          </div>
        </div>
        {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    <section class="links">
      <a href="{{ row.url }}" target="_blank" rel="noopener noreferrer">GitHub →</a>
      {% if row.pypi_package %}<a href="https://pypi.org/project/{{ row.pypi_package }}/" target="_blank" rel="noopener noreferrer">PyPI: {{ row.pypi_package }}</a>{% endif %}
      {% if row.npm_package %}<a href="https://www.npmjs.com/package/{{ row.npm_package }}" target="_blank" rel="noopener noreferrer">npm: {{ row.npm_package }}</a>{% endif %}
    </section>

    <section class="provenance" id="embed-badge" style="margin-top:0;">
      <h2 class="section-title">Embed Badge <a href="/badges/" style="font-weight:400;color:var(--accent);font-size:11px;margin-left:8px;">Badge guide for maintainers →</a></h2>
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px;">
        <img src="/badge/{{ row.slug }}.svg" alt="HVTrust {{ row.trust_score }}" height="20">
        <img src="/badge/{{ row.slug }}-grade.svg" alt="Grade {{ row.evidence_grade }}" height="20">
      </div>
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:10px 14px;font-family:monospace;font-size:11px;color:var(--muted);word-break:break-all;line-height:1.6;">
        <span style="color:var(--text);">Markdown:</span><br>
        [![HVTrust](https://hvtracker.net/badge/{{ row.slug }}.svg)](https://hvtracker.net/agents/{{ row.slug }})<br>
        <span style="color:var(--text);margin-top:6px;display:inline-block;">HTML:</span><br>
        &lt;a href="https://hvtracker.net/agents/{{ row.slug }}"&gt;&lt;img src="https://hvtracker.net/badge/{{ row.slug }}.svg" alt="HVTrust"&gt;&lt;/a&gt;
      </div>
    </section>

    {% if row.siblings %}
    <section class="siblings">
      <h2 class="section-title">Other agents in {{ row.category }}</h2>
      <ul>
        {% for s in row.siblings %}
        <li>
          <a href="/agents/{{ s.slug }}">
            <span class="sib-rank">#{{ s.rank }}</span>
            <span class="sib-name">{{ s.name }}</span>
            <span class="sib-score">{{ s.score }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if comparisons %}
    <section class="siblings">
      <h2 class="section-title">{{ row.name }} head-to-head</h2>
      <ul>
        {% for c in comparisons %}
        <li>
          <a href="{{ c.url }}">
            <span class="sib-name">{{ row.name }} vs {{ c.name }}</span>
            <span class="sib-score">compare →</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <section class="terminal-note" style="padding:18px 20px;font-size:11px;color:var(--muted);line-height:1.7;">
      <strong style="color:var(--text);font-size:12px;">Data sources</strong><br>
      GitHub REST API (repo, commits, stars, forks, license){% if row.npm_package %} · npm Registry (downloads, provenance){% endif %}{% if row.pypi_package %} · PyPI / pypistats (downloads, provenance){% endif %}{% if row.crate_package %} · crates.io (downloads){% endif %}{% if row.scorecard_score is not none %} · OSSF Scorecard via deps.dev{% endif %}{% if row.hn_mentions_30d is not none %} · Algolia HN Search API{% endif %}{% if row.public_actions %} · GitHub Search API (fingerprint actions){% endif %}
      <br>Each agent's signals refresh once daily across 6 staggered batches. <a href="/methodology" style="color:var(--accent);">Methodology {{ methodology_version }}</a> · <a href="/data/agents/{{ row.slug }}.json" style="color:var(--accent);">Raw JSON</a>
    </section>

    <footer>
      <a href="/methodology">Methodology</a>
      <span class="footer-sep">&middot;</span>
      <a href="/spec/">Specifications</a>
      <span class="footer-sep">&middot;</span>
      <a href="/data/">Data API</a>
      <span class="footer-sep">&middot;</span>
      <a href="/compare/">Compare</a>
      <span class="footer-sep">&middot;</span>
      <a href="/badges/">Badges</a>
      <span class="footer-sep">&middot;</span>
      <a href="/changelog/">Changelog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/blog/">Blog</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker/issues/new?template=agent-listing.yml" target="_blank" rel="noopener">Submit Agent</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker" target="_blank" rel="noopener">GitHub</a>
    </footer>

  </div>
  <script>
    (function () {
      const WATCHLIST_KEY = "hvtracker_watchlist_v1";
      const btn = document.getElementById("watchToggle");
      const compareLink = document.getElementById("watchlistCompareLink");
      if (!btn || !compareLink) return;

      function loadWatchlist() {
        try {
          const raw = localStorage.getItem(WATCHLIST_KEY);
          const items = raw ? JSON.parse(raw) : [];
          return Array.isArray(items) ? items : [];
        } catch (_) {
          return [];
        }
      }

      function saveWatchlist(items) {
        localStorage.setItem(WATCHLIST_KEY, JSON.stringify(items.slice(0, 12)));
      }

      function render() {
        const items = loadWatchlist();
        const saved = items.some((item) => item.slug === btn.dataset.watchSlug);
        btn.classList.toggle("is-saved", saved);
        btn.textContent = saved ? "Saved to watchlist" : "Save to watchlist";
        compareLink.href = items.length ? "/compare/?watchlist=1" : "/compare/";
        compareLink.textContent = items.length ? `Compare saved agents (${items.length})` : "Compare saved agents";
      }

      btn.addEventListener("click", () => {
        const items = loadWatchlist();
        const slug = btn.dataset.watchSlug;
        const existing = items.find((item) => item.slug === slug);
        const next = existing
          ? items.filter((item) => item.slug !== slug)
          : items.concat([{ slug, name: btn.dataset.watchName, repo: btn.dataset.watchRepo }]).slice(0, 12);
        saveWatchlist(next);
        render();
        if (typeof hvtTrack === "function") {
          hvtTrack(existing ? "watchlist_remove" : "watchlist_add", {
            slug,
            watchlist_size: next.length
          });
        }
      });

      render();
    })();
  </script>
</body>
</html>
