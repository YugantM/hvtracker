{#- One leaderboard row. Rendered twice from this file: inline for the top
    BOARD_SSR_ROWS rows of the homepage, and into /data/board-rest.json for
    the rest, which the homepage script inserts on first search/filter/sort/
    page. Keep it free of page-level state so both copies stay identical. -#}
<tr{% if row.rank <= 3 %} class="top-row"{% endif %}
  data-slug="{{ row.slug }}"
  data-rank="{{ row.rank }}"
  data-display_rank="{{ row.display_rank }}"
  data-is_tied="{% if row.is_tied %}1{% else %}0{% endif %}"
  data-rank_delta="{{ row.rank_delta_sort }}"
  data-rank_delta_display="{{ row.rank_delta_display }}"
  data-rank_delta_class="{{ row.rank_delta_class }}"
  data-rank_v2="{{ row.rank_historical_v1 }}"
  data-rank_v2_delta_display="{{ row.rank_v2_delta_display }}"
  data-rank_v2_delta_class="{{ row.rank_v2_delta_class }}"
  data-trust_score_v2="{{ row.trust_score_historical_v1 }}"
  data-name="{{ row.name }}"
  data-repo="{{ row.repo }}"
  data-stars="{{ row.stars }}"
  data-last_push="{{ row.last_push }}"
  data-weekly_commits="{{ row.weekly_commits }}"
  data-downloads="{{ row.weekly_downloads or 0 }}"
  data-hn_mentions_30d="{{ row.hn_mentions_30d if row.hn_mentions_30d is not none else -1 }}"
  data-actions_30d="{{ row.public_actions.actions_30d if row.public_actions else -1 }}"
  data-scorecard="{{ row.scorecard_score if row.scorecard_score is not none else -1 }}"
  data-has_provenance="{% if row.has_provenance %}1{% else %}0{% endif %}"
  data-signed_commits_ratio="{{ row.signed_commits_ratio if row.signed_commits_ratio is not none else 0 }}"
  data-days_ago="{{ row.days_ago if row.days_ago is not none else 9999 }}"
  data-score="{{ row.score }}"
  data-trust_score="{{ row.trust_score }}"
  data-category="{{ row.category }}"
  data-category_rank="{{ row.category_rank }}"
  data-evidence_grade="{{ row.evidence_grade }}"
  data-license_type="{{ row.license_type or 'unlicensed' }}"
  data-newly-added="{% if row.repo in newly_repos %}1{% else %}0{% endif %}"
>
  <td class="rank r"{% if row.is_tied %} title="Tied at {{ row.trust_score }} — ties ranked by evidence confidence, then OSSF Scorecard, then popularity"{% endif %}>
    <span class="rank-num">{% if row.is_tied %}={{ row.display_rank }}{% else %}{{ row.rank }}{% endif %}</span>
  </td>
  <td class="delta {{ row.rank_delta_class }}">{{ row.rank_delta_display }}</td>
  <td class="agent-cell">
    <div class="agent-head">
      <a class="agent-name" href="/agents/{{ row.slug }}/">{{ row.name }}</a>
      <button class="watch-toggle" type="button" data-watch-slug="{{ row.slug }}" data-watch-name="{{ row.name }}" data-watch-repo="{{ row.repo }}" title="Track {{ row.name }}" aria-label="Track {{ row.name }}"></button>
      <button class="compare-toggle" type="button" data-cmp-slug="{{ row.slug }}" data-cmp-name="{{ row.name }}" data-cmp-repo="{{ row.repo }}" title="Add {{ row.name }} to compare" aria-label="Add {{ row.name }} to compare"></button>
    </div>
    <a class="agent-repo" href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.display_repo or row.repo }}</a>
    {% if row.description %}<span class="agent-desc" title="{{ row.description }}">{{ row.description }}</span>{% endif %}
    <div class="agent-tags">
      <span class="state-chip state-{{ row.display_listing_status }}">{{ row.display_status_label }}</span>
      {% if row.language %}<span class="lang">{{ row.language }}</span>{% endif %}
      {% if row.category %}<span class="cat-badge">{{ row.category }}</span>{% endif %}
      {% if row.license_type and row.license_type != 'open' %}<span class="license-chip license-{{ row.license_type }}">{{ row.license_type | capitalize }}</span>{% endif %}
    </div>
    {% if row.recent_change_summary %}
    <div class="agent-change">
      <span class="agent-change-chip agent-change-{{ row.recent_change_summary.tone }}">{{ row.recent_change_summary.short_label }}{% if row.recent_change_summary.count > 1 %} +{{ row.recent_change_summary.count - 1 }}{% endif %}</span>
      <span class="agent-change-text">{{ row.recent_change_summary.detail }}</span>
    </div>
    {% endif %}
  </td>
  <td class="c">
    <span class="evidence-badge grade-{{ row.evidence_grade }}" title="Evidence grade {{ row.evidence_grade }}">{{ row.evidence_grade }}</span>
  </td>
  <td class="c num">{{ row.stars_fmt }}</td>
  <td>
    <div class="push-date {{ row.freshness_class }}">
      <span class="push-dot"></span>
      <span class="push-text">{{ row.last_push }}</span>
    </div>
  </td>
  <td class="c num">{% if row.weekly_commits is not none %}{{ row.weekly_commits }}{% else %}&mdash;{% endif %}{% if row.commits_low_confidence %}<span title="Recent push detected; GitHub's commit stats cache may be stale, so this 4-week count could be temporarily under-reported." style="color:var(--aging);font-size:11px;margin-left:2px;cursor:help;">?</span>{% endif %}</td>
  <td class="c">
    <span class="trust-pill {% if row.trust_score >= 55 %}trust-high{% elif row.trust_score >= 30 %}trust-mid{% else %}trust-low{% endif %}" title="Safety {{ row.trust_breakdown.safety }} · Identity {{ row.trust_breakdown.identity }} · Transparency {{ row.trust_breakdown.transparency }} · Maintenance {{ row.trust_breakdown.maintenance }} · Adoption {{ row.trust_breakdown.adoption }}{% if row.trust_confidence %} · {{ (row.trust_confidence * 100) | round }}% confidence{% endif %}">{{ row.trust_score }}</span>
    <span class="v2-score-inline">was {{ row.trust_score_historical_v1 }}</span>
    {% if row.trust_trend_7d is not none and row.trust_trend_7d != 0 %}
    <span class="trust-trend {% if row.trust_trend_7d > 0 %}trust-trend-up{% else %}trust-trend-down{% endif %}">{{ "▲" if row.trust_trend_7d > 0 else "▼" }}{{ row.trust_trend_7d|abs }}</span>
    {% elif row.trust_trend_7d == 0 %}
    <span class="trust-trend trust-trend-flat">—</span>
    {% endif %}
  </td>
</tr>
