<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="s2YUWbGP7cJsI6HUCKRX9YCtbVJVyA1Q1_jsNWj1RHc">
  <title>Weekly Changes — AI Agent Trust Moves | HVTracker</title>
  <meta name="description" content="Weekly diff of the HVTracker AI agent registry: new listings, trust-score moves, provenance and MCP changes.">
  <link rel="canonical" href="https://hvtracker.net/changes/">
  <link rel="alternate" type="application/rss+xml" title="HVTracker Weekly Changes" href="https://hvtracker.net/changes/feed.xml">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Weekly Changes | HVTracker">
  <meta property="og:description" content="Weekly diff of trust scores, new listings, provenance, and MCP changes across open-source AI agents.">
  <meta property="og:url" content="https://hvtracker.net/changes/">
  <meta property="og:image" content="https://hvtracker.net/og-v2.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Weekly Changes | HVTracker">
  <meta name="twitter:description" content="Weekly diff of trust scores, new listings, provenance, and MCP changes across open-source AI agents.">
  <meta name="twitter:image" content="https://hvtracker.net/og-v2.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap">
  <link rel="stylesheet" href="/static/site.css?v={{ css_hash }}">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    /* Theme vars come from static/site.css :root; only --muted diverges here
       (lighter than the site-wide #57524c). */
    :root{--muted:#6f665d}
    body{min-height:100vh;background:var(--paper);color:var(--ink);font:16px/1.65 var(--font-sans)}
    a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}
    .page{background:var(--paper);max-width:1180px;margin:0 auto;padding:24px 24px 48px}
    .logo{font-family:var(--font-mono);font-weight:700;font-size:20px}.logo span{color:var(--lobster)}
    .hero{padding:26px 0 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);gap:18px;align-items:end}
    h1{font-size:34px;font-weight:700;letter-spacing:-.03em;margin-bottom:8px}.hero p{color:var(--muted);font-size:16px;max-width:720px}
    .meta{font:12px var(--font-mono);color:var(--muted);margin-top:14px}
    .hero-panel{background:linear-gradient(180deg,var(--paper-2),rgba(236,228,214,.55));border:1px solid var(--line);border-top:2px solid var(--line-strong);padding:16px 18px}
    .hero-panel-title{font:12px var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
    .hero-panel-copy{font-size:15px;line-height:1.6;color:var(--ink)}
    .hero-panel-copy strong{color:var(--green)}
    .summary-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin:22px 0 28px}
    .summary-card{background:rgba(255,255,255,.28);border:1px solid var(--line);border-top:2px solid var(--line-strong);padding:14px 14px 12px;min-height:92px}
    .summary-label{font:11px var(--font-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
    .summary-value{font-size:28px;line-height:1;font-weight:700;letter-spacing:-.04em;margin:10px 0 6px}
    .summary-note{font:12px var(--font-mono);color:var(--muted)}
    .summary-card.up .summary-value,.summary-card.prov .summary-value,.summary-card.mcp .summary-value{color:var(--green)}
    .summary-card.down .summary-value{color:var(--lobster)}
    .changes-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    .changes-card{background:rgba(255,255,255,.24);border:1px solid var(--line);border-top:2px solid var(--line-strong);display:flex;flex-direction:column;min-height:100%}
    .changes-card.span-2{grid-column:span 2}
    .card-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding:16px 18px 14px;border-bottom:1px solid var(--line)}
    .card-title-wrap{display:grid;gap:4px}
    .card-kicker{font:11px var(--font-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
    .card-title{font-size:18px;font-weight:700;line-height:1.1}
    .card-subtitle{color:var(--muted);font-size:13px}
    .card-count{font:600 12px var(--font-mono);padding:7px 10px;border:1px solid var(--line);background:var(--paper-2);color:var(--muted);white-space:nowrap}
    .card-body{padding:6px 18px 10px}
    .changes-card.span-2 .card-body{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:18px}
    .change-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:start;padding:13px 0;border-bottom:1px solid rgba(185,170,150,.65)}
    .change-item:last-child{border-bottom:none}
    .name{font-weight:600;font-size:15px;line-height:1.3}
    .sub{display:block;color:var(--muted);font:12px var(--font-mono);margin-top:4px}
    .delta{font:700 12px var(--font-mono);text-align:right;padding-top:2px}
    .delta-up{color:var(--green)}.delta-down{color:var(--lobster)}
    .empty{color:var(--muted);font-style:italic;padding:14px 0 10px}
    footer{margin-top:28px;padding-top:14px;border-top:1px solid var(--line);font:12px var(--font-mono);color:var(--muted);text-align:center}
    footer a{color:var(--blue-strong)}
    @media(max-width:960px){
      .hero{grid-template-columns:1fr}
      .summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .changes-grid{grid-template-columns:1fr}
      .changes-card.span-2{grid-column:auto}
      .changes-card.span-2 .card-body{display:block}
    }
    @media(max-width:640px){
      .page{padding:18px 16px 34px}
      h1{font-size:24px}
      .summary-grid{grid-template-columns:1fr}
      .card-head{align-items:start;flex-direction:column}
      .change-item{grid-template-columns:minmax(0,1fr)}
      .delta{text-align:left}
    }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "Changes" }
    ]
  }
  </script>
  <script>
    (function(){try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
</head>
<body data-page-type="changes">
  {% include "_site_header.html.j2" %}
  <main class="page" id="main">

    <section class="hero">
      <div>
        <h1>Weekly Changes</h1>
        <p>What moved in the HVTracker registry over the past week: new listings, trust-score shifts, provenance and MCP status changes.</p>
        <div class="meta">{{ latest_date }} vs {{ baseline_date }} &middot; Updated {{ updated }}</div>
      </div>
      <aside class="hero-panel">
        <div class="hero-panel-title">Change Window</div>
        <div class="hero-panel-copy">
          This view highlights <strong>{{ newly_listed|length + trust_up|length + trust_down|length + provenance_gained|length + mcp_gained|length }}</strong>
          notable registry updates across launches, trust movement, and capability signals.
        </div>
      </aside>
    </section>

    <section class="summary-grid" aria-label="Weekly change summary">
      <div class="summary-card">
        <div class="summary-label">New Listings</div>
        <div class="summary-value">{{ newly_listed|length }}</div>
        <div class="summary-note">Fresh additions to the registry</div>
      </div>
      <div class="summary-card up">
        <div class="summary-label">Trust Up</div>
        <div class="summary-value">{{ trust_up|length }}</div>
        <div class="summary-note">Score increases of 3+ points</div>
      </div>
      <div class="summary-card down">
        <div class="summary-label">Trust Down</div>
        <div class="summary-value">{{ trust_down|length }}</div>
        <div class="summary-note">Score drops of 3+ points</div>
      </div>
      <div class="summary-card prov">
        <div class="summary-label">Provenance Gained</div>
        <div class="summary-value">{{ provenance_gained|length }}</div>
        <div class="summary-note">Projects that added provenance</div>
      </div>
      <div class="summary-card mcp">
        <div class="summary-label">MCP Gained</div>
        <div class="summary-value">{{ mcp_gained|length }}</div>
        <div class="summary-note">Projects that added MCP support</div>
      </div>
    </section>

    <section class="changes-grid">
      <article class="changes-card span-2">
        <div class="card-head">
          <div class="card-title-wrap">
            <div class="card-kicker">Registry</div>
            <h2 class="card-title">Newly Listed Projects</h2>
            <p class="card-subtitle">Fresh entries added during this weekly comparison window.</p>
          </div>
          <div class="card-count">{{ newly_listed|length }} projects</div>
        </div>
        <div class="card-body">
          {% if newly_listed %}
          {% for item in newly_listed %}
          <div class="change-item">
            <span>
              <a class="name" href="/agents/{{ item.slug }}/">{{ item.name }}</a>
              <span class="sub">{{ item.category }} &middot; HVTrust {{ item.trust_score }}</span>
            </span>
            <span class="delta">NEW</span>
          </div>
          {% endfor %}
          {% else %}
          <div class="empty">No new listings this period.</div>
          {% endif %}
        </div>
      </article>

      <article class="changes-card">
        <div class="card-head">
          <div class="card-title-wrap">
            <div class="card-kicker">Trust Movement</div>
            <h2 class="card-title">Trust Score Up</h2>
            <p class="card-subtitle">Projects with material positive movement.</p>
          </div>
          <div class="card-count">{{ trust_up|length }} moves</div>
        </div>
        <div class="card-body">
          {% if trust_up %}
          {% for item in trust_up %}
          <div class="change-item">
            <span>
              <a class="name" href="/agents/{{ item.slug }}/">{{ item.name }}</a>
              <span class="sub">{{ item.old_score }} &rarr; {{ item.new_score }}</span>
            </span>
            <span class="delta delta-up">+{{ item.delta }}</span>
          </div>
          {% endfor %}
          {% else %}
          <div class="empty">No trust score increases &ge;3 this period.</div>
          {% endif %}
        </div>
      </article>

      <article class="changes-card">
        <div class="card-head">
          <div class="card-title-wrap">
            <div class="card-kicker">Trust Movement</div>
            <h2 class="card-title">Trust Score Down</h2>
            <p class="card-subtitle">Projects with material negative movement.</p>
          </div>
          <div class="card-count">{{ trust_down|length }} moves</div>
        </div>
        <div class="card-body">
          {% if trust_down %}
          {% for item in trust_down %}
          <div class="change-item">
            <span>
              <a class="name" href="/agents/{{ item.slug }}/">{{ item.name }}</a>
              <span class="sub">{{ item.old_score }} &rarr; {{ item.new_score }}</span>
            </span>
            <span class="delta delta-down">{{ item.delta }}</span>
          </div>
          {% endfor %}
          {% else %}
          <div class="empty">No trust score decreases &ge;3 this period.</div>
          {% endif %}
        </div>
      </article>

      <article class="changes-card">
        <div class="card-head">
          <div class="card-title-wrap">
            <div class="card-kicker">Identity</div>
            <h2 class="card-title">Provenance Gained</h2>
            <p class="card-subtitle">Projects that added stronger identity signals.</p>
          </div>
          <div class="card-count">{{ provenance_gained|length }} updates</div>
        </div>
        <div class="card-body">
          {% if provenance_gained %}
          {% for item in provenance_gained %}
          <div class="change-item">
            <span>
              <a class="name" href="/agents/{{ item.slug }}/">{{ item.name }}</a>
              <span class="sub">{{ item.category }}</span>
            </span>
            <span class="delta delta-up">+prov</span>
          </div>
          {% endfor %}
          {% else %}
          <div class="empty">No provenance changes this period.</div>
          {% endif %}
        </div>
      </article>

      <article class="changes-card">
        <div class="card-head">
          <div class="card-title-wrap">
            <div class="card-kicker">Capability</div>
            <h2 class="card-title">MCP Support Gained</h2>
            <p class="card-subtitle">Projects that added model-context-protocol support.</p>
          </div>
          <div class="card-count">{{ mcp_gained|length }} updates</div>
        </div>
        <div class="card-body">
          {% if mcp_gained %}
          {% for item in mcp_gained %}
          <div class="change-item">
            <span>
              <a class="name" href="/agents/{{ item.slug }}/">{{ item.name }}</a>
              <span class="sub">{{ item.category }} &middot; {{ item.mcp_status }}</span>
            </span>
            <span class="delta delta-up">+mcp</span>
          </div>
          {% endfor %}
          {% else %}
          <div class="empty">No MCP status changes this period.</div>
          {% endif %}
        </div>
      </article>
    </section>

    <footer>
      <a href="/changes/feed.xml">RSS Feed</a>
      <span class="footer-sep">&middot;</span>
      <a href="/methodology/">Methodology</a>
      <span class="footer-sep">&middot;</span>
      <a href="/data/">Data API</a>
      <span class="footer-sep">&middot;</span>
      <a href="/compare/">Compare</a>
      <span class="footer-sep">&middot;</span>
      <a href="/badges/">Badges</a>
      <span class="footer-sep">&middot;</span>
      <a href="/blog/">Blog</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker" target="_blank" rel="noopener">GitHub</a>
    </footer>
  </main>
</body>
</html>
