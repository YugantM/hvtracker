<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% include "_head_icons.html.j2" %}
  <meta name="google-site-verification" content="s2YUWbGP7cJsI6HUCKRX9YCtbVJVyA1Q1_jsNWj1RHc">
  <title>{{ page.title }} | HVTracker</title>
  <meta name="description" content="{{ page.description }}">
  <link rel="canonical" href="https://hvtracker.net/ecosystem/{% if page.slug %}{{ page.slug }}/{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page.title }} | HVTracker">
  <meta property="og:description" content="{{ page.description }}">
  <meta property="og:url" content="https://hvtracker.net/ecosystem/{% if page.slug %}{{ page.slug }}/{% endif %}">
  <meta property="og:image" content="https://hvtracker.net/og-v2.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page.title }} | HVTracker">
  <meta name="twitter:description" content="{{ page.description }}">
  <meta name="twitter:image" content="https://hvtracker.net/og-v2.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap">
  <link rel="stylesheet" href="/static/site.css?v={{ css_hash }}">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    /* Theme vars come from static/site.css :root; only --muted diverges here
       (lighter than the site-wide #57524c). */
    :root{--muted:#6f665d}
    body{min-height:100vh;background:var(--paper); color:var(--ink);font:16px/1.7 var(--font-sans)}
    a{color:inherit;text-decoration:none}
    a:hover{text-decoration:underline}
    .page{background:var(--paper);max-width:1080px;margin:0 auto;padding:28px 24px 52px}
    .logo{font-family:var(--font-mono);font-weight:700;font-size:20px;letter-spacing:0}
    .logo span{color:var(--lobster)}
    .hero{padding:28px 0 18px;border-bottom:1px solid var(--line)}
    h1{font-size:34px;line-height:1.12;letter-spacing:0;margin-bottom:10px}
    .hero p{color:var(--muted);max-width:760px}
    .metric-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:20px 0}
    .metric{padding:12px 0;border-top:2px solid var(--ink)}
    .metric strong{display:block;font:700 24px var(--font-mono);color:var(--ink)}
    .metric span{color:var(--muted);font-size:12px}
    .slice-nav{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0 4px}
    .slice-nav a{font:12px var(--font-mono);color:var(--muted);padding:6px 10px;border:1px solid transparent}
    .slice-nav a:hover{color:var(--ink);border-color:var(--line);background:var(--paper-2);text-decoration:none}
    .slice-nav a.active{color:var(--ink);border-color:var(--line);background:var(--paper-2)}
    table{width:100%;border-collapse:collapse;margin-top:24px;font-size:15px;border-top:2px solid var(--ink)}
    th,td{padding:12px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
    th{font:12px var(--font-mono);color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
    th.num,td.num{text-align:right;font-family:var(--font-mono)}
    .agent{font-weight:700}
    .repo{display:block;color:var(--muted);font:12px var(--font-mono);margin-top:3px}
    .grade{display:inline-flex;min-width:24px;justify-content:center;padding:3px 8px;font:700 12px var(--font-mono);border-radius:3px}
    footer{margin-top:36px;padding-top:18px;border-top:1px solid var(--line);font:12px var(--font-mono);color:var(--muted);text-align:center}
    footer a{color:var(--lobster)}
    @media(max-width:760px){.metric-row{grid-template-columns:1fr}h1{font-size:26px}table{font-size:13px}th:nth-child(4),td:nth-child(4){display:none}}
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "HVTracker", "item": "https://hvtracker.net/" },
      { "@type": "ListItem", "position": 2, "name": "Ecosystem", "item": "https://hvtracker.net/ecosystem/" },
      { "@type": "ListItem", "position": 3, "name": "{{ page.title }}" }
    ]
  }
  </script>
  {% if not is_index %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "{{ page.title }}",
    "numberOfItems": {{ page.agents|length }},
    "itemListElement": [
      {% for agent in page.agents[:25] %}
      { "@type": "ListItem", "position": {{ loop.index }}, "url": "https://hvtracker.net/agents/{{ agent.slug }}/", "name": "{{ agent.name }}" }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Which open-source AI projects use {{ page.provider }}?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ page.faq_answer }}"
        }
      }
    ]
  }
  </script>
  {% endif %}
  <!-- opt out: localStorage.setItem('hvt_notrack','1') -->
  <script>
    (function(){var host=window.location.hostname||"";if(/^(localhost|127(?:\.\d{1,3}){3}|0(?:\.\d{1,3}){3}|::1)$/i.test(host)){window["ga-disable-G-TZ8921LR0K"]=true;return}try{if(localStorage.getItem("hvt_notrack")==="1"){window["ga-disable-G-TZ8921LR0K"]=true;return}}catch(_){}
    var ua=navigator.userAgent||"";if(/HeadlessChrome|Puppeteer|Playwright|Claude\/[\d.]+.*Electron\/|bot|crawl|spider|curl|wget|python-requests/i.test(ua)){window["ga-disable-G-TZ8921LR0K"]=true}})();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZ8921LR0K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TZ8921LR0K');
  </script>
  <script defer src="/analytics.js"></script>
</head>
<body data-page-type="{% if is_index %}ecosystem_index{% else %}ecosystem{% endif %}">
  {% include "_site_header.html.j2" %}
  <main class="page" id="main">

    <section class="hero">
      <h1>{{ page.title }}</h1>
      <p>{{ page.description }}</p>
      <div class="slice-nav" aria-label="Ecosystem providers">
        <a href="/ecosystem/" class="{% if is_index %}active{% endif %}">All providers</a>
        {% for p in pages %}
        <a href="/ecosystem/{{ p.slug }}/" class="{% if p.slug == page.slug %}active{% endif %}">{{ p.provider }} ({{ p.agents|length }})</a>
        {% endfor %}
      </div>
    </section>

    <section class="metric-row" aria-label="Provider summary">
      <div class="metric"><strong>{{ page.agents|length }}</strong><span>Projects</span></div>
      <div class="metric"><strong>{{ page.avg_trust }}</strong><span>Average HVTrust</span></div>
      <div class="metric"><strong>{{ page.fresh_count }}</strong><span>Updated in last 14 days</span></div>
    </section>

    <table>
      <thead>
        <tr><th scope="col">Agent</th><th scope="col">Category</th><th scope="col">Grade</th><th scope="col" class="num">Rank</th><th scope="col" class="num">HVTrust</th><th scope="col" class="num">Fresh</th></tr>
      </thead>
      <tbody>
        {% for agent in page.agents %}
        <tr>
          <td><a class="agent" href="/agents/{{ agent.slug }}/">{{ agent.name }}</a><span class="repo">{{ agent.display_repo or agent.repo }}</span></td>
          <td>{% if agent.category_slug %}<a href="/categories/{{ agent.category_slug }}/">{{ agent.category }}</a>{% else %}{{ agent.category }}{% endif %}</td>
          <td><span class="grade grade-{{ agent.evidence_grade }}">{{ agent.evidence_grade }}</span></td>
          <td class="num">#{{ agent.rank }}</td>
          <td class="num">{{ agent.trust_score }}</td>
          <td class="num">{% if agent.days_ago == 0 %}today{% elif agent.days_ago == 1 %}1d{% else %}{{ agent.days_ago }}d{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p style="font-family:var(--font-mono);font-size:11px;color:var(--muted);margin-top:6px;">Grade = trust band: A ≥ 80, B ≥ 65, C ≥ 50, D &lt; 50 — <a href="/methodology/" style="color:var(--accent);">methodology</a></p>

    <footer>
      <a href="/methodology/">Methodology</a>
      <span class="footer-sep">&middot;</span>
      <a href="/spec/">Specifications</a>
      <span class="footer-sep">&middot;</span>
      <a href="/data/">Data API</a>
      <span class="footer-sep">&middot;</span>
      <a href="/compare/">Compare</a>
      <span class="footer-sep">&middot;</span>
      <a href="/badges/">Badges</a>
      <span class="footer-sep">&middot;</span>
      <a href="/changelog/">Changelog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/blog/">Blog</a>
      <span class="footer-sep">&middot;</span>
      <a href="/submit/">Submit Agent</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://github.com/YugantM/hvtracker" target="_blank" rel="noopener">GitHub</a>
    </footer>
  </main>
</body>
</html>
