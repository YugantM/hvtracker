# HVTracker local config — copy to .env (which is gitignored) and fill in.
# Never commit real secrets. In production these are set as Railway env vars.

# GitHub API token for signal/scorecard fetches (read-only is fine)
GITHUB_TOKEN=

# Accounts / auth ----------------------------------------------------------
# Random string used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HVT_SESSION_SECRET=

# Enable the local "Dev login" stub on /login. NEVER set in production.
HVT_DEV_AUTH=1

# GitHub OAuth App — https://github.com/settings/developers (New OAuth App)
#   Homepage URL:              http://localhost:8000
#   Authorization callback URL: http://localhost:8000/auth/github/callback
# (Use the port you actually run on; ./dev.sh uses 8000.)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth client — https://console.cloud.google.com (OAuth 2.0 Client ID)
#   Authorized redirect URI:   http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
