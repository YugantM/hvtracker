# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local Claude Code harness config
/.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local marketing artifacts
hvtracker_linkedin.pptx
hvtracker_linkedin_carousel.pdf
linkedin_carousel.js

# Generated site + state — produced at runtime into the Railway volume.
/index.html
/methodology.html
/sitemap.xml
/feed.json
/llms.txt
/data.json
# Keep render_state.json (seed for render-only tests/CI) but ignore other data/* artifacts
/data/*
!/data/render_state.json
# All of output/ is generated at runtime into the Railway volume, never
# tracked. The rank-delta seed baseline (+ test fixture) lives in /seed/history,
# which is tracked so `railway up` uploads it into the image build context.
/output/
/agents/
/badge/
/badges/
/categories/
/compare/*
!/compare/index.html
/blog/
/spec/
/roadmap/
/ecosystem/
/capabilities/
/trends/
/org/
/use-cases/
/changes/
/movers/
/score-lab/
/sponsor/
/alerts/
/methodology/
# Runtime state files written into the volume.
/.render_fingerprint
/.agents_hash
/.refresh_status.json

# Google Analytics credentials & tokens
client_secret*.json
ga_credentials.json
ga_token.json
ga_data.json

# SSH keypair for `railway ssh` (see CLAUDE.md). Never commit, and never let it
# into the `railway up` upload context — Dockerfile COPYs by filename so it
# would not reach the image, but it would still transit to Railway's builder.
/railway
/railway.pub
